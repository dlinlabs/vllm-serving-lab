350: def test_comparison_table_alias_refusals_and_no_winner():
351:     f16, f32 = _fixed('fixed16', ['good', 'rej']), _fixed('fixed32', ['good', 'good'])
352:     selection = nm.select_train_fixed({'fixed16': f16, 'fixed32': f32})
353:     table = nm.comparison_table({'fixed16': {'status': 'MEASURED', 'metrics': f16},
354:                                  'fixed32': {'status': 'MEASURED', 'metrics': f32},
355:                                  'mpc': {'status': 'REFUSED', 'reason': 'model not qualified'}},
356:                                 purpose='train', train_selection=selection)
357:     assert [r['arm'] for r in table['rows']] == list(nm.ARMS)
358:     by_arm = {r['arm']: r for r in table['rows']}
359:     assert by_arm['train_selected_fixed']['alias_of'] == 'fixed32'
360:     assert by_arm['train_selected_fixed']['status'] == 'ALIAS'
361:     assert by_arm['mpc']['status'] == 'REFUSED' and by_arm['strong_one_move']['status'] == 'NOT_RUN'
362:     assert by_arm['fixed32']['summary']['slo_attainment_fraction'] == 1.0
363:     assert table['fifo_label'] == 'PENDING_VERIFIED_BACKEND_FCFS_CONFIG'
364:     assert not [key for key in keys_recursive(table) if 'winner' in key or 'best_arm' in key]
365:     other = _fixed('fixed32', ['good', 'good'], identity='f' * 64)
366:     with pytest.raises(nm.MetricsInputError, match='incomparable'):
367:         nm.comparison_table({'fixed16': {'status': 'MEASURED', 'metrics': f16},
368:                              'fixed32': {'status': 'MEASURED', 'metrics': other}}, purpose='train')
369:     full_wall = _fixed('fixed32', ['good', 'good'], scope='full_wall')
370:     with pytest.raises(nm.MetricsInputError, match='envelope scope: incomparable'):
371:         nm.comparison_table({'fixed16': {'status': 'MEASURED', 'metrics': f16},
372:                              'fixed32': {'status': 'MEASURED', 'metrics': full_wall}}, purpose='train')
373:     with pytest.raises(nm.MetricsInputError, match='this arm/split'):
374:         nm.comparison_table({'fixed16': {'status': 'MEASURED', 'metrics': f16}}, purpose='eval')
