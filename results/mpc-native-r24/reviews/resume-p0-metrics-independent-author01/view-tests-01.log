311: def _fixed(arm, outcomes, identity='e' * 64, purpose='train', missing=None, scope='offered_cohort_observed'):
312:     rows = []
313:     for index, kind in enumerate(outcomes):
314:         sched = 10.0 + index * 0.1
315:         if kind == 'good':
316:             rows.append(row(f'{arm}{index}', 'complete', sched, sched, sched + 0.1, sched + 0.46, ct=10,
317:                             slo_fields=None if missing else slo()))
318:         elif kind == 'slow':
319:             rows.append(row(f'{arm}{index}', 'complete', sched, sched, sched + 0.9, sched + 1.3, ct=10,
320:                             slo_fields=None if missing else slo()))
321:         else:
322:             rows.append(row(f'{arm}{index}', 'rejected', sched, sched, None, sched + 0.01,
323:                             slo_fields=None if missing else slo(status='rejected', finish=None, done=False)))
324:     return nm.compute(run(rows, arm=arm, purpose=purpose, missing=missing, control=static(nm.FIXED_BUDGETS[arm]),
325:                           control_missing=None, identity=identity, scope=scope))
326: 
