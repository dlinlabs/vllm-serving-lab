198: def write_raw(directory, mutate=None):
199:     model = '/workspace/pr32-r23/models/Qwen3-4B-Instruct-2507'
200:     trace = {'schema_version': 1, 'max_model_len': 8192, 'model': model,
201:              'duration_seconds': 5.0, 'output_cap': 128,
202:              'requests': [{'trace_id': f'p0w1-train-000{i}', 'arrival_seconds': arrival, 'input_tokens': tokens,
203:                            'max_tokens': 128, 'prompt': 'literal'}
204:                           for i, (arrival, tokens) in enumerate([(0.1, 300), (0.2, 1100), (0.3, 3100), (0.4, 600),
205:                                                                  (4.9, 700)])],
206:              'provenance': {'kind': 'SYNTHETIC_OFFERED_WORKLOAD_TAPE', 'offered_tape_schema': nm.OFFERED_TAPE_SCHEMA,
207:                             'offered_tape_sha256': 'b' * 64, 'purpose': 'train', 'source_id': 'literal:train',
208:                             'protocol_id': 'literal', 'requested_prompt_tokens': [256, 1024, 3072, 256, 1024]}}
209:     start = 1000.0
210: 
211:     def launched(i, **fields):
212:         request = trace['requests'][i]
213:         base = {'scheduled_at': start + request['arrival_seconds'], 'workload': 'trace', 'request_id': f'gw-{i}',
214:                 'client_request_id': f'c{i}', 'stream_complete': False, 'started_at': None, 'first_content_at': None,
215:                 'finished_at': None, 'status': 200, 'ttft': None, 'end_to_end': None, 'input_tokens': None,
216:                 'output_tokens': None, 'total_tokens': None, 'max_output_tokens': 128, 'error_type': None,
217:                 'error_message': None, 'error_phase': None, 'success': False, 'rejected': False,
218:                 'trace_id': request['trace_id'], 'expected_input_tokens': request['input_tokens']}
219:         base.update(fields)
220:         return base
221: 
222:     def placeholder(i, message):
223:         request = trace['requests'][i]
224:         return {'trace_id': request['trace_id'], 'client_request_id': f'c{i}', 'request_id': None,
225:                 'scheduled_at': start + request['arrival_seconds'], 'started_at': None, 'first_content_at': None,
226:                 'finished_at': None, 'status': None, 'ttft': None, 'end_to_end': None, 'stream_complete': False,
227:                 'input_tokens': None, 'output_tokens': None, 'max_output_tokens': 128,
228:                 'expected_input_tokens': request['input_tokens'], 'success': False, 'rejected': False,
229:                 'error_type': 'NotLaunched', 'error_message': message, 'error_phase': 'scheduler'}
230: 
231:     client = {'requests': [
232:         launched(0, stream_complete=True, started_at=1000.1005, first_content_at=1000.3, finished_at=1001.0,
233:                  ttft=1000.3 - 1000.1005, input_tokens=300, output_tokens=50, total_tokens=350, success=True),
234:         launched(1, status=503, rejected=True, started_at=1000.2, finished_at=1000.21),
235:         launched(2, started_at=1000.3, finished_at=1006.0, error_type='CancelledError',
236:                  error_message='replay drain timeout or collection interrupted', error_phase='response_body'),
237:         placeholder(3, 'collection interrupted'),
238:         placeholder(4, 'KeyError: literal implementation failure')]}
239:     manifest = {'schema_version': 1, 'status': 'collected', 'git_commit': 'c' * 40, 'git_dirty': False,
240:                 'config': {'budget': 16.0, 'budget_schedule': None, 'cache_policy': 'disabled', 'ttft_slo': 0.5,
241:                            'e2e_slo': None, 'trace': 'literal.json'},
242:                 'measurement_start': start, 'measurement_end': start + 5.0,
243:                 'initial_metrics': {'tokenizer_available': True},
244:                 'gateway_launch': {'settings': {'ADMISSION_MODE': 'cost_aware', 'MAX_ADMITTED_COST': '16.0',
245:                                                 'MODEL_NAME': model}}}
246:     changes = [{'sent': 999.5, 'acknowledged': 999.6, 'target': start}]
247:     files = {'trace.json': trace, 'client.json': client, 'manifest.json': manifest, 'budget_changes.json': changes}
248:     if mutate is not None:
249:         mutate(files)
250:     texts = {name: value if isinstance(value, str) else json.dumps(value) for name, value in files.items()}
251:     if 'trace_sha256' not in manifest:
252:         manifest['trace_sha256'] = hashlib.sha256(texts['trace.json'].encode()).hexdigest()
253:         texts['manifest.json'] = json.dumps(manifest) if not isinstance(files['manifest.json'], str) \
254:             else texts['manifest.json']
255:     directory.mkdir()
