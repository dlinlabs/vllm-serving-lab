22: def run(rows, arm='strong_one_move', purpose='train', missing=('finish_reason: literal test',), control=None,
23:         control_missing='no controller journal in literal test', start=10.0, duration=5.0, envelope=(10.0, 20.0),
24:         identity='a' * 64, scope='offered_cohort_observed'):
25:     return {'arm': arm, 'purpose': purpose, 'clock_domain': 'literal', 'offered_start': start,
26:             'offered_duration_s': duration, 'envelope_start': envelope[0], 'envelope_end': envelope[1],
27:             'envelope_scope': scope, 'rows': rows, 'slo_missing': None if missing is None else list(missing),
28:             'control': control, 'control_missing': control_missing, 'provenance': {'offered_trace_sha256': identity}}
