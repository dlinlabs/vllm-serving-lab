35: def keys_recursive(value):
36:     if isinstance(value, dict):
37:         for key, item in value.items():
38:             yield key
39:             yield from keys_recursive(item)
40:     elif isinstance(value, list):
41:         for item in value:
42:             yield from keys_recursive(item)
