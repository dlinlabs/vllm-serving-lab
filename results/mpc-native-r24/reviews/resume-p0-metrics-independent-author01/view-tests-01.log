333:     tie1 = nm.select_train_fixed({'fixed16': _fixed('fixed16', ['good', 'slow', 'rej']),
334:                                   'fixed32': _fixed('fixed32', ['good', 'rej', 'rej'])})
335:     assert (tie1['selected_arm'], tie1['decided_by']) == ('fixed16', 'tie_1_fewer_not_delivered')
336:     tie2 = nm.select_train_fixed({'fixed16': _fixed('fixed16', ['good', 'rej']),
337:                                   'fixed32': _fixed('fixed32', ['rej', 'good'])})
338:     assert (tie2['selected_arm'], tie2['decided_by']) == ('fixed16', 'tie_2_lower_budget')
339:     refusals = [
340:         {'fixed16': _fixed('fixed16', ['good'], missing=['finish_reason']), 'fixed32': _fixed('fixed32', ['good'])},
341:         {'fixed16': _fixed('fixed16', ['good'], purpose='eval'), 'fixed32': _fixed('fixed32', ['good'])},
342:         {'fixed16': _fixed('fixed16', ['good']), 'fixed32': _fixed('fixed32', ['good'], identity='f' * 64)},
343:         {'fixed16': _fixed('fixed16', ['good'])},
344:     ]
345:     reasons = [nm.select_train_fixed(item) for item in refusals]
346:     assert [item['status'] for item in reasons] == ['REFUSED'] * 4
347:     assert 'no TTFT-only substitute' in reasons[0]['reason'] and 'Train only' in reasons[1]['reason']
