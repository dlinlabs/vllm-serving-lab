55: def test_all_offered_fates_ttft_origins_penalty_and_usage_bounds():
56:     rows = [row('a', 'complete', 10.0, 10.01, 10.21, 11.0, ct=20),
57:             row('b', 'complete', 10.5, 10.5, 10.9, 11.5, ct=None),
58:             row('c', 'rejected', 11.0, 11.0, None, 11.01),
59:             row('d', 'not_launched', 12.0),
60:             row('e', 'cancelled', 13.0, 13.0, None, 19.0),
61:             row('f', 'unknown', 14.0),
62:             row('g', 'stream_error', 14.5, 14.5, 14.6, 15.0, ct=3)]
63:     metrics = nm.compute(run(rows))
64:     outcomes = metrics['outcomes']
65:     assert metrics['all_offered'] == 7
66:     assert outcomes['fates'] == {'complete': 2, 'rejected': 1, 'http_error': 0, 'stream_error': 1,
67:                                  'transport_error': 0, 'cancelled': 1, 'not_launched': 1, 'unknown': 1}
68:     assert outcomes['rejection_rate'] == pytest.approx(1 / 7)  # not_launched is never merged into rejection
69:     assert outcomes['failure_rate'] == pytest.approx(2 / 7)
70:     assert outcomes['not_launched_rate'] == pytest.approx(1 / 7) and outcomes['unknown_rate'] == pytest.approx(1 / 7)
71:     ttft = metrics['ttft_s']
72:     assert ttft['conditional_scheduled']['n'] == 2
73:     assert ttft['conditional_scheduled']['p50'] == pytest.approx(0.21)
74:     assert ttft['conditional_client_send']['p50'] == pytest.approx(0.20)
75:     assert ttft['conditional_scheduled']['p95'] == pytest.approx(0.4)
76:     assert ttft['conditional_scheduled']['p95_is_sample_max'] is True
77:     penalized = ttft['all_offered_penalized_scheduled']
78:     assert (penalized['n'], penalized['n_failure_penalty'], penalized['p50_rank']) == (7, 4, 4)
79:     assert penalized['p50'] is None and penalized['p50_null_reason'] == 'rank_falls_on_failure_penalty'
80:     assert 'NOT a survival-analysis' in penalized['estimand']
81:     assert metrics['send_lag_s']['n'] == 5 and metrics['send_lag_s']['n_not_sent'] == 2
82:     throughput = metrics['throughput']
83:     assert throughput['delivered'] == 2 and throughput['cohort_normalized_delivered_rps'] == pytest.approx(0.4)
84:     assert throughput['wall_envelope_delivered_rps'] == pytest.approx(0.2)
85:     assert (throughput['completion_tokens_observed'], throughput['completion_tokens_upper_bound']) == (20, 148)
86:     assert throughput['cohort_normalized_completion_tokens_per_s'] == {'lower': 4.0, 'upper': 29.6, 'exact': False}
87:     assert throughput['wall_envelope_completion_tokens_per_s'] == {'lower': 2.0, 'upper': 14.8, 'exact': False}
88:     assert throughput['undelivered_reported_completion_tokens'] == 3
89:     natural = metrics['natural_slo']
90:     assert natural['available'] is False and natural['natural_slo_good'] is None
91:     assert natural['null_reason'] == 'natural_slo_fields_unavailable' and natural['missing']
92:     assert metrics['controller_overhead']['available'] is False
93:     assert metrics['controller_overhead']['null_reason'] == 'no controller journal in literal test'
94:     windows = metrics['windows']
95:     assert windows['envelope_scope'] == 'offered_cohort_observed' and windows['full_wall_s'] is None
96:     assert 'full wall not recorded' in windows['full_wall_null_reason']
97:     json.dumps(metrics, allow_nan=False)
