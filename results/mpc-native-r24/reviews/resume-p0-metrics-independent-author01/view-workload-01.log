268: def _replay_adapter_mapping():
269:     return {
270:         'consumer': 'run_trace_pilot.py via trace_workload.load_trace/validate_trace/verify_prompts (schema_version 1)',
271:         'parser_compatible_directly': False,
272:         'reason': 'schema_version 1 requests require prompt text and tokenizer-measured chat-template input_tokens',
273:         'function': 'nominal_workload.to_replay_trace(tape, model=..., prompt_for=..., count_tokens=..., '
274:                     'tokenizer_sha256=...)',
275:         'field_mapping': {
276:             'schema_version': 1, 'max_model_len': REPLAY_MAX_MODEL_LEN,
277:             'model': 'caller supplied (trace_workload.MODEL)',
278:             'duration_seconds': 'duration_ns / 1e9', 'output_cap': 'max_output_tokens',
279:             'trace_id': 'request_id', 'arrival_seconds': 'offset_ns / 1e9 (correctly rounded binary64)',
280:             'prompt': 'prompt_for(requested_prompt_tokens, payload_key)',
281:             'input_tokens': 'MEASURED count_tokens(prompt); requested label kept in provenance',
282:             'max_tokens': 'max_output_tokens',
283:         },
284:         'recipe_not_executed_here': [
285:             'import json, sys',
286:             "sys.path[:0] = ['<ROOT>', '<ROOT>/experiments/mpc-research/resume-mvp']",
287:             'from transformers import AutoTokenizer',
288:             'import trace_workload as tw, nominal_workload as nw',
289:             'tok = AutoTokenizer.from_pretrained(tw.MODEL, local_files_only=True)',
290:             "tape = nw.load_tape('<tapes-v1>/<purpose>.tape.json', purpose='<purpose>')",
291:             'trace = nw.to_replay_trace(tape, model=tw.MODEL, prompt_for=lambda n, key: tw.synthetic_prompt(tok, n, key), '
292:             "count_tokens=lambda text: tw.input_tokens(tok, [{'role': 'user', 'content': text}]), "
293:             'tokenizer_sha256=tw.tokenizer_fingerprint(tok))',
294:             'tw.validate_trace(trace); tw.verify_prompts(trace, tok)',
295:             "open('<new replay trace path>', 'x').write(json.dumps(trace))",
296:         ],
297:         'pilot_command_template': 'python run_trace_pilot.py --trace <replay trace json> --output-dir <new dir> '
298:                                   '--ttft-slo <PENDING Mayor> (--budget <PENDING Mayor> | --budget-schedule '
299:                                   '<PENDING Mayor>) --cache-policy disabled',
300:         'pilot_command_notes': [
301:             '--cache-policy disabled is self-reported by the pilot; the vLLM server must actually be launched with prefix '
302:             'caching disabled and that launch verified separately.',
303:             'The Eval replay trace may be built and replayed only by the measurement harness, never by '
304:             'controllers/forecasters/tuning.',
305:         ],
306:         'native_client_mapping': 'NOT_VERIFIED: the peer-owned native-client offered-trace schema was not read by this '
307:                                  'component (Runtime6 owns it)',
308:     }
309: 
310: 
311: def _check_pair(protocol):
312:     specs = [_validated(protocol, purpose)[1] for purpose in PURPOSES]
313:     train, evaluation = specs
314:     if train['source_id'] == evaluation['source_id']:
315:         raise ValueError('Train and Eval source IDs must differ')
316:     if (train['request_id_prefix'].startswith(evaluation['request_id_prefix'])
317:             or evaluation['request_id_prefix'].startswith(train['request_id_prefix'])):
318:         raise ValueError('Train and Eval request-ID namespaces must be disjoint (neither prefix may extend the other)')
319: 
320: 
321: def build_outputs(protocol=None):
322:     """All output bytes (both tapes and ONE manifest), built entirely in memory before any write."""
323:     protocol = protocol_v1() if protocol is None else protocol
324:     _check_pair(protocol)
325:     outputs = {}
326:     splits = {}
327:     for purpose in PURPOSES:
328:         tape = generate_split(protocol, purpose)
329:         data = encode_tape(tape)
330:         name = f'{purpose}.tape.json'
331:         outputs[name] = data
332:         splits[purpose] = {
333:             'file': name, 'sha256': sha256_hex(data), 'bytes': len(data), 'count': tape['count'],
334:             'seed': tape['split']['seed'], 'source_id': tape['split']['source_id'],
335:             'request_id_prefix': tape['split']['request_id_prefix'], 'policy': POLICY[purpose],
336:         }
337:     manifest = {
338:         'schema': MANIFEST_SCHEMA,
339:         'kind': 'SYNTHETIC_OFFERED_WORKLOAD_MANIFEST',
340:         'generator': {'id': GENERATOR_ID, 'version': GENERATOR_VERSION, 'module': MODULE_PATH,
341:                       'module_sha256': _module_sha256()},
342:         'protocol': protocol,
343:         'protocol_sha256': sha256_hex(canonical_bytes(protocol)),
344:         'frozen_cli': {
345:             'generate': f'python -B -I {MODULE_PATH} generate --out-dir <new dir>',
346:             'verify': f'python -B -I {MODULE_PATH} verify --out-dir <dir>',
347:             'protocol_overrides': 'none: the CLI has no protocol override flags',
348:         },
349:         'splits': splits,
350:         'holdout_basis': list(HOLDOUT_BASIS),
351:         'prompt_length_semantics': PROMPT_LENGTH_SEMANTICS,
352:         'execution_distinction': 'This synthetic offered workload and any Native/GPU execution measurement are distinct '
353:                                  'artifacts; this component executed nothing on a backend.',
354:         'replay_adapter': _replay_adapter_mapping(),
355:         'claims_not_made': list(CLAIMS_NOT_MADE),
356:     }
357:     outputs[MANIFEST_NAME] = canonical_bytes(manifest)
358:     return outputs
359: 
360: 
361: def _summary(outputs):
362:     manifest = json.loads(outputs[MANIFEST_NAME])
363:     return {
364:         'files': {name: {'sha256': sha256_hex(data), 'bytes': len(data)} for name, data in sorted(outputs.items())},
365:         'counts': {purpose: manifest['splits'][purpose]['count'] for purpose in PURPOSES},
366:         'module_sha256': manifest['generator']['module_sha256'],
367:     }
368: 
369: 
370: def write_outputs(out_dir):
371:     """Generate the frozen v1 outputs into a NEW directory; never overwrites."""
372:     outputs = build_outputs()
373:     out = Path(out_dir)
374:     out.mkdir(exist_ok=False)
375:     for name in sorted(outputs):
376:         with (out / name).open('xb') as handle:
377:             handle.write(outputs[name])
378:     return _summary(outputs)
379: 
380: 
381: def verify_outputs(out_dir):
382:     """Regenerate in memory and require the directory to hold exactly the same files and bytes."""
383:     outputs = build_outputs()
384:     out = Path(out_dir)
385:     present = sorted(path.name for path in out.iterdir())
386:     if present != sorted(outputs):
387:         raise VerificationError(f'{out}: expected files {sorted(outputs)}, found {present}')
388:     for name, data in sorted(outputs.items()):
389:         if (out / name).read_bytes() != data:
390:             raise VerificationError(f'{out / name}: bytes differ from the regenerated v1 output')
391:     return _summary(outputs)
392: 
393: 
394: def load_tape(path, *, purpose):
395:     """Load one frozen v1 tape after checking its declared purpose and exact bytes."""
396:     if purpose not in PURPOSES:
397:         raise ValueError(f'purpose must be one of {PURPOSES}')
398:     data = Path(path).read_bytes()
399:     try:
400:         parsed = json.loads(data)
401:     except ValueError as exc:
402:         raise TapeIntegrityError(f'{path}: not JSON') from exc
403:     split = parsed.get('split') if isinstance(parsed, dict) else None
404:     declared = split.get('purpose') if isinstance(split, dict) else None
405:     if declared != purpose:
406:         raise TapePurposeError(f'{path}: tape purpose {declared!r} != requested {purpose!r}')
407:     if data != encode_tape(generate_split(protocol_v1(), purpose)):
408:         raise TapeIntegrityError(f'{path}: bytes differ from the frozen v1 {purpose} tape')
409:     return parsed
410: 
411: 
412: def _check_tape_shape(tape):
413:     if not isinstance(tape, dict) or tape.get('schema') != TAPE_SCHEMA or tape.get('kind') != TAPE_KIND:
414:         raise ValueError('not an offered tape of schema ' + TAPE_SCHEMA)
415:     if tape.get('columns') != list(COLUMNS) or not isinstance(tape.get('rows'), list):
416:         raise ValueError('offered tape columns/rows malformed')
417:     if tape.get('count') != len(tape['rows']):
418:         raise ValueError('offered tape count does not match its rows')
419:     cap = tape['protocol']['max_output_tokens']
420:     for row in tape['rows']:
421:         if not isinstance(row, list) or len(row) != len(COLUMNS) or row[3] != cap:
422:             raise ValueError('offered tape row malformed')
423: 
424: 
425: def to_replay_trace(tape, *, model, prompt_for, count_tokens, tokenizer_sha256=None):
426:     """Map an offered tape onto the run_trace_pilot replay schema (trace_workload schema_version 1).
427: 
428:     prompt_for(requested_prompt_tokens, payload_key) -> prompt text (shared template);
429:     count_tokens(prompt) -> MEASURED chat-template token count used as input_tokens.
430:     Synthesis or counting errors propagate: no retry, no new key, no fallback to the label.
431:     """
432:     _check_tape_shape(tape)
433:     if not isinstance(model, str) or not model:
434:         raise ValueError('model must be a non-empty string')
435:     if not tape['rows']:
436:         raise ValueError('an empty offered tape cannot form a replay trace (schema_version 1 needs >= 1 request)')
437:     cap = tape['protocol']['max_output_tokens']
438:     requests = []
439:     requested = []
440:     for request_id, offset_ns, requested_tokens, max_output_tokens, payload_key in tape['rows']:
441:         prompt = prompt_for(requested_tokens, payload_key)
442:         if not isinstance(prompt, str):
443:             raise TypeError(f'{request_id}: prompt_for must return text')
444:         measured = count_tokens(prompt)
445:         if type(measured) is not int or measured <= 0 or measured + cap > REPLAY_MAX_MODEL_LEN:
446:             raise ValueError(f'{request_id}: measured input token count {measured!r} is not an int in '
447:                              f'[1, {REPLAY_MAX_MODEL_LEN - cap}]')
448:         requests.append({'trace_id': request_id, 'arrival_seconds': offset_ns / NS_PER_SECOND,
449:                          'input_tokens': measured, 'max_tokens': max_output_tokens, 'prompt': prompt})
450:         requested.append(requested_tokens)
451:     provenance = {
452:         'kind': TAPE_KIND,
453:         'offered_tape_schema': TAPE_SCHEMA,
454:         'offered_tape_sha256': sha256_hex(encode_tape(tape)),
455:         'generator': tape['generator'],
456:         'protocol_id': tape['protocol']['protocol_id'],
457:         'purpose': tape['split']['purpose'],
458:         'source_id': tape['split']['source_id'],
459:         'requested_prompt_tokens': requested,
460:         'measured_equals_requested_count': sum(q['input_tokens'] == n for q, n in zip(requests, requested)),
461:         'prompt_length_semantics': PROMPT_LENGTH_SEMANTICS,
462:     }
463:     if tokenizer_sha256 is not None:
464:         if not isinstance(tokenizer_sha256, str) or not tokenizer_sha256:
465:             raise ValueError('tokenizer_sha256 must be a non-empty string when given')
466:         provenance['tokenizer_sha256'] = tokenizer_sha256
467:     return {
468:         'schema_version': 1,
469:         'max_model_len': REPLAY_MAX_MODEL_LEN,
470:         'model': model,
471:         'duration_seconds': tape['protocol']['duration_ns'] / NS_PER_SECOND,
472:         'output_cap': cap,
473:         'requests': requests,
474:         'provenance': provenance,
475:     }
476: 
477: 
478: def main(argv=None):
479:     parser = argparse.ArgumentParser(description='Frozen protocol v1 synthetic offered-workload tapes '
480:                                                  '(no protocol override flags).', allow_abbrev=False)
481:     commands = parser.add_subparsers(dest='command', required=True)
482:     for name in ('generate', 'verify'):
483:         commands.add_parser(name, allow_abbrev=False).add_argument('--out-dir', required=True)
484:     args = parser.parse_args(argv)
485:     try:
486:         summary = write_outputs(args.out_dir) if args.command == 'generate' else verify_outputs(args.out_dir)
487:     except (OSError, ValueError) as exc:
488:         print(json.dumps({'status': 'REFUSED', 'command': args.command, 'error': f'{type(exc).__name__}: {exc}'},
489:                          sort_keys=True), file=sys.stderr)
490:         return 1
491:     print(json.dumps({'status': 'OK', 'command': args.command, **summary}, sort_keys=True, indent=1))
492:     return 0
493: 
494: 
495: if __name__ == '__main__':
496:     sys.exit(main())
