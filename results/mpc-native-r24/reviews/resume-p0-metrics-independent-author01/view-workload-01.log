1: """Predeclared SYNTHETIC offered-workload tapes (Train/Eval) for future real-GPU measurements.
2: 
3: Protocol v1 values are Mayor protocol choices: they are not verified capacity or model accuracy
4: and were not designed for an MPC win.  A tape is a synthetic *offered* workload drawn from a
5: public deterministic generator; it carries no outcomes and is distinct from any Native/GPU
6: execution of it.  Requested prompt-length classes are labels: backend tokenization and gateway
7: cost are measured at replay time (see ``to_replay_trace``), never assumed equal to the label.
8: 
9: CLI (no protocol override flags exist):
10:     python -B -I nominal_workload.py generate --out-dir NEW_DIR
11:     python -B -I nominal_workload.py verify --out-dir DIR
12: """
13: import argparse
14: import decimal
15: import hashlib
16: import json
17: from pathlib import Path
18: import sys
19: 
20: GENERATOR_ID = 'r24-resume-p0-nominal-workload-generator'
21: GENERATOR_VERSION = 1
22: MODULE_PATH = 'experiments/mpc-research/resume-mvp/nominal_workload.py'
23: TAPE_SCHEMA = 'r24-resume-p0-offered-tape-v1'
24: TAPE_KIND = 'SYNTHETIC_OFFERED_WORKLOAD_TAPE'
25: MANIFEST_SCHEMA = 'r24-resume-p0-workload-manifest-v1'
26: MANIFEST_NAME = 'manifest.json'
27: PURPOSES = ('train', 'eval')
28: STREAMS = ('arrival', 'length_class', 'payload')
29: COLUMNS = ('request_id', 'offset_ns', 'requested_prompt_tokens', 'max_output_tokens', 'payload_key')
30: REPLAY_MAX_MODEL_LEN = 8192  # trace_workload.MAX_MODEL_LEN for replay schema_version 1
31: NS_PER_SECOND = 1_000_000_000
32: TWO_64 = 1 << 64
33: DECIMAL_PRECISION = 50
34: MAX_SUPPORTED_OFFERS = 10_000  # request IDs use a 4-digit index
35: 
36: _PROTOCOL_V1 = {
37:     'protocol_id': 'r24-resume-p0-nominal-workload-v1',
38:     'protocol_version': 1,
39:     'kind': 'SYNTHETIC_OFFERED_WORKLOAD',
40:     'duration_ns': 5 * NS_PER_SECOND,
41:     'arrival_process': 'homogeneous_poisson',
42:     'arrival_rate_per_second': 20,
43:     'max_offers': 1024,
44:     'prompt_length_classes': [256, 1024, 3072],
45:     'prompt_length_class_distribution': 'uniform',
46:     'max_output_tokens': 128,
47:     'later_gpu_config': {'prefix_cache': 'disabled: required for later GPU measurement; not verified by this CPU component'},
48:     'splits': {
49:         'train': {'seed': 4101, 'source_id': 'synthetic:r24-resume-p0-nominal-workload:v1:train',
50:                   'request_id_prefix': 'p0w1-train-'},
51:         'eval': {'seed': 4102, 'source_id': 'synthetic:r24-resume-p0-nominal-workload:v1:eval',
52:                  'request_id_prefix': 'p0w1-eval-'},
53:     },
54: }
55: 
56: DISCLAIMERS = (
57:     'SYNTHETIC offered workload from a public deterministic generator: not a real or Azure trace and not a '
58:     'held-out real-trace sample.',
59:     'Offered workload only: no execution outcomes; any Native/GPU execution of this tape is a separate measurement.',
60:     'requested_prompt_tokens are class labels: backend tokenization and gateway cost must be measured, not assumed equal.',
61:     'Protocol values are protocol choices, not verified capacity or model accuracy, and were not designed for an MPC win.',
62: )
63: POLICY = {
64:     'train': 'Train split: controllers/forecasters may take scenario information only from Train and past observations, '
65:              'using a forecast RNG distinct from every domain of this generator; Train selection method PENDING Mayor/Role7.',
66:     'eval': 'Eval split (held out): controllers, forecasters and tuning must never read or regenerate this tape or use its '
67:             'outcomes; only the measurement harness replays it.',
68: }
69: RNG_SPEC = {
70:     'uniform': 'X(purpose, seed, stream, k) = big-endian uint64 of the first 8 bytes of sha256(domain || k as 8-byte '
71:                'big-endian); domain = ASCII JSON (separators "," ":") of [generator_id, generator_version, protocol_id, '
72:                'purpose, seed, stream] followed by one 0x00 byte',
73:     'streams': list(STREAMS),
74:     'arrival': 'gap_seconds = (ln(2^64) - ln(2^64 - X)) / rate in decimal.Context(prec=50, ROUND_HALF_EVEN); arrival time '
75:                't accumulates from 0; offset_ns = floor(t * 10^9); stop at the first offset_ns >= duration_ns; arrival '
76:                'k = request index; more than max_offers in-window arrivals is refused (no truncation or resampling)',
77:     'length_class': 'class = prompt_length_classes[(X * n_classes) >> 64] with k = request index (bias <= 2^-64)',
78:     'payload': 'nonce = 16 lowercase hex digits of X with k = request index',
79:     'decimal_precision': DECIMAL_PRECISION,
80: }
81: PAYLOAD_GENERATION = {
82:     'key_format': 'protocol_id/purpose/request_id/nonce',
83:     'template': 'SHARED by both splits at replay-adapter time: trace_workload.synthetic_prompt(tokenizer, '
84:                 'requested_prompt_tokens, payload_key); tapes carry no prompt text',
85: }
86: PROMPT_LENGTH_SEMANTICS = (
87:     'requested_prompt_tokens is a protocol class label (requested chat-template tokens). It is not assumed equal to '
88:     'backend tokenization or gateway cost: replay input_tokens are measured with the replay tokenizer and gateway cost '
89:     'is whatever the gateway computes at run time.'
90: )
91: HOLDOUT_BASIS = (
92:     'Generator independence: each tape is a pure function of the shared protocol fields and its own split spec; RNG '
93:     'domains include purpose and seed, so Train and Eval use disjoint SHA-256 counter domains (tested: Eval bytes are '
94:     'invariant to Train seed/source/prefix changes and vice versa; equal seeds with different purposes still differ).',
95:     'Membership: request-ID namespaces and payload keys (which embed purpose) are disjoint; source IDs differ; the '
96:     'Train tape contains no Eval seed, source or prefix.',
97:     'Provenance: this manifest pins the protocol, module and both tape SHA-256 values; verify regenerates byte-identically.',
98:     'Unequal hashes alone are NOT claimed as holdout evidence. Both seeds are public, so this is a procedural holdout of '
99:     'synthetic draws from one public generator: not an OOD/generalization split and not an Azure or real-trace holdout.',
100: )
101: CLAIMS_NOT_MADE = (
102:     'no CPU or GPU performance result', 'no capacity or model-accuracy claim', 'no OOD/generalization claim',
103:     'no Azure or real-trace held-out claim', 'no MPC/controller superiority claim',
104:     'requested prompt length is not claimed equal to backend tokenization or gateway cost',
105:     'prefix cache disabled is required but not verified here', 'native-client compatibility NOT_VERIFIED',
106:     'Train selection method not chosen here (PENDING Mayor/Role7)',
107: )
