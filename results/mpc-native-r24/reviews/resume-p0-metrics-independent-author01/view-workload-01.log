109: 
110: class OfferCapExceeded(ValueError):
111:     """More in-window arrivals than max_offers: refused, never truncated or resampled."""
112: 
113: 
114: class TapeIntegrityError(ValueError):
115:     """Tape bytes differ from the frozen generator output."""
116: 
117: 
118: class TapePurposeError(ValueError):
119:     """Tape split purpose differs from the purpose the caller declared."""
120: 
121: 
122: class VerificationError(ValueError):
123:     """Output directory differs from the regenerated outputs."""
124: 
125: 
126: def protocol_v1():
127:     """Fresh copy of the frozen protocol v1 (callers cannot mutate the frozen constant)."""
128:     return json.loads(json.dumps(_PROTOCOL_V1))
129: 
130: 
131: def canonical_bytes(obj):
132:     return json.dumps(obj, sort_keys=True, separators=(',', ':'), ensure_ascii=True,
133:                       allow_nan=False).encode('ascii') + b'\n'
134: 
135: 
136: def sha256_hex(data):
137:     return hashlib.sha256(data).hexdigest()
138: 
139: 
140: def decimal_context():
141:     return decimal.Context(prec=DECIMAL_PRECISION, rounding=decimal.ROUND_HALF_EVEN, Emin=-999999, Emax=999999,
142:                            capitals=1, clamp=0, flags=[],
143:                            traps=[decimal.InvalidOperation, decimal.DivisionByZero, decimal.Overflow])
144: 
145: 
146: def rng_domain(protocol_id, purpose, seed, stream):
147:     material = json.dumps([GENERATOR_ID, GENERATOR_VERSION, protocol_id, purpose, seed, stream],
148:                           separators=(',', ':'), ensure_ascii=True)
149:     return material.encode('ascii') + b'\x00'
150: 
151: 
152: def uniform64(domain, k):
153:     return int.from_bytes(hashlib.sha256(domain + k.to_bytes(8, 'big')).digest()[:8], 'big')
154: 
155: 
156: def _positive_int(value, name, upper=None):
157:     if type(value) is not int or value <= 0 or (upper is not None and value > upper):
158:         raise ValueError(f'{name} must be a positive int' + (f' <= {upper}' if upper is not None else ''))
159:     return value
160: 
161: 
162: def exponential_gap_seconds(x, rate, context=None):
163:     """Exact-decimal exponential(rate) inverse-CDF draw on the uint64 grid."""
164:     if type(x) is not int or not 0 <= x < TWO_64:
165:         raise ValueError('x must be an int in [0, 2^64)')
166:     _positive_int(rate, 'rate')
167:     ctx = decimal_context() if context is None else context
168:     numerator = ctx.subtract(ctx.ln(decimal.Decimal(TWO_64)), ctx.ln(decimal.Decimal(TWO_64 - x)))
169:     return ctx.divide(numerator, decimal.Decimal(rate))
170: 
171: 
172: def length_class_index(x, n_classes):
173:     if type(x) is not int or not 0 <= x < TWO_64:
174:         raise ValueError('x must be an int in [0, 2^64)')
175:     _positive_int(n_classes, 'n_classes')
176:     return (x * n_classes) >> 64
177: 
178: 
179: def _nonempty_str(value, name):
180:     if not isinstance(value, str) or not value or not value.isascii():
181:         raise ValueError(f'{name} must be a non-empty ASCII string')
182:     return value
183: 
184: 
185: def _validated(protocol, purpose):
186:     if purpose not in PURPOSES:
187:         raise ValueError(f'purpose must be one of {PURPOSES}')
188:     if not isinstance(protocol, dict):
189:         raise ValueError('protocol must be a dict')
190:     _nonempty_str(protocol.get('protocol_id'), 'protocol_id')
191:     _positive_int(protocol.get('protocol_version'), 'protocol_version')
192:     if protocol.get('kind') != 'SYNTHETIC_OFFERED_WORKLOAD':
193:         raise ValueError('protocol kind must be SYNTHETIC_OFFERED_WORKLOAD')
194:     if protocol.get('arrival_process') != 'homogeneous_poisson':
195:         raise ValueError('only a homogeneous Poisson arrival process is implemented')
196:     if protocol.get('prompt_length_class_distribution') != 'uniform':
197:         raise ValueError('only a uniform prompt-length class distribution is implemented')
198:     _positive_int(protocol.get('duration_ns'), 'duration_ns')
199:     _positive_int(protocol.get('arrival_rate_per_second'), 'arrival_rate_per_second')
200:     _positive_int(protocol.get('max_offers'), 'max_offers', MAX_SUPPORTED_OFFERS)
201:     cap = protocol.get('max_output_tokens')
202:     if type(cap) is not int or not 0 < cap < REPLAY_MAX_MODEL_LEN:
203:         raise ValueError('max_output_tokens must be an int in (0, 8192)')
204:     classes = protocol.get('prompt_length_classes')
205:     if (not isinstance(classes, list) or not classes
206:             or any(type(c) is not int or c <= 0 or c + cap > REPLAY_MAX_MODEL_LEN for c in classes)
207:             or any(a >= b for a, b in zip(classes, classes[1:]))):
208:         raise ValueError('prompt_length_classes must be strictly increasing positive ints with class + cap <= 8192')
209:     splits = protocol.get('splits')
210:     split = splits.get(purpose) if isinstance(splits, dict) else None
211:     if not isinstance(split, dict) or set(split) != {'seed', 'source_id', 'request_id_prefix'}:
212:         raise ValueError(f'protocol needs a {purpose} split with exactly seed, source_id and request_id_prefix')
213:     if type(split['seed']) is not int or split['seed'] < 0:
214:         raise ValueError('seed must be a non-negative int')
215:     _nonempty_str(split['source_id'], 'source_id')
216:     _nonempty_str(split['request_id_prefix'], 'request_id_prefix')
217:     shared = {key: value for key, value in protocol.items() if key != 'splits'}
218:     return json.loads(json.dumps(shared)), dict(split, purpose=purpose)
219: 
220: 
221: def generate_split(protocol, purpose):
222:     """Pure function of the shared protocol fields and this purpose's own split spec."""
223:     shared, split = _validated(protocol, purpose)
224:     ctx = decimal_context()
225:     domains = {stream: rng_domain(shared['protocol_id'], purpose, split['seed'], stream) for stream in STREAMS}
226:     classes = shared['prompt_length_classes']
227:     cap = shared['max_output_tokens']
228:     rows = []
229:     t = decimal.Decimal(0)
230:     k = 0
231:     while True:
232:         t = ctx.add(t, exponential_gap_seconds(uniform64(domains['arrival'], k), shared['arrival_rate_per_second'], ctx))
233:         k += 1
234:         offset_ns = int(ctx.scaleb(t, 9).to_integral_value(rounding=decimal.ROUND_FLOOR, context=ctx))
235:         if offset_ns >= shared['duration_ns']:
236:             break
237:         index = len(rows)
238:         if index >= shared['max_offers']:
239:             raise OfferCapExceeded(f'{purpose}: more than max_offers={shared["max_offers"]} arrivals inside the window; '
240:                                    'refused without truncation or resampling')
241:         request_id = f'{split["request_id_prefix"]}{index:04d}'
242:         requested = classes[length_class_index(uniform64(domains['length_class'], index), len(classes))]
243:         nonce = format(uniform64(domains['payload'], index), '016x')
244:         rows.append([request_id, offset_ns, requested, cap, f'{shared["protocol_id"]}/{purpose}/{request_id}/{nonce}'])
245:     return {
246:         'schema': TAPE_SCHEMA,
247:         'kind': TAPE_KIND,
248:         'disclaimers': [*DISCLAIMERS, POLICY[purpose]],
249:         'generator': {'id': GENERATOR_ID, 'version': GENERATOR_VERSION},
250:         'protocol': shared,
251:         'split': split,
252:         'rng': json.loads(json.dumps(RNG_SPEC)),
253:         'payload_generation': json.loads(json.dumps(PAYLOAD_GENERATION)),
254:         'columns': list(COLUMNS),
255:         'rows': rows,
256:         'count': len(rows),
257:     }
258: 
259: 
260: def encode_tape(tape):
261:     return canonical_bytes(tape)
262: 
