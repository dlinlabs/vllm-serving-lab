1: """Endpoint-observed natural-EOS scoring, including the complete offered cohort."""
2: 
3: from collections import Counter
4: import math
5: 
6: 
7: RULE = {
8:     "schema": "r23-natural-endpoint-slo-v1",
9:     "denominator": "All retained scheduled arrivals, including not_launched/rejected/failed",
10:     "ttft_from": "scheduled_at", "ttft_limit_s": 0.5,
11:     "multi_token_output_delay": "(terminal_at-first_content_at)/(completion_tokens-1)",
12:     "multi_token_output_delay_limit_s": 0.05,
13:     "one_token": "TPOT undefined; require terminal_at-scheduled_at <=0.5s, plus TTFT<=0.5s",
14:     "natural_completion": "status complete, ignore_eos false, stream_done, no stream_error, finish_reason stop, G>=1",
15:     "capped": "finish_reason length is censored and receives no natural-completion SLO credit",
16:     "scope": "HTTP observations/proxies, not per-token clocks or serial/exclusive GPU service",
17: }
18: 
19: 
20: def natural_good(row):
21:     if (row.get("status") != "complete" or row.get("finish_reason") != "stop"
22:             or row.get("requested_ignore_eos") is not False
23:             or row.get("stream_done") is not True or row.get("stream_error") is not False):
24:         return False
25:     usage = row.get("usage")
26:     tokens = usage.get("completion_tokens") if isinstance(usage, dict) else None
27:     if type(tokens) is not int or tokens < 1:
28:         return False
29:     scheduled, first, terminal = (row.get(key) for key in
30:                                   ("scheduled_at", "first_content_at", "terminal_at"))
31:     if any(type(value) not in (int, float) or not math.isfinite(value)
32:            for value in (scheduled, first, terminal)):
33:         return False
34:     if not scheduled <= first <= terminal or first - scheduled > RULE["ttft_limit_s"]:
35:         return False
36:     if tokens == 1:
37:         return terminal - scheduled <= RULE["ttft_limit_s"]
38:     return (terminal - first) / (tokens - 1) <= RULE["multi_token_output_delay_limit_s"]
39: 
40: 
41: def score(rows, duration_s, *, offered_start, accounting_started_at, accounting_finished_at):
42:     if type(duration_s) not in (int, float) or not math.isfinite(duration_s) or duration_s <= 0:
43:         raise ValueError("positive_measured_offered_window_required")
44:     if (any(type(value) not in (int, float) or not math.isfinite(value) for value in
45:             (offered_start, accounting_started_at, accounting_finished_at))
46:             or not accounting_started_at <= offered_start
47:             or accounting_finished_at < offered_start + duration_s):
48:         raise ValueError("complete_policy_and_tail_accounting_interval_required")
49:     good = sum(natural_good(row) for row in rows)
50:     window_end = offered_start + duration_s
51:     in_window = sum(natural_good(row) and row["terminal_at"] <= window_end for row in rows)
52:     return {
53:         "rule": RULE, "all_offered": len(rows),
54:         "statuses": dict(Counter(row.get("status", "missing") for row in rows)),
55:         "finish_reasons": dict(Counter(str(row.get("finish_reason")) for row in rows)),
56:         "one_token_complete": sum(
57:             row.get("status") == "complete" and (row.get("usage") or {}).get("completion_tokens") == 1
58:             for row in rows
59:         ),
60:         "censored_cap_completions": sum(
61:             row.get("status") == "complete" and row.get("finish_reason") == "length" for row in rows
62:         ),
63:         "natural_slo_good": good, "offered_window_s": duration_s,
64:         "cohort_slo_goodput_rps": good / duration_s,
65:         "in_window_slo_goodput_rps": in_window / duration_s,
66:         "policy_and_tail_wall_s": accounting_finished_at - accounting_started_at,
67:         "policy_and_tail_wall_slo_goodput_rps": good / (accounting_finished_at - accounting_started_at),
68:         "after_offer_tail_and_accounting_s": accounting_finished_at - window_end,
69:         "all_offered_good_fraction": good / len(rows) if rows else None,
70:         "tail_scope": "All cohort outcomes, including completions after offered window; tail remains measured",
71:     }
