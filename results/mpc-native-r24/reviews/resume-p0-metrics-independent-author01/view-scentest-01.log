44:     def test_repeatable_decision_separate_rng_domain_and_truthful_availability(self):
45:         snapshot = self.snapshot()
46:         first_clock = iter((snapshot.sampled_at + 0.01, snapshot.sampled_at + 0.03))
47:         second_clock = iter((snapshot.sampled_at + 0.04, snapshot.sampled_at + 0.06))
48:         original_open = Path.open
49:         allowed = {Path(ns.__file__).resolve(), Path(workload.__file__).resolve()}
50: 
51:         def source_only_open(path, *args, **kwargs):
52:             self.assertIn(path.resolve(), allowed, "Per-decision tape/data read")
53:             return original_open(path, *args, **kwargs)
54: 
55:         with patch.object(workload, "generate_split", side_effect=AssertionError("No generator calls")):
56:             with patch.object(Path, "open", new=source_only_open):
57:                 first = ns.make_scenario(self.prior, snapshot, purpose="evaluation", clock=lambda: next(first_clock))
58:                 second = ns.make_scenario(self.prior, snapshot, purpose="evaluation", clock=lambda: next(second_clock))
59:         self.assertEqual(first.causal.scenario, second.causal.scenario)
60:         self.assertEqual(first.rng_seed_material, second.rng_seed_material)
61:         self.assertEqual(first.causal.available_at, snapshot.sampled_at + 0.03)
62:         self.assertEqual(second.causal.available_at, snapshot.sampled_at + 0.06)
63:         self.assertEqual(first.causal.conditioned_on, planner.StateVersion.from_snapshot(snapshot))
64:         material = json.loads(first.rng_seed_material)
65:         self.assertNotEqual(material[0], workload.GENERATOR_ID)
66:         self.assertEqual(material[:2], [ns.RNG_NAMESPACE, ns.RNG_SEED])
67:         self.assertTrue(all(o.request_id.startswith(ns.RNG_NAMESPACE + ":")
68:                             and o.output_tokens == o.max_tokens == 128
69:                             and 0 <= o.offset_s < 15 for o in first.causal.scenario.offers))
70:         changed = ns.make_scenario(
71:             self.prior, replace(snapshot, sequence=8), purpose="evaluation",
72:             clock=lambda: snapshot.sampled_at + 0.07,
73:         )
74:         self.assertNotEqual(first.rng_seed_material, changed.rng_seed_material)
75:         self.assertNotEqual(first.causal.scenario, changed.causal.scenario)
76:         with self.assertRaises(FrozenInstanceError):
77:             self.prior.count = 1
78:         print("SCENARIO_RECEIPT " + json.dumps({
79:             "kind": "repeatability", "offers": len(first.causal.scenario.offers),
80:             "seed_material": first.rng_seed_material,
81:             "source_sha256": first.causal.source_sha256,
82:             "producer_sources": first.producer_sources,
83:             "scenario_sha256": planner.digest(asdict(first.causal.scenario)),
84:         }, sort_keys=True), flush=True)
