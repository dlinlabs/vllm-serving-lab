86:     def test_prior_and_purpose_refuse_before_unapproved_file_access(self):
87:         with patch.object(Path, "open", side_effect=AssertionError("Must refuse before I/O")):
88:             with self.assertRaisesRegex(ns.ScenarioRefused, "train_only_prior"):
89:                 ns.freeze_train_prior("not-opened", purpose="evaluation", clock_domain="unit")
90:             with self.assertRaisesRegex(ns.ScenarioRefused, "train_filename_required"):
91:                 ns.freeze_train_prior("not-a-train-file", purpose="train", clock_domain="unit")
92:         snapshot = self.snapshot()
93:         with self.assertRaisesRegex(ns.ScenarioRefused, "invalid_forecast_purpose"):
94:             ns.make_scenario(self.prior, snapshot, purpose="eval_future")
95:         with self.assertRaisesRegex(ns.ScenarioRefused, "unfrozen_train_prior"):
96:             ns.make_scenario(
97:                 replace(self.prior, count=100), snapshot, purpose="evaluation",
98:                 clock=lambda: snapshot.sampled_at,
99:             )
