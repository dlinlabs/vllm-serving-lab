101:     def test_clock_causality_and_freshness_refuse(self):
102:         snapshot = self.snapshot()
103:         cases = (
104:             (replace(snapshot, clock_domain="other-boot"), self.prior, (snapshot.sampled_at,) * 2, "clock_domain_mismatch"),
105:             (snapshot, replace(self.prior, available_at=snapshot.sampled_at + 1),
106:              (snapshot.sampled_at,) * 2, "prior_not_available_at_source_time"),
107:             (snapshot, self.prior, (snapshot.sampled_at - 0.001,) * 2, "future_snapshot"),
108:             (snapshot, self.prior, (snapshot.sampled_at + 0.01, snapshot.sampled_at + 0.6), "stale_snapshot"),
109:             (snapshot, self.prior, (snapshot.sampled_at + 0.02, snapshot.sampled_at + 0.01), "nonmonotonic_clock"),
110:         )
111:         for state, prior, values, reason in cases:
112:             with self.subTest(reason=reason):
113:                 clock = iter(values)
114:                 with self.assertRaisesRegex(ns.ScenarioRefused, reason):
115:                     ns.make_scenario(prior, state, purpose="engineering", clock=lambda: next(clock))
116: 
117:     def test_overcap_refuses_without_truncation_or_resampling(self):
118:         snapshot = self.snapshot()
119:         with patch.object(ns, "Random") as random_type:
120:             rng = random_type.return_value
121:             rng.expovariate.return_value = 0.001
122:             rng.randrange.return_value = 0
123:             with self.assertRaisesRegex(ns.ScenarioRefused, "future_offer_cap_exceeded"):
124:                 ns.make_scenario(
125:                     self.prior, snapshot, purpose="evaluation", clock=lambda: snapshot.sampled_at,
126:                 )
127:             random_type.assert_called_once()
128:             self.assertEqual(rng.expovariate.call_count, 513)
129:             self.assertEqual(rng.randrange.call_count, 512)
130:         with patch.object(ns, "Random") as random_type:
131:             random_type.return_value.expovariate.return_value = 0.0
132:             with self.assertRaisesRegex(ns.ScenarioRefused, "nonadvancing_or_invalid_arrival"):
133:                 ns.make_scenario(
134:                     self.prior, snapshot, purpose="engineering", clock=lambda: snapshot.sampled_at,
135:                 )
136:             random_type.return_value.expovariate.assert_called_once()
