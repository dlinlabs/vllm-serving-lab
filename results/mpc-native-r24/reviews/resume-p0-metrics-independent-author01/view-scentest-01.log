23: class NominalScenarioTests(unittest.TestCase):
24:     @classmethod
25:     def setUpClass(cls):
26:         cls.planner = planner.NominalPlanner()
27:         with patch.object(workload, "generate_split", side_effect=AssertionError("No workload regeneration")):
28:             with patch.object(workload, "load_tape", side_effect=AssertionError("load_tape regenerates")):
29:                 cls.prior = ns.freeze_train_prior(
30:                     TRAIN_PATH, purpose="train", clock_domain="literal-cpu-monotonic",
31:                 )
32:         print("SCENARIO_RECEIPT " + json.dumps({
33:             "kind": "frozen-train-prior", "prior": asdict(cls.prior),
34:             "prior_content_sha256": cls.prior.content_sha256,
35:             "scope": "Train-only nominal CPU; tokenizer proof supplied by Mayor, not rerun",
36:         }, sort_keys=True), flush=True)
37: 
38:     def snapshot(self):
39:         return Snapshot(
40:             "literal-forecast-run", self.prior.clock_domain, self.prior.available_at + 0.01,
41:             16.0, 3, (), self.planner.identity, 7,
42:         )
