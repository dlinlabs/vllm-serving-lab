138:     def test_real_cpu_panel_reuses_one_factory_scenario_for_both_policies(self):
139:         now = time.monotonic()
140:         snapshot = replace(self.snapshot(), sampled_at=now)
141:         forecast = ns.make_scenario(self.prior, snapshot, purpose="engineering")
142:         window = planner.DecisionWindow(now, now + 0.09, now + 0.1, now + 0.2)
143:         kwargs = {
144:             "clock_domain": snapshot.clock_domain,
145:             "read_state": lambda: planner.StateVersion.from_snapshot(snapshot),
146:         }
147:         with patch.object(planner, "rollout", wraps=real_rollout) as simulate:
148:             panel = self.planner.evaluate(snapshot, forecast.causal, window, **kwargs)
149:             mpc = self.planner.select(panel, policy="mpc", **kwargs)
150:             one_move = self.planner.select(panel, policy="one_move", **kwargs)
151:         self.assertEqual(simulate.call_count, 8)
152:         self.assertTrue(all(call.args[2] is forecast.causal.scenario for call in simulate.call_args_list))
153:         self.assertIs(panel.scenario, forecast.causal)
154:         self.assertLessEqual(one_move.plan.transitions, 1)
155:         self.assertGreaterEqual(mpc.predicted_lower, one_move.predicted_lower)
156:         print("SCENARIO_RECEIPT " + json.dumps({
157:             "kind": "real-cpu-panel", "scope": "nominal forecast integration only; not Native performance",
158:             "offers": len(forecast.causal.scenario.offers), "rollout_calls": simulate.call_count,
159:             "seed_material": forecast.rng_seed_material, "source_sha256": forecast.causal.source_sha256,
160:             "availability_after_sample_s": forecast.causal.available_at - snapshot.sampled_at,
161:         }, sort_keys=True), flush=True)
162: 
