561: def comparison_table(entries, *, purpose, train_selection=None):
562:     """Measured comparison rows for one split; arms absent from ``entries`` are NOT_RUN.  No winner field."""
563:     if purpose not in PURPOSES:
564:         raise MetricsInputError(f'purpose must be one of {PURPOSES}')
565:     if not isinstance(entries, dict) or not set(entries) <= set(RUN_ARMS):
566:         raise MetricsInputError(f'entries must map a subset of {RUN_ARMS} (train_selected_fixed is derived)')
567:     rows, measured = [], {}
568:     for arm in RUN_ARMS:
569:         entry = entries.get(arm, {'status': 'NOT_RUN', 'reason': 'not provided'})
570:         status = entry.get('status') if isinstance(entry, dict) else None
571:         if status == 'MEASURED':
572:             metrics = entry.get('metrics')
573:             if set(entry) != {'status', 'metrics'} or not isinstance(metrics, dict) or metrics.get('arm') != arm \
574:                     or metrics.get('schema') != SCHEMA or metrics.get('purpose') != purpose:
575:                 raise MetricsInputError(f'{arm}: MEASURED entry needs this arm/split {SCHEMA} metrics')
576:             measured[arm] = metrics
577:             rows.append({'arm': arm, 'status': status, 'reason': None, 'alias_of': None,
578:                          'summary': summarize(metrics)})
579:         elif status in ('REFUSED', 'NOT_RUN') and set(entry) == {'status', 'reason'} \
580:                 and isinstance(entry['reason'], str) and entry['reason']:
581:             rows.append({'arm': arm, 'status': status, 'reason': entry['reason'], 'alias_of': None, 'summary': None})
582:         else:
583:             raise MetricsInputError(f'{arm}: entry status must be MEASURED, REFUSED or NOT_RUN (with reason)')
584:     identities = {(metrics['offered_trace_sha256'], metrics['all_offered'], metrics['windows']['envelope_scope'])
585:                   for metrics in measured.values()}
586:     if len(identities) > 1:
587:         raise MetricsInputError('measured arms differ in offered trace identity, all-offered count or envelope scope: '
588:                                 'incomparable')
589:     if train_selection is not None and (not isinstance(train_selection, dict) or (
590:             train_selection.get('status') == 'SELECTED' and train_selection.get('selected_arm') not in FIXED_BUDGETS)):
591:         raise MetricsInputError('train_selection must be a select_train_fixed result')
592:     if train_selection is None:
593:         alias = {'arm': 'train_selected_fixed', 'status': 'NOT_RUN', 'reason': 'no Train selection provided',
594:                  'alias_of': None, 'summary': None}
595:     elif train_selection.get('status') != 'SELECTED':
596:         alias = {'arm': 'train_selected_fixed', 'status': 'REFUSED',
597:                  'reason': f'Train selection refused: {train_selection.get("reason")}', 'alias_of': None,
598:                  'summary': None}
599:     else:
600:         target = train_selection['selected_arm']
601:         source = next(row for row in rows if row['arm'] == target)
602:         alias = {'arm': 'train_selected_fixed', 'status': 'ALIAS' if source['status'] == 'MEASURED' else source['status'],
603:                  'reason': source['reason'], 'alias_of': target, 'summary': source['summary'],
604:                  'note': 'alias of a measured static fixed arm, not an independent algorithm'}
605:     rows.insert(2, alias)
606:     identity = next(iter(identities)) if identities else (None, None, None)
607:     return {'schema': SCHEMA + '-table', 'lineage': LINEAGE, 'qualification': QUALIFICATION, 'purpose': purpose,
608:             'claim_scope': CLAIM_SCOPE[purpose], 'offered_trace_sha256': identity[0], 'all_offered': identity[1],
609:             'envelope_scope': identity[2], 'rows': rows, 'fifo_label': FIFO_LABEL, 'fifo_note': FIFO_NOTE, 'claims_not_made': list(CLAIMS_NOT_MADE)}
610: 
