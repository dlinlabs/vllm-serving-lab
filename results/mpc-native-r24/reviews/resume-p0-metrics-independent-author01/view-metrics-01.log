1: """P0 nominal-lineage measured metrics: additive pure calculator plus a run_trace_pilot.py output adapter.
2: 
3: Scope: the UNQUALIFIED nominal demonstrator lineage r24-resume-p0-nominal-v1.  This is NOT the legacy L-T16
4: world: the legacy comparison16 scorer is neither modified nor reused, and no G06/G16/Native14 qualification is
5: inherited or claimed.  Only measured quantities are reported: no winner, capacity, SLO guarantee or production
6: claim.
7: 
8: * ``compute(run)`` -- pure core over strict normalized rows (``ROW_KEYS``); refuses, never repairs, bad input.
9: * ``adapt_run_trace_pilot(output_dir, arm=..., purpose=...)`` -- maps one run_trace_pilot.py output directory
10:   onto normalized rows with the exact field mapping in ``RAW_MAPPING``; refuses what the raw files cannot
11:   support (it never invents events, SLO fields or controller timings).
12: * ``select_train_fixed(...)`` -- Train-only empirical fixed16 vs fixed32 choice by unchanged natural-SLO count.
13: * ``comparison_table(...)`` -- one measured table per split, without any winner field.
14: 
15: Natural SLO uses the UNCHANGED r23 ``score_http.py`` (sha256 pinned; executed from verified bytes, no bytecode).
16: """
17: import argparse
18: import hashlib
19: import json
20: import math
21: from pathlib import Path
22: import sys
23: import types
24: 
25: SCHEMA = 'r24-resume-p0-nominal-metrics-v1'
26: LINEAGE = 'r24-resume-p0-nominal-v1'
27: QUALIFICATION = ('UNQUALIFIED nominal demonstrator: not the legacy L-T16 world; no G06/G16/Native14 qualification '
28:                  'inherited or claimed')
29: FATES = ('complete', 'rejected', 'http_error', 'stream_error', 'transport_error', 'cancelled', 'not_launched',
30:          'unknown')
31: FAILURE_FATES = ('http_error', 'stream_error', 'transport_error', 'cancelled')
32: PURPOSES = ('train', 'eval')
33: CLAIM_SCOPE = {
34:     'train': 'Train split: in-sample engineering measurement only; no generalization claim',
35:     'eval': 'Eval split: procedural holdout of synthetic draws from one public generator; not an OOD, real-trace or '
36:             'Azure holdout',
37: }
38: ARMS = ('fixed16', 'fixed32', 'train_selected_fixed', 'strong_one_move', 'mpc', 'causal_reactive')
39: RUN_ARMS = tuple(arm for arm in ARMS if arm != 'train_selected_fixed')
40: FIXED_BUDGETS = {'fixed16': 16.0, 'fixed32': 32.0}
41: QUANTILES = (50, 95, 99)
42: GROUP_EDGES = (512, 2048)
43: GROUPS = ('le512', '513to2048', 'gt2048')
44: FIFO_LABEL = 'PENDING_VERIFIED_BACKEND_FCFS_CONFIG'
45: FIFO_NOTE = ('FIFO is a queue ordering, not a fourth algorithm, and does not imply any budget; the label stays pending '
46:              'until the actual backend FCFS configuration is verified (never derived from a CPU plant)')
47: SCORE_HTTP_PATH = Path(__file__).resolve().parent.parent / 'native-r23' / 'score_http.py'
48: SCORE_HTTP_SHA256 = '9a173ab99e668534dfe18df9be0b9e8447e06a1a673f63aebb16b9ef5217081d'
49: ROW_KEYS = frozenset({'request_id', 'group_tokens', 'max_output_tokens', 'scheduled_at', 'sent_at',
50:                       'first_content_at', 'terminal_at', 'fate', 'completion_tokens', 'slo'})
51: SLO_KEYS = frozenset({'status', 'finish_reason', 'requested_ignore_eos', 'stream_done', 'stream_error'})
52: RUN_KEYS = frozenset({'arm', 'purpose', 'clock_domain', 'offered_start', 'offered_duration_s', 'envelope_start',
53:                       'envelope_end', 'envelope_scope', 'rows', 'slo_missing', 'control', 'control_missing',
54:                       'provenance'})
55: ENVELOPE_SCOPES = {
56:     'offered_cohort_observed': 'offered start to the later of offered end and last observed terminal; EXCLUDES pre-offer '
57:                                'setup/solver warmup, post-terminal drain and unresolved requests: a lower bound on the '
58:                                'full wall, not the full wall',
59:     'full_wall': 'caller-recorded actual wall in the run clock domain including setup, solver, HTTP, unresolved '
60:                  'requests and final drain',
61: }
62: PENALIZED_ESTIMAND = ('failure-penalized operational TTFT over ALL offered requests (missing first content = +inf); '
63:                       'NOT a survival-analysis identified quantile of right-censored latency')
64: CONDITIONAL_ESTIMAND = 'TTFT conditional on fate complete (selection-biased; read with fates and the penalized TTFT)'
65: COHORT_LABEL = ('cohort-normalized (includes tail): all-offered cohort count / offered window seconds; not steady-state '
66:                 'GPU throughput')
67: ENVELOPE_LABEL = 'actual wall envelope: count / (envelope_end - envelope_start)'
68: CLAIMS_NOT_MADE = (
69:     'no winner or superiority', 'no capacity, SLO guarantee or production claim',
70:     'no G06/G16/Native14 qualification', 'hashes are integrity pins, not Train/Eval disjointness or leakage proof',
71:     'FIFO label pending verified backend FCFS configuration',
72: )
73: 
74: 
75: class MetricsInputError(ValueError):
76:     """Normalized input violates the frozen schema: refused, never repaired."""
77: 
78: 
79: class AdapterRefusal(ValueError):
80:     """Raw run_trace_pilot output cannot support the normalized schema: refused, no events invented."""
81: 
82: 
83: _SCORE_HTTP = None
84: 
85: 
86: def score_http():
87:     """The unchanged r23 natural-SLO scorer, executed only from bytes matching the pinned sha256."""
88:     global _SCORE_HTTP
89:     if _SCORE_HTTP is None:
90:         data = SCORE_HTTP_PATH.read_bytes()
91:         if hashlib.sha256(data).hexdigest() != SCORE_HTTP_SHA256:
92:             raise RuntimeError('score_http.py differs from the pinned sha256; natural SLO scoring refused')
93:         module = types.ModuleType('r23_score_http_pinned')
94:         module.__file__ = str(SCORE_HTTP_PATH)
95:         exec(compile(data, str(SCORE_HTTP_PATH), 'exec'), module.__dict__)
96:         _SCORE_HTTP = module
97:     return _SCORE_HTTP
98: 
99: 
100: def _is_number(value):
101:     return type(value) in (int, float) and math.isfinite(value)
102: 
103: 
104: def _number(value, name):
105:     if not _is_number(value):
106:         raise MetricsInputError(f'{name} must be a finite int/float (bool refused)')
107:     return value
108: 
109: 
110: def _optional_number(value, name):
111:     return None if value is None else _number(value, name)
112: 
113: 
114: def _nonempty_str(value, name):
115:     if not isinstance(value, str) or not value:
116:         raise MetricsInputError(f'{name} must be a non-empty string')
117:     return value
118: 
119: 
120: def group_of(tokens):
121:     """Predeclared prompt-token groups (edges 512 and 2048 inclusive on the left group)."""
122:     if tokens <= GROUP_EDGES[0]:
123:         return GROUPS[0]
124:     return GROUPS[1] if tokens <= GROUP_EDGES[1] else GROUPS[2]
125: 
126: 
127: def percentile_block(values, estimand=None):
128:     """Nearest-rank ordered[ceil(q*n/100)-1] (integer rank arithmetic); a rank on +inf yields null with a reason."""
129:     ordered = sorted(values)
130:     n = len(ordered)
131:     block = {'n': n, 'method': 'nearest_rank_ceil'}
132:     if estimand is not None:
133:         block['estimand'] = estimand
134:     if not n:
135:         for q in QUANTILES:
136:             block.update({f'p{q}': None, f'p{q}_rank': None, f'p{q}_is_sample_max': None})
137:         block.update(max=None, n_failure_penalty=0, null_reason='no_samples')
138:         return block
139:     block['n_failure_penalty'] = sum(value == math.inf for value in ordered)
140:     for q in QUANTILES:
141:         rank = (q * n + 99) // 100
142:         value = ordered[rank - 1]
143:         block[f'p{q}'] = value if math.isfinite(value) else None
144:         block[f'p{q}_rank'] = rank
145:         block[f'p{q}_is_sample_max'] = rank == n
146:         if not math.isfinite(value):
147:             block[f'p{q}_null_reason'] = 'rank_falls_on_failure_penalty'
148:     block['max'] = ordered[-1] if math.isfinite(ordered[-1]) else None
149:     block['null_reason'] = None
150:     return block
151: 
152: 
153: def _validate_row(row, index):
154:     if not isinstance(row, dict) or set(row) != ROW_KEYS:
155:         raise MetricsInputError(f'row {index}: keys must be exactly {sorted(ROW_KEYS)}')
156:     name = f'row {index}'
157:     _nonempty_str(row['request_id'], f'{name} request_id')
158:     for key in ('group_tokens', 'max_output_tokens'):
159:         if type(row[key]) is not int or row[key] <= 0:
160:             raise MetricsInputError(f'{name} {key} must be a positive int')
161:     scheduled = _number(row['scheduled_at'], f'{name} scheduled_at')
162:     sent, first, terminal = (_optional_number(row[key], f'{name} {key}')
163:                              for key in ('sent_at', 'first_content_at', 'terminal_at'))
164:     fate = row['fate']
165:     if fate not in FATES:
166:         raise MetricsInputError(f'{name} fate must be one of {FATES}')
167:     tokens = row['completion_tokens']
168:     if tokens is not None and (type(tokens) is not int or tokens < 0):
169:         raise MetricsInputError(f'{name} completion_tokens must be null or an int >= 0')
170:     slo = row['slo']
171:     if slo is not None:
172:         if not isinstance(slo, dict) or set(slo) != SLO_KEYS:
173:             raise MetricsInputError(f'{name} slo keys must be exactly {sorted(SLO_KEYS)}')
174:         _nonempty_str(slo['status'], f'{name} slo.status')
175:         if slo['finish_reason'] is not None and not isinstance(slo['finish_reason'], str):
176:             raise MetricsInputError(f'{name} slo.finish_reason must be null or a string')
177:         if any(type(slo[key]) is not bool for key in ('requested_ignore_eos', 'stream_done', 'stream_error')):
178:             raise MetricsInputError(f'{name} slo flags must be bool')
179:         if (slo['status'] == 'complete') != (fate == 'complete'):
180:             raise MetricsInputError(f'{name} slo.status complete must coincide with fate complete')
181:     if first is not None and (sent is None or first < sent or first < scheduled):
182:         raise MetricsInputError(f'{name} clock order: first_content_at needs sent_at <= first and scheduled_at <= first')
183:     if terminal is not None and (sent is None or terminal < sent or (first is not None and terminal < first)):
184:         raise MetricsInputError(f'{name} clock order: terminal_at needs sent_at <= terminal and first <= terminal')
185:     if fate == 'not_launched' and not (sent is None and first is None and terminal is None and tokens is None):
186:         raise MetricsInputError(f'{name} not_launched carries no send/first/terminal/token observation')
187:     if fate == 'complete' and (sent is None or first is None or terminal is None):
188:         raise MetricsInputError(f'{name} complete requires sent_at, first_content_at and terminal_at')
189:     if fate in ('rejected',) + FAILURE_FATES and (sent is None or terminal is None):
190:         raise MetricsInputError(f'{name} {fate} requires sent_at and terminal_at')
191: 
192: 
193: def _validate_control(run):
194:     control, missing = run['control'], run['control_missing']
195:     if control is None:
196:         _nonempty_str(missing, 'control_missing (required when control is null)')
197:         if run['arm'] in FIXED_BUDGETS:
198:             raise MetricsInputError('fixed arms require a verified static_fixed control record')
199:         return
200:     if missing is not None:
201:         raise MetricsInputError('control_missing must be null when control is provided')
202:     if not isinstance(control, dict):
203:         raise MetricsInputError('control must be a dict')
204:     kind = control.get('kind')
205:     if kind == 'static_fixed':
206:         if set(control) != {'kind', 'budget', 'basis'}:
207:             raise MetricsInputError('static_fixed control keys must be exactly kind, budget, basis')
208:         _nonempty_str(control['basis'], 'control.basis')
209:         if run['arm'] not in FIXED_BUDGETS or control['budget'] != FIXED_BUDGETS[run['arm']] \
210:                 or type(control['budget']) is not float:
211:             raise MetricsInputError('static_fixed control must belong to fixed16/fixed32 with its exact float budget')
212:     elif kind == 'measured_intervals':
213:         if set(control) != {'kind', 'source', 'intervals'}:
214:             raise MetricsInputError('measured_intervals control keys must be exactly kind, source, intervals')
215:         if run['arm'] in FIXED_BUDGETS:
216:             raise MetricsInputError('fixed arms are static: no controller decision intervals')
217:         _nonempty_str(control['source'], 'control.source')
218:         if not isinstance(control['intervals'], list):
219:             raise MetricsInputError('control.intervals must be a list')
220:         for index, item in enumerate(control['intervals']):
221:             if not isinstance(item, list) or len(item) != 2:
222:                 raise MetricsInputError(f'control interval {index} must be [start, end]')
223:             start, end = (_number(value, f'control interval {index}') for value in item)
224:             if end < start:
225:                 raise MetricsInputError(f'control interval {index} ends before it starts')
226:     else:
227:         raise MetricsInputError('control.kind must be static_fixed or measured_intervals')
228: 
229: 
230: def validate_run(run):
231:     if not isinstance(run, dict) or set(run) != RUN_KEYS:
232:         raise MetricsInputError(f'run keys must be exactly {sorted(RUN_KEYS)}')
233:     if run['arm'] not in RUN_ARMS:
234:         raise MetricsInputError(f'run arm must be one of {RUN_ARMS} (train_selected_fixed is a table alias)')
235:     if run['purpose'] not in PURPOSES:
236:         raise MetricsInputError(f'purpose must be one of {PURPOSES}')
237:     _nonempty_str(run['clock_domain'], 'clock_domain')
238:     offered_start = _number(run['offered_start'], 'offered_start')
239:     duration = _number(run['offered_duration_s'], 'offered_duration_s')
240:     start, end = _number(run['envelope_start'], 'envelope_start'), _number(run['envelope_end'], 'envelope_end')
241:     if duration <= 0 or start > offered_start or end < offered_start + duration:
242:         raise MetricsInputError('envelope must cover [offered_start, offered_start + offered_duration_s] with '
243:                                 'positive duration')
244:     if run['envelope_scope'] not in ENVELOPE_SCOPES:
245:         raise MetricsInputError(f'envelope_scope must be one of {sorted(ENVELOPE_SCOPES)}')
246:     if not isinstance(run['rows'], list):
247:         raise MetricsInputError('rows must be a list')
248:     for index, row in enumerate(run['rows']):
249:         _validate_row(row, index)
250:     if len({row['request_id'] for row in run['rows']}) != len(run['rows']):
251:         raise MetricsInputError('request_id values must be unique (all-offered denominator)')
252:     missing = run['slo_missing']
253:     if missing is None:
254:         if any(row['slo'] is None for row in run['rows']):
255:             raise MetricsInputError('natural SLO fields must be present on every row or on none')
256:     else:
257:         if (not isinstance(missing, list) or not missing
258:                 or any(not isinstance(item, str) or not item for item in missing)):
259:             raise MetricsInputError('slo_missing must be null or a non-empty list of reasons')
260:         if any(row['slo'] is not None for row in run['rows']):
261:             raise MetricsInputError('natural SLO fields must be present on every row or on none')
262:     _validate_control(run)
263:     provenance = run['provenance']
264:     if not isinstance(provenance, dict):
265:         raise MetricsInputError('provenance must be a dict')
266:     _nonempty_str(provenance.get('offered_trace_sha256'), 'provenance.offered_trace_sha256')
267: 
268: 
269: def _rate(count, total):
270:     return count / total if total else None
271: 
272: 
273: def _fate_summary(rows):
274:     fates = {fate: 0 for fate in FATES}
275:     for row in rows:
276:         fates[row['fate']] += 1
277:     total = len(rows)
278:     failures = sum(fates[fate] for fate in FAILURE_FATES)
279:     return {
280:         'n_offered': total, 'fates': fates, 'delivered': fates['complete'], 'failures': failures,
281:         'rejection_rate': _rate(fates['rejected'], total), 'failure_rate': _rate(failures, total),
282:         'not_launched_rate': _rate(fates['not_launched'], total), 'unknown_rate': _rate(fates['unknown'], total),
283:         'delivered_fraction': _rate(fates['complete'], total),
284:     }
285: 
286: 
287: def _penalized(rows, origin):
288:     return [row['first_content_at'] - row[origin] if row['first_content_at'] is not None else math.inf
289:             for row in rows]
290: 
291: 
292: def _ttft(rows):
293:     complete = [row for row in rows if row['fate'] == 'complete']
294:     return {
295:         'conditional_scheduled': percentile_block(
296:             [row['first_content_at'] - row['scheduled_at'] for row in complete], CONDITIONAL_ESTIMAND),
297:         'conditional_client_send': percentile_block(
298:             [row['first_content_at'] - row['sent_at'] for row in complete], CONDITIONAL_ESTIMAND),
299:         'all_offered_penalized_scheduled': percentile_block(_penalized(rows, 'scheduled_at'), PENALIZED_ESTIMAND),
300:         'all_offered_penalized_client_send': percentile_block(_penalized(rows, 'sent_at'), PENALIZED_ESTIMAND),
301:     }
302: 
303: 
304: def _natural_slo(run):
305:     if run['slo_missing'] is not None:
306:         return {
307:             'available': False, 'null_reason': 'natural_slo_fields_unavailable', 'missing': list(run['slo_missing']),
308:             'substitution': 'none: no TTFT-only or client --ttft-slo substitute', 'natural_slo_good': None,
309:             'slo_attainment_fraction': None, 'cohort_slo_goodput_rps': None, 'in_window_slo_goodput_rps': None,
310:             'wall_envelope_slo_goodput_rps': None,
311:         }, None
312:     module = score_http()
313:     rows = [{
314:         'status': row['slo']['status'], 'finish_reason': row['slo']['finish_reason'],
315:         'requested_ignore_eos': row['slo']['requested_ignore_eos'], 'stream_done': row['slo']['stream_done'],
316:         'stream_error': row['slo']['stream_error'],
317:         'usage': None if row['completion_tokens'] is None else {'completion_tokens': row['completion_tokens']},
318:         'scheduled_at': row['scheduled_at'], 'first_content_at': row['first_content_at'],
319:         'terminal_at': row['terminal_at'],
320:     } for row in run['rows']]
321:     scored = module.score(rows, run['offered_duration_s'], offered_start=run['offered_start'],
322:                           accounting_started_at=run['envelope_start'], accounting_finished_at=run['envelope_end'])
323:     return {
324:         'available': True, 'null_reason': None, 'rule': scored['rule'], 'score_http_sha256': SCORE_HTTP_SHA256,
325:         'all_offered': scored['all_offered'], 'natural_slo_good': scored['natural_slo_good'],
326:         'slo_attainment_fraction': scored['all_offered_good_fraction'],
327:         'slo_attainment_fraction_unit': 'dimensionless: natural_slo_good / all_offered',
328:         'cohort_slo_goodput_rps': scored['cohort_slo_goodput_rps'], 'cohort_slo_goodput_label': COHORT_LABEL,
329:         'in_window_slo_goodput_rps': scored['in_window_slo_goodput_rps'],
330:         'wall_envelope_slo_goodput_rps': scored['policy_and_tail_wall_slo_goodput_rps'],
331:         'wall_envelope_label': ENVELOPE_LABEL, 'wall_envelope_scope': run['envelope_scope'],
332:         'wall_envelope_s': scored['policy_and_tail_wall_s'],
333:         'after_offer_tail_and_accounting_s': scored['after_offer_tail_and_accounting_s'],
334:         'statuses': scored['statuses'], 'finish_reasons': scored['finish_reasons'],
335:         'censored_cap_completions': scored['censored_cap_completions'],
336:         'one_token_complete': scored['one_token_complete'],
337:     }, [module.natural_good(row) for row in rows]
338: 
339: 
340: def _throughput(run, rows, envelope_s):
341:     duration = run['offered_duration_s']
342:     delivered = [row for row in rows if row['fate'] == 'complete']
343:     missing = [row for row in delivered if row['completion_tokens'] is None]
344:     observed = sum(row['completion_tokens'] for row in delivered if row['completion_tokens'] is not None)
345:     upper = observed + sum(row['max_output_tokens'] for row in missing)
346: 
347:     def per_second(window):
348:         return {'lower': observed / window, 'upper': upper / window, 'exact': not missing}
349: 
350:     return {
351:         'delivered_definition': 'fate complete (client success; includes length-capped completions)',
352:         'delivered': len(delivered), 'offered_rps': len(rows) / duration,
353:         'cohort_normalized_delivered_rps': len(delivered) / duration, 'cohort_label': COHORT_LABEL,
354:         'wall_envelope_delivered_rps': len(delivered) / envelope_s, 'wall_envelope_label': ENVELOPE_LABEL,
355:         'wall_envelope_scope': run['envelope_scope'],
356:         'completion_tokens_observed': observed, 'completion_tokens_missing_usage_rows': len(missing),
357:         'completion_tokens_upper_bound': upper,
358:         'bounds_rule': 'lower = observed endpoint usage; upper adds max_output_tokens per delivered row lacking usage; '
359:                        'no chunk-count or max_tokens substitution as a point value',
360:         'cohort_normalized_completion_tokens_per_s': per_second(duration),
361:         'wall_envelope_completion_tokens_per_s': per_second(envelope_s),
362:         'undelivered_reported_completion_tokens': sum(row['completion_tokens'] for row in rows
363:                                                       if row['fate'] != 'complete'
364:                                                       and row['completion_tokens'] is not None),
365:     }
366: 
367: 
368: def _groups(rows, good):
369:     result = {}
370:     for name in GROUPS:
371:         members = [index for index, row in enumerate(rows) if group_of(row['group_tokens']) == name]
372:         member_rows = [rows[index] for index in members]
373:         summary = _fate_summary(member_rows)
374:         count = None if good is None else sum(good[index] for index in members)
375:         summary.update(
376:             natural_slo_good=count,
377:             slo_attainment_fraction=None if good is None else _rate(count, len(members)),
378:             ttft_conditional_scheduled=percentile_block(
379:                 [row['first_content_at'] - row['scheduled_at'] for row in member_rows if row['fate'] == 'complete'],
380:                 CONDITIONAL_ESTIMAND),
381:             ttft_all_offered_penalized_scheduled=percentile_block(_penalized(member_rows, 'scheduled_at'),
382:                                                                   PENALIZED_ESTIMAND))
383:         result[name] = summary
384:     return result
385: 
386: 
387: def _spread(groups, key):
388:     used = [name for name in GROUPS if groups[name]['n_offered']]
389:     out = {'metric': key, 'groups_used': used, 'k': len(used), 'worst_min': None, 'best_max': None, 'gap': None,
390:            'min_over_max': None, 'jain': None}
391:     if len(used) < 2:
392:         return dict(out, null_reason='fewer_than_two_nonempty_groups')
393:     values = [groups[name][key] for name in used]
394:     if any(value is None for value in values):
395:         return dict(out, null_reason='metric_unavailable')
396:     total, low, high = sum(values), min(values), max(values)
397:     out.update(worst_min=low, best_max=high, gap=high - low, min_over_max=low / high if high else None,
398:                jain=total * total / (len(values) * sum(value * value for value in values)) if total else None,
399:                null_reason=None if total else 'all_zero: jain and min_over_max undefined')
400:     return out
401: 
402: 
403: def _fairness(groups):
404:     used = [name for name in GROUPS if groups[name]['n_offered']]
405:     rejection = {name: groups[name]['rejection_rate'] for name in used}
406:     ttft = {name: groups[name]['ttft_conditional_scheduled'] for name in used}
407:     numeric = {name: block['p95'] for name, block in ttft.items() if block['p95'] is not None}
408:     worst = max(numeric, key=numeric.get) if numeric else None
409:     return {
410:         'scope': 'descriptive across predeclared prompt-token groups; no starvation or fairness guarantee',
411:         'slo_attainment_fraction': _spread(groups, 'slo_attainment_fraction'),
412:         'delivered_fraction': _spread(groups, 'delivered_fraction'),
413:         'worst_group_rejection_rate': max(rejection.values()) if rejection else None,
414:         'worst_group_ttft_conditional_scheduled_p95': None if worst is None else numeric[worst],
415:         'worst_group_ttft_conditional_scheduled_p95_group': worst,
416:         'worst_group_ttft_conditional_scheduled_p95_n': None if worst is None else ttft[worst]['n'],
417:         'groups_without_conditional_p95': [name for name in used if name not in numeric],
418:     }
419: 
420: 
421: def _union(intervals):
422:     total, current = 0.0, None
423:     for start, end in sorted(intervals):
424:         if current is None or start > current[1]:
425:             if current is not None:
426:                 total += current[1] - current[0]
427:             current = [start, end]
428:         else:
429:             current[1] = max(current[1], end)
430:     return total + (current[1] - current[0] if current is not None else 0.0)
431: 
432: 
433: def _overhead(run, envelope_s):
434:     control = run['control']
435:     scope = 'separate from TTFT/E2E/goodput (never added to request latencies); no fabricated solver cost'
436:     if control is None:
437:         return {'available': False, 'null_reason': run['control_missing'], 'decisions': None, 'union_total_s': None,
438:                 'union_within_envelope_s': None, 'union_fraction_of_envelope': None, 'durations_s': None,
439:                 'scope': scope}
440:     if control['kind'] == 'static_fixed':
441:         return {'available': True, 'kind': 'static_fixed', 'budget': control['budget'], 'basis': control['basis'],
442:                 'decisions': 0, 'union_total_s': 0.0, 'union_within_envelope_s': 0.0,
443:                 'union_fraction_of_envelope': 0.0, 'durations_s': percentile_block([]), 'scope': scope}
444:     intervals = [tuple(item) for item in control['intervals']]
445:     clipped = [(max(start, run['envelope_start']), min(end, run['envelope_end'])) for start, end in intervals]
446:     within = _union([item for item in clipped if item[0] <= item[1]])
447:     return {'available': True, 'kind': 'measured_intervals', 'source': control['source'],
448:             'decisions': len(intervals), 'union_total_s': _union(intervals), 'union_within_envelope_s': within,
449:             'union_fraction_of_envelope': within / envelope_s,
450:             'durations_s': percentile_block([end - start for start, end in intervals]), 'scope': scope}
451: 
452: 
453: def compute(run):
454:     """Measured metrics for one arm on one offered cohort (strict normalized input)."""
455:     validate_run(run)
456:     rows = run['rows']
457:     envelope_s = run['envelope_end'] - run['envelope_start']
458:     natural, good = _natural_slo(run)
459:     groups = _groups(rows, good)
460:     sent = [row['sent_at'] - row['scheduled_at'] for row in rows if row['sent_at'] is not None]
461:     return {
462:         'schema': SCHEMA, 'lineage': LINEAGE, 'qualification': QUALIFICATION, 'arm': run['arm'],
463:         'purpose': run['purpose'], 'claim_scope': CLAIM_SCOPE[run['purpose']], 'clock_domain': run['clock_domain'],
464:         'offered_trace_sha256': run['provenance']['offered_trace_sha256'],
465:         'windows': {'offered_start': run['offered_start'], 'offered_duration_s': run['offered_duration_s'],
466:                     'offered_end': run['offered_start'] + run['offered_duration_s'],
467:                     'envelope_start': run['envelope_start'], 'envelope_end': run['envelope_end'],
468:                     'envelope_s': envelope_s, 'envelope_scope': run['envelope_scope'],
469:                     'envelope_scope_label': ENVELOPE_SCOPES[run['envelope_scope']],
470:                     'full_wall_s': envelope_s if run['envelope_scope'] == 'full_wall' else None,
471:                     'full_wall_null_reason': None if run['envelope_scope'] == 'full_wall' else
472:                     'full wall not recorded: wall-envelope rates use the offered-cohort observed envelope'},
473:         'all_offered': len(rows), 'outcomes': _fate_summary(rows), 'ttft_s': _ttft(rows),
474:         'send_lag_s': dict(percentile_block(sent, 'sent_at - scheduled_at over sent rows'),
475:                            n_not_sent=len(rows) - len(sent)),
476:         'natural_slo': natural, 'throughput': _throughput(run, rows, envelope_s), 'groups': groups,
477:         'group_edges': {'le512': '<=512', '513to2048': '513..2048', 'gt2048': '>2048',
478:                         'key': 'group_tokens (tokenizer-measured prompt tokens frozen before outcomes)'},
479:         'fairness': _fairness(groups), 'controller_overhead': _overhead(run, envelope_s),
480:         'fifo_label': FIFO_LABEL, 'fifo_note': FIFO_NOTE, 'provenance': run['provenance'],
481:         'claims_not_made': list(CLAIMS_NOT_MADE),
482:     }
483: 
484: 
485: def select_train_fixed(results):
486:     """Empirical Train-only fixed16 vs fixed32 choice, frozen before any Eval replay.
487: 
488:     Primary: more natural-SLO good completions (equal offered cohort, so identical to cohort goodput order);
489:     tie 1: fewer not-delivered offered requests; tie 2: lower budget.  Refusals are returned, not raised.
490:     """
491:     rule = {'primary': 'natural_slo_good (higher)', 'tie_1': 'all_offered - delivered (lower)',
492:             'tie_2': 'budget (lower)', 'not': 'nominal forecast freeze_fixed', 'data': 'Train split only'}
493: 
494:     def refused(reason):
495:         return {'status': 'REFUSED', 'reason': reason, 'rule': rule}
496: 
497:     if not isinstance(results, dict) or set(results) != set(FIXED_BUDGETS):
498:         return refused('exactly fixed16 and fixed32 Train measurements are required')
499:     for arm, metrics in results.items():
500:         if not isinstance(metrics, dict) or metrics.get('schema') != SCHEMA or metrics.get('arm') != arm:
501:             return refused(f'{arm}: not a {SCHEMA} result for this arm')
502:         if metrics['purpose'] != 'train':
503:             return refused(f'{arm}: purpose {metrics["purpose"]!r}; selection uses Train only')
504:         overhead = metrics['controller_overhead']
505:         if overhead.get('kind') != 'static_fixed' or overhead.get('budget') != FIXED_BUDGETS[arm]:
506:             return refused(f'{arm}: not a verified static fixed runtime')
507:         if not metrics['natural_slo']['available']:
508:             return refused(f'{arm}: natural SLO unavailable ({metrics["natural_slo"]["missing"]}); no TTFT-only '
509:                            'substitute')
510:     if len({metrics['offered_trace_sha256'] for metrics in results.values()}) != 1 \
511:             or len({metrics['all_offered'] for metrics in results.values()}) != 1:
512:         return refused('fixed16 and fixed32 were not measured on the identical offered Train trace')
513:     candidates = {arm: {'budget': FIXED_BUDGETS[arm], 'natural_slo_good': metrics['natural_slo']['natural_slo_good'],
514:                         'cohort_slo_goodput_rps': metrics['natural_slo']['cohort_slo_goodput_rps'],
515:                         'not_delivered': metrics['all_offered'] - metrics['outcomes']['delivered']}
516:                   for arm, metrics in results.items()}
517:     a, b = (candidates[arm] for arm in ('fixed16', 'fixed32'))
518:     decided_by = ('primary_natural_slo_good' if a['natural_slo_good'] != b['natural_slo_good'] else
519:                   'tie_1_fewer_not_delivered' if a['not_delivered'] != b['not_delivered'] else 'tie_2_lower_budget')
520:     selected = min(candidates, key=lambda arm: (-candidates[arm]['natural_slo_good'],
521:                                                 candidates[arm]['not_delivered'], candidates[arm]['budget']))
522:     return {'status': 'SELECTED', 'selected_arm': selected, 'selected_budget': FIXED_BUDGETS[selected],
523:             'decided_by': decided_by, 'rule': rule, 'candidates': candidates,
524:             'offered_trace_sha256': results['fixed16']['offered_trace_sha256'],
525:             'scope': 'Train in-sample selection; must be frozen before any Eval replay; not a performance claim'}
526: 
527: 
528: def summarize(metrics):
529:     ttft = metrics['ttft_s']
530: 
531:     def q(block):
532:         return {key: block[key] for key in ('n', 'p50', 'p95', 'p99', 'p95_is_sample_max', 'p99_is_sample_max',
533:                                             'n_failure_penalty')}
534: 
535:     natural, throughput, overhead = metrics['natural_slo'], metrics['throughput'], metrics['controller_overhead']
536:     return {
537:         'all_offered': metrics['all_offered'], 'envelope_scope': metrics['windows']['envelope_scope'],
538:         'fates': metrics['outcomes']['fates'],
539:         'rejection_rate': metrics['outcomes']['rejection_rate'], 'failure_rate': metrics['outcomes']['failure_rate'],
540:         'not_launched_rate': metrics['outcomes']['not_launched_rate'],
541:         'unknown_rate': metrics['outcomes']['unknown_rate'],
542:         'ttft_conditional_scheduled': q(ttft['conditional_scheduled']),
543:         'ttft_conditional_client_send': q(ttft['conditional_client_send']),
544:         'ttft_all_offered_penalized_scheduled': q(ttft['all_offered_penalized_scheduled']),
545:         'ttft_all_offered_penalized_client_send': q(ttft['all_offered_penalized_client_send']),
546:         'natural_slo_available': natural['available'], 'natural_slo_null_reason': natural['null_reason'],
547:         'natural_slo_good': natural['natural_slo_good'], 'slo_attainment_fraction': natural['slo_attainment_fraction'],
548:         'cohort_slo_goodput_rps': natural['cohort_slo_goodput_rps'],
549:         'wall_envelope_slo_goodput_rps': natural['wall_envelope_slo_goodput_rps'],
550:         'cohort_normalized_delivered_rps': throughput['cohort_normalized_delivered_rps'],
551:         'wall_envelope_delivered_rps': throughput['wall_envelope_delivered_rps'],
552:         'cohort_normalized_completion_tokens_per_s': throughput['cohort_normalized_completion_tokens_per_s'],
553:         'wall_envelope_completion_tokens_per_s': throughput['wall_envelope_completion_tokens_per_s'],
554:         'jain_slo_attainment': metrics['fairness']['slo_attainment_fraction']['jain'],
555:         'jain_delivered_fraction': metrics['fairness']['delivered_fraction']['jain'],
556:         'controller_decisions': overhead['decisions'], 'controller_union_within_envelope_s':
557:             overhead['union_within_envelope_s'], 'controller_overhead_null_reason': overhead.get('null_reason'),
558:     }
559: 
