687: def _strict_json(data, name):
688:     def pairs(items):
689:         keys = [key for key, _ in items]
690:         if len(keys) != len(set(keys)):
691:             raise AdapterRefusal(f'{name}: duplicate JSON object key')
692:         return dict(items)
693: 
694:     def constant(token):
695:         raise AdapterRefusal(f'{name}: non-finite JSON constant {token}')
696: 
697:     try:
698:         return json.loads(data, object_pairs_hook=pairs, parse_constant=constant)
699:     except AdapterRefusal:
700:         raise
701:     except ValueError as exc:
702:         raise AdapterRefusal(f'{name}: not JSON') from exc
703: 
704: 
705: def _raw_number(value, name, optional=True):
706:     if value is None and optional:
707:         return None
708:     if not _is_number(value):
709:         raise AdapterRefusal(f'{name} must be a finite number')
710:     return value
711: 
712: 
713: def _map_row(raw, request, start, index):
714:     name = f'client row {index}'
715:     if not isinstance(raw, dict):
716:         raise AdapterRefusal(f'{name}: not an object')
717:     if raw.get('trace_id') != request['trace_id']:
718:         raise AdapterRefusal(f'{name}: trace_id differs from trace order')
719:     if type(raw.get('expected_input_tokens')) is not int or raw['expected_input_tokens'] != request['input_tokens']:
720:         raise AdapterRefusal(f'{name}: expected_input_tokens differs from the trace')
721:     if raw.get('max_output_tokens') != request['max_tokens']:
722:         raise AdapterRefusal(f'{name}: max_output_tokens differs from the trace')
723:     scheduled = _raw_number(raw.get('scheduled_at'), f'{name} scheduled_at', optional=False)
724:     if abs(scheduled - (start + request['arrival_seconds'])) > 1e-6:
725:         raise AdapterRefusal(f'{name}: scheduled_at is not measurement_start + arrival_seconds')
726:     keys = set(raw)
727:     sent = first = terminal = tokens = None
728:     if keys == PLACEHOLDER_KEYS:
729:         if raw['error_type'] != 'NotLaunched' or raw['success'] is not False or raw['rejected'] is not False:
730:             raise AdapterRefusal(f'{name}: placeholder row is not a NotLaunched record')
731:         pristine = (raw['error_message'] == NOT_LAUNCHED_MESSAGE and raw['stream_complete'] is False and
732:                     all(raw[key] is None for key in ('request_id', 'started_at', 'first_content_at', 'finished_at',
733:                                                      'status', 'ttft', 'end_to_end', 'input_tokens', 'output_tokens')))
734:         fate = 'not_launched' if pristine else 'unknown'
735:     elif keys == LAUNCHED_KEYS:
736:         sent, first, terminal = (_raw_number(raw[key], f'{name} {key}')
737:                                  for key in ('started_at', 'first_content_at', 'finished_at'))
738:         ttft = _raw_number(raw['ttft'], f'{name} ttft')
739:         if (ttft is None) != (first is None) or (ttft is not None and (sent is None or abs(ttft - (first - sent)) > 1e-9)):
740:             raise AdapterRefusal(f'{name}: ttft is not first_content_at - started_at')
741:         tokens = raw['output_tokens']
742:         if tokens is not None and (type(tokens) is not int or tokens < 0):
743:             raise AdapterRefusal(f'{name}: output_tokens must be null or an int >= 0')
744:         if type(raw['success']) is not bool or type(raw['rejected']) is not bool:
745:             raise AdapterRefusal(f'{name}: success/rejected must be bool')
746:         error_type = raw['error_type']
747:         if raw['success']:
748:             if raw['rejected'] or error_type is not None or raw['stream_complete'] is not True:
749:                 raise AdapterRefusal(f'{name}: inconsistent success record')
750:             fate = 'complete'
751:         elif raw['rejected']:
752:             if error_type is not None or raw['status'] != 503:
753:                 raise AdapterRefusal(f'{name}: inconsistent rejection record')
754:             fate = 'rejected'
755:         elif error_type == 'CancelledError':
756:             fate = 'cancelled'
757:         elif error_type == 'HTTPStatusError':
758:             fate = 'http_error'
759:         elif error_type in STREAM_ERROR_TYPES:
760:             fate = 'stream_error'
761:         elif isinstance(error_type, str) and error_type and error_type != 'NotLaunched':
762:             fate = 'transport_error'
763:         else:
764:             fate = 'unknown'
765:     else:
766:         raise AdapterRefusal(f'{name}: raw schema drift (missing {sorted(LAUNCHED_KEYS - keys)}, '
767:                              f'extra {sorted(keys - LAUNCHED_KEYS)})')
768:     return {'request_id': raw['trace_id'], 'group_tokens': raw['expected_input_tokens'],
769:             'max_output_tokens': raw['max_output_tokens'], 'scheduled_at': scheduled, 'sent_at': sent,
770:             'first_content_at': first, 'terminal_at': terminal, 'fate': fate, 'completion_tokens': tokens,
771:             'slo': None}
772: 
773: 
774: def _static_control(manifest, config, changes, start, arm):
775:     budget = FIXED_BUDGETS[arm]
776:     if config.get('budget_schedule') is not None:
777:         raise AdapterRefusal(f'{arm}: fixed arm must use --budget, not a --budget-schedule')
778:     if type(config.get('budget')) not in (int, float) or float(config['budget']) != budget:
779:         raise AdapterRefusal(f'{arm}: config budget {config.get("budget")!r} != {budget}')
780:     if not isinstance(changes, list) or len(changes) != 1 or not isinstance(changes[0], dict):
781:         raise AdapterRefusal(f'{arm}: static run needs exactly one budget actuation record')
782:     record = changes[0]
783:     sent = _raw_number(record.get('sent'), 'budget record sent', optional=False)
784:     acknowledged = _raw_number(record.get('acknowledged'), 'budget record acknowledged', optional=False)
785:     if not sent <= acknowledged < start or record.get('target') != start:
786:         raise AdapterRefusal(f'{arm}: budget not acknowledged before measurement_start')
787:     if record.get('status', 'acknowledged') != 'acknowledged' or record.get('requested_budget', budget) != budget:
788:         raise AdapterRefusal(f'{arm}: budget actuation record is not an acknowledged {budget} installation')
789:     launch = manifest.get('gateway_launch')
790:     settings = launch.get('settings') if isinstance(launch, dict) else None
791:     if not isinstance(settings, dict) or settings.get('ADMISSION_MODE') != 'cost_aware' \
792:             or settings.get('MAX_ADMITTED_COST') != str(float(config['budget'])):
793:         raise AdapterRefusal(f'{arm}: gateway launch settings do not show cost_aware admission at budget {budget}')
794:     return {'kind': 'static_fixed', 'budget': budget,
795:             'basis': 'static_budget_installed_before_offered_start_verified: config --budget, gateway launch '
796:                      'MAX_ADMITTED_COST and one acknowledged actuation before measurement_start'}
797: 
798: 
799: def _model_fidelity(manifest, trace):
800:     model = trace.get('model')
801:     if not isinstance(model, str) or not model.startswith('/'):
802:         raise AdapterRefusal(f'trace model {model!r}: protocol requires the absolute local model path (a repo id '
803:                              'MODEL_NAME can silently use the gateway character fallback)')
804:     launch = manifest.get('gateway_launch')
805:     settings = launch.get('settings') if isinstance(launch, dict) else None
806:     if not isinstance(settings, dict) or settings.get('MODEL_NAME') != model:
807:         raise AdapterRefusal('gateway launch MODEL_NAME differs from the trace model')
808:     initial = manifest.get('initial_metrics')
809:     if not isinstance(initial, dict) or initial.get('tokenizer_available') is not True:
810:         raise AdapterRefusal('gateway initial metrics do not show tokenizer_available true')
811: 
812: 
813: def adapt_run_trace_pilot(output_dir, *, arm, purpose):
814:     """Normalized run for one static fixed arm from a run_trace_pilot.py output directory (see RAW_MAPPING)."""
815:     if arm not in FIXED_BUDGETS:
816:         raise AdapterRefusal(f'{arm!r}: run_trace_pilot hosts only static --budget or a predeclared open-loop '
817:                              '--budget-schedule with a process-internal admin key, so closed-loop arms need the '
818:                              'coordinator journal; this adapter maps fixed16/fixed32 only')
819:     if purpose not in PURPOSES:
820:         raise AdapterRefusal(f'purpose must be one of {PURPOSES}')
821:     out = Path(output_dir)
822:     data, parsed = {}, {}
823:     for name in RAW_FILES:
824:         try:
825:             data[name] = (out / name).read_bytes()
826:         except OSError as exc:
827:             raise AdapterRefusal(f'{name}: unreadable ({type(exc).__name__})') from exc
828:         parsed[name] = _strict_json(data[name], name)
829:     manifest, client, trace, changes = (parsed[name] for name in RAW_FILES)
830:     if not isinstance(manifest, dict) or manifest.get('schema_version') != 1:
831:         raise AdapterRefusal('manifest.json: schema_version must be 1')
832:     if manifest.get('status') != 'collected':
833:         raise AdapterRefusal(f'manifest status {manifest.get("status")!r} != collected '
834:                              f'(error {manifest.get("error")!r}); failed captures are refused, not rescored')
835:     config = manifest.get('config')
836:     if not isinstance(config, dict):
837:         raise AdapterRefusal('manifest.json: config missing')
838:     if hashlib.sha256(data['trace.json']).hexdigest() != manifest.get('trace_sha256'):
839:         raise AdapterRefusal('trace.json sha256 differs from manifest.trace_sha256')
840:     if not isinstance(trace, dict) or trace.get('schema_version') != 1 or not isinstance(trace.get('requests'), list) \
841:             or not trace['requests'] or not _is_number(trace.get('duration_seconds')):
842:         raise AdapterRefusal('trace.json: not a schema_version 1 replay trace')
843:     for index, request in enumerate(trace['requests']):
844:         if not isinstance(request, dict) or set(request) != TRACE_REQUEST_KEYS \
845:                 or not _is_number(request['arrival_seconds']) or type(request['input_tokens']) is not int \
846:                 or type(request['max_tokens']) is not int:
847:             raise AdapterRefusal(f'trace request {index}: not a schema_version 1 request')
848:     provenance = trace.get('provenance')
849:     if not isinstance(provenance, dict) or provenance.get('offered_tape_schema') != OFFERED_TAPE_SCHEMA:
850:         raise AdapterRefusal(f'trace.json: provenance is not a nominal {OFFERED_TAPE_SCHEMA} replay')
851:     if provenance.get('purpose') != purpose:
852:         raise AdapterRefusal(f'trace provenance purpose {provenance.get("purpose")!r} != declared {purpose!r}')
853:     if config.get('cache_policy') != 'disabled':
854:         raise AdapterRefusal(f'cache_policy {config.get("cache_policy")!r}: protocol requires disabled')
855:     _model_fidelity(manifest, trace)
856:     start = _raw_number(manifest.get('measurement_start'), 'measurement_start', optional=False)
857:     end = _raw_number(manifest.get('measurement_end'), 'measurement_end', optional=False)
858:     if abs((end - start) - trace['duration_seconds']) > 1e-6:
859:         raise AdapterRefusal('measurement window differs from the trace duration')
860:     if not isinstance(client, dict) or set(client) != {'requests'} or not isinstance(client['requests'], list) \
861:             or len(client['requests']) != len(trace['requests']):
862:         raise AdapterRefusal('client.json: request rows do not cover the offered trace one-to-one')
863:     rows = [_map_row(raw, request, start, index)
864:             for index, (raw, request) in enumerate(zip(client['requests'], trace['requests']))]
865:     control = _static_control(manifest, config, changes, start, arm)
866:     error_types = {}
867:     for raw in client['requests']:
868:         error_types[str(raw['error_type'])] = error_types.get(str(raw['error_type']), 0) + 1
869:     run = {
870:         'arm': arm, 'purpose': purpose, 'clock_domain': 'run_trace_pilot runner time.monotonic()',
871:         'offered_start': start, 'offered_duration_s': trace['duration_seconds'], 'envelope_start': start,
872:         'envelope_end': max([end] + [row['terminal_at'] for row in rows if row['terminal_at'] is not None]),
873:         'envelope_scope': 'offered_cohort_observed', 'rows': rows, 'slo_missing': list(SLO_MISSING_RUN_TRACE_PILOT), 'control': control, 'control_missing': None,
874:         'provenance': {
875:             'source': 'run_trace_pilot.py output directory', 'output_dir': str(out),
876:             'raw_file_sha256': {name: hashlib.sha256(data[name]).hexdigest() for name in RAW_FILES},
877:             'offered_trace_sha256': manifest['trace_sha256'],
878:             'offered_tape': {key: provenance.get(key) for key in TAPE_PRESERVED},
879:             'manifest': {key: manifest.get(key) for key in MANIFEST_PRESERVED},
880:             'raw_error_type_counts': error_types,
881:             'client_config_slo_not_used': {'ttft_slo': config.get('ttft_slo'), 'e2e_slo': config.get('e2e_slo')},
882:             'mapping': RAW_MAPPING, 'qualifiers': list(ADAPTER_QUALIFIERS),
883:         },
884:     }
885:     try:
886:         validate_run(run)
887:     except MetricsInputError as exc:
888:         raise AdapterRefusal(f'normalized run invalid: {exc}') from exc
889:     return run
890: 
891: 
892: def main(argv=None):
893:     parser = argparse.ArgumentParser(description='Measured P0 nominal metrics for one static fixed run_trace_pilot '
894:                                                  'output directory (no winner, no qualification).',
895:                                      allow_abbrev=False)
896:     parser.add_argument('--output-dir', required=True)
897:     parser.add_argument('--arm', required=True, choices=sorted(FIXED_BUDGETS))
898:     parser.add_argument('--purpose', required=True, choices=PURPOSES)
899:     args = parser.parse_args(argv)
900:     try:
901:         metrics = compute(adapt_run_trace_pilot(args.output_dir, arm=args.arm, purpose=args.purpose))
902:     except (AdapterRefusal, MetricsInputError) as exc:
903:         print(json.dumps({'status': 'REFUSED', 'error': f'{type(exc).__name__}: {exc}'}, sort_keys=True),
904:               file=sys.stderr)
905:         return 1
906:     print(json.dumps(metrics, sort_keys=True, indent=1, allow_nan=False))
907:     return 0
908: 
909: 
910: if __name__ == '__main__':
911:     sys.exit(main())
