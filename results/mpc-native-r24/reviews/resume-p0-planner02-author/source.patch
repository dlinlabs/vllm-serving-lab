+    def model_fixed_reference(self):
+        snapshot, source, window, _, kwargs = self.case(
+            offers=(FutureOffer("good", 0.2, 0, 3300, 1),), purpose="train",
+        )
+        panel = self.planner.evaluate(snapshot, source, window, **kwargs)
+        return self.planner.freeze_fixed((panel,))
+
+    def test_fixed_timing_ignores_future_solver_start_without_backdating(self):
+        choice = self.model_fixed_reference()
+        snapshot, _, window, _, kwargs = self.case()
+        now = window.entered_at + 0.02
+        with patch.object(n, "rollout", side_effect=AssertionError("Fixed must not solve")) as forecast:
+            decision = self.planner.fixed_action(
+                snapshot, choice, window, clock=lambda: now, **kwargs,
+            )
+        forecast.assert_not_called()
+        self.receipt(
+            "fixed-timing-future-start", applicable_offset=decision.first_action.not_before - snapshot.sampled_at,
+            current_offset=now - snapshot.sampled_at,
+            solver_first_offset=window.first_action_at - snapshot.sampled_at,
+            runtime_rollout_calls=forecast.call_count,
+        )
+        self.assertEqual(decision.first_action.not_before, now)
+        self.assertEqual(decision.plan.first_action_at, now)
+        self.assertLess(decision.first_action.not_before, window.first_action_at)
+        self.assertEqual(decision.first_action.not_after, window.action_deadline)
+        prefix = now - snapshot.sampled_at
+        self.assertEqual(decision.plan.budget_at(prefix - 0.001), snapshot.budget)
+        self.assertEqual(decision.plan.budget_at(prefix), choice.budget)
+
+    def test_fixed_timing_survives_elapsed_solver_deadline_with_fresh_state(self):
+        choice = self.model_fixed_reference()
+        snapshot, source, window, _, kwargs = self.case()
+        now = window.entered_at + 0.15
+        snapshot = replace(snapshot, sampled_at=now - 0.01)
+        self.assertGreater(now, window.solve_deadline)
+        self.assertLess(now, window.action_deadline)
+        with patch.object(n, "rollout", side_effect=AssertionError("Fixed must not solve")) as forecast:
+            try:
+                decision = self.planner.fixed_action(
+                    snapshot, choice, window, clock=lambda: now, **kwargs,
+                )
+            except n.PlanningRefused as exc:
+                self.fail("Fixed incorrectly inherited the expired MPC solver deadline: " + str(exc))
+        forecast.assert_not_called()
+        self.receipt(
+            "fixed-timing-elapsed-solver", elapsed_from_entry=now - window.entered_at,
+            source_age=now - snapshot.sampled_at,
+            applicable_offset=decision.first_action.not_before - snapshot.sampled_at,
+            runtime_rollout_calls=forecast.call_count,
+        )
+        self.assertEqual(decision.first_action.not_before, now)
+        self.assertEqual(decision.plan.first_action_at, now)
+        self.assertEqual(decision.first_action.not_after, window.action_deadline)
+        for policy in ("mpc", "one_move"):
+            with self.subTest(policy=policy), patch.object(n, "rollout") as forecast:
+                with self.assertRaisesRegex(n.PlanningRefused, "solve_deadline_exhausted"):
+                    self.planner.plan(
+                        snapshot, source, window, policy=policy, clock=lambda: now, **kwargs,
+                    )
+                forecast.assert_not_called()
+
+    def test_fixed_keeps_actual_expiry_source_and_state_guards(self):
+        choice = self.model_fixed_reference()
+        for mode, reason in (
+            ("expired", "action_deadline_exhausted"),
+            ("late-read", "action_deadline_exhausted"),
+            ("stale", "stale_snapshot"),
+            ("version", "state_version_changed"),
+            ("clock-domain", "clock_domain_mismatch"),
+            ("clock-regression", "nonmonotonic_clock"),
+            ("identity", "identity_mismatch"),
+            ("ledger", "ledger_cost_mismatch"),
+        ):
+            with self.subTest(mode=mode):
+                snapshot, _, window, state, kwargs = self.case()
+                now = [window.entered_at + 0.02]
+                if mode == "expired":
+                    now[0] = window.action_deadline
+                elif mode == "stale":
+                    snapshot = replace(snapshot, sampled_at=snapshot.sampled_at - 0.6)
+                elif mode == "version":
+                    state[0] = replace(state[0], budget_version=state[0].budget_version + 1)
+                elif mode == "clock-domain":
+                    kwargs["clock_domain"] = "another-clock"
+                elif mode == "identity":
+                    snapshot = replace(
+                        snapshot, identity=replace(snapshot.identity, calibration_version="qualified"),
+                    )
+                elif mode == "ledger":
+                    snapshot = replace(snapshot, requests=(
+                        RequestMark("bad-cost", 100.0, 0, 1, snapshot.sampled_at, snapshot.sampled_at),
+                    ))
+                else:
+                    def delayed_state():
+                        now[0] = window.action_deadline if mode == "late-read" else window.entered_at - 0.01
+                        return state[0]
+                    kwargs["read_state"] = delayed_state
+                with patch.object(n, "rollout") as forecast:
+                    with self.assertRaisesRegex(n.PlanningRefused, reason):
+                        self.planner.fixed_action(
+                            snapshot, choice, window, clock=lambda: now[0], **kwargs,
+                        )
+                    forecast.assert_not_called()
