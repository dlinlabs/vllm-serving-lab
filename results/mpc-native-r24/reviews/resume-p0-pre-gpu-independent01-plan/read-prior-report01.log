 "findings_low": [
  {"id": "L1", "severity": "LOW", "confidence": "HIGH", "where": "qualification 101-104; client 104-105, 718-738, 878-879", "finding": "The episode S = entered + 1.0 is fixed before describe_protocol (runs implementation_hash and file hashing twice), the permit, an fsync write, NominalRuntime construction, adapter-internal pre-start steps (U1) and the recorder's /v1/models GET. A passed S is refused with zero sends and never retimed. The risk is a wasted single GPU run, not unsafety.", "fix": "Pre-register a lead consistent with the permit window and record S-now at each stage. Before minting the permit, check S + max(episode_s, episode trace duration) <= min(D-R, permit expires_at)."},
  {"id": "L2", "severity": "LOW", "confidence": "HIGH", "where": "qualification 55-64; smoke 280-284", "finding": "If persist_capture raises in the warmup finally while a ProbeError/CancelledError/KeyboardInterrupt is propagating, the write error replaces the primary error. Report.errors records only the final exception, and an interrupt can become an ordinary Exception that smoke does not re-raise.", "fix": "Record the primary exception (or __context__) in the report before or alongside the persist failure."},
  {"id": "L3", "severity": "LOW-MEDIUM", "confidence": "mechanism HIGH; trigger depends on U1", "where": "qualification 128; smoke 42-49, 327", "finding": "The adapter result is stored into report verbatim. The terminal report.json write is unguarded json.dumps(sort_keys=True, allow_nan=False) with no default. Non-JSON types, non-finite floats or mixed key types would make the terminal lifecycle report unwritable, and the exception escapes run() after cleanup.", "fix": "Store a strict-JSON-validated copy (round trip in try, recording a serialization error) or write a minimal fallback report."},
  {"id": "L4", "severity": "LOW-MEDIUM", "confidence": "HIGH", "where": "client 101 and 106 (NOT_CLIENT_OWNED); qualification 92-99; smoke 192", "finding": "Unmet driver obligations: 'warmup and post-warmup gateway drain before the offered start' (the pre-control GET checks only identity/clock/cost) and 'final gateway drain (in_flight 0, admitted cost 0) and fallback counters after the recorder returns' (no post-episode metrics read). tokenizer_fallback_requests == 0 is verified only at readiness, before traffic. Persisted pre-control-state.json and telemetry allow partial post-hoc audit. The known full-wall gap is not counted as new.", "fix": "Before choosing S and after run_episode, read /metrics and assert current_in_flight, current_waiting and current_admitted_cost == 0 and tokenizer_fallback_requests == 0; persist the result."},
  {"id": "L5", "severity": "LOW", "confidence": "HIGH", "where": "qualification 60; client 667, 872-873", "finding": "The warmup passes warmup.capture['clock_domain'] back to capture_replay, whose check is equality with that same field, so the check cannot fail. In practice both are clock_domain() of this process.", "fix": "Pass expected['clock_domain'] (source-time, readiness-verified against the gateway at smoke 201-203)."},
  {"id": "L6", "severity": "LOW", "confidence": "HIGH", "where": "qualification 35; smoke 118-121, 241", "finding": "nominal_protocol.json is re-read with non-strict json.loads and not compared with the sha pinned at startup. Effective limits remain recorded in runtime-binding.json and the journal.", "fix": "Hash the re-read bytes and compare with report['source']['source_pins']."},
  {"id": "L7", "severity": "LOW", "confidence": "HIGH", "where": "qualification 93", "finding": "The GET timeout min(2.0, D-R-now) can be <= 0, causing an immediate timeout exception inside the B3 window (fail-closed).", "fix": "checked(remaining > 0) first."},
  {"id": "L8", "severity": "INFO (nonclaim)", "confidence": "HIGH", "where": "qualification 65-71 vs 129-131", "finding": "Episode success trusts adapter result keys (U1); unlike the warmup it does not inspect the episode capture itself. It requires no CapApplied/CapReobserved/issued_commands, so exit 0 is possible with zero POSTs (all hold/refused steps). Never read it as controller cycles or admission effect (consistent with admin_POSTs null and native_qualification false).", "fix": "Optional: check prepared.recorder.capture status == 'collected' and records == offered_count, and report journal issued_commands."},
