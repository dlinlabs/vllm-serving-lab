  "protocol_id": "r24-resume-p0-nominal-workload-v1",
  "protocol_version": 1
 },
 "rng": {
  "arrival": "gap_seconds = (ln(2^64) - ln(2^64 - X)) / rate in decimal.Context(prec=50, ROUND_HALF_EVEN); arrival time t accumulates from 0; offset_ns = floor(t * 10^9); stop at the first offset_ns >= duration_ns; arrival k = request index; more than max_offers in-window arrivals is refused (no truncation or resampling)",
  "decimal_precision": 50,
  "length_class": "class = prompt_length_classes[(X * n_classes) >> 64] with k = request index (bias <= 2^-64)",
  "payload": "nonce = 16 lowercase hex digits of X with k = request index",
  "streams": [
   "arrival",
   "length_class",
   "payload"
  ],
  "uniform": "X(purpose, seed, stream, k) = big-endian uint64 of the first 8 bytes of sha256(domain || k as 8-byte big-endian); domain = ASCII JSON (separators \",\" \":\") of [generator_id, generator_version, protocol_id, purpose, seed, stream] followed by one 0x00 byte"
