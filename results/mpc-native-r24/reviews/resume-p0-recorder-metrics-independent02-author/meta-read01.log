  "write_capture": "write_capture(path, capture) -> str sha256 of the written bytes (the CLI capture.json codec: sorted keys, indent 1, allow_nan False, exclusive create, fsync)",
  "NOT_RUN_ERROR": "error string of a prepared envelope whose capture_replay was never awaited (status stays 'failed')",
