   555	def test_cli_measures_fixed_run_and_reports_refusal(tmp_path, capsys):
   556	    directory = write_raw(tmp_path / 'raw')
   557	    assert nm.main(['--output-dir', str(directory), '--arm', 'fixed16', '--purpose', 'train']) == 0
   558	    printed = json.loads(capsys.readouterr().out)
   559	    assert printed['outcomes']['fates']['complete'] == 1 and printed['natural_slo']['available'] is False
   560	    assert nm.main(['--output-dir', str(directory), '--arm', 'fixed16', '--purpose', 'eval']) == 1
   561	    assert '"status": "REFUSED"' in capsys.readouterr().err
