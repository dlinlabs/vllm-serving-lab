    39	def run(rows, arm='strong_one_move', purpose='train', missing=('finish_reason: literal test',), control=None,
    40	        control_missing='no controller journal in literal test', start=10.0, duration=5.0, envelope=None,
    41	        identity='a' * 64, scope='offered_cohort_observed', comparability=None, selection=None):
    42	    if envelope is None:
    43	        envelope = (start, max([start + duration] + [r['terminal_at'] for r in rows if r['terminal_at'] is not None]))
    44	    provenance = {'offered_trace_sha256': identity, 'offered_count': len(rows),
    45	                  'offered_request_ids_sha256': canonical_sha([r['request_id'] for r in rows]),
    46	                  'comparability': copy.deepcopy(comparability), 'train_selection_sha256': selection}
    47	    return {'arm': arm, 'purpose': purpose, 'clock_domain': 'literal', 'offered_start': start,
    48	            'offered_duration_s': duration, 'envelope_start': envelope[0], 'envelope_end': envelope[1],
    49	            'envelope_scope': scope, 'rows': rows, 'slo_missing': None if missing is None else list(missing),
    50	            'control': control, 'control_missing': control_missing, 'provenance': provenance}
    51	
