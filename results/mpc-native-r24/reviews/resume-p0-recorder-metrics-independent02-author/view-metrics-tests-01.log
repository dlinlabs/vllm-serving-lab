   212	def test_all_offered_cohort_is_bound_to_offered_count_and_ordered_ids():
   213	    literal = run([row('a', 'complete', 10.0, 10.0, 10.2, 10.5), row('b', 'not_launched', 11.0),
   214	                   row('c', 'unknown', 12.0)])
   215	    cohort = nm.compute(literal)['offered_cohort']
   216	    assert (cohort['offered_count'], cohort['request_ids'], cohort['request_ids_sha256']) == (
   217	        3, ['a', 'b', 'c'], canonical_sha(['a', 'b', 'c']))
   218	    assert nm.request_ids_sha256(iter(['a', 'b', 'c'])) == cohort['request_ids_sha256']
   219	    for mutate, message in (
   220	            (lambda r: r['rows'].pop(), 'all-offered cohort: 2 rows'),
   221	            (lambda r: r['rows'].reverse(), 'request ids'),
   222	            (lambda r: r['rows'][2].update(request_id='z'), 'request ids'),
   223	            (lambda r: r['provenance'].pop('offered_count'), 'offered_count must be an int'),
   224	            (lambda r: r['provenance'].update(offered_count=3.0), 'offered_count must be an int'),
   225	            (lambda r: r['provenance'].update(offered_request_ids_sha256='A' * 64), '64-hex')):
   226	        mutated = copy.deepcopy(literal)
   227	        mutate(mutated)
   228	        with pytest.raises(nm.MetricsInputError, match=message):
   229	            nm.compute(mutated)
