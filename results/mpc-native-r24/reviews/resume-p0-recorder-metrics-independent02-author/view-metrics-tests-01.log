   232	def test_offered_window_and_declared_envelope_bind_every_observation():
   233	    rows = [row('a', 'complete', 10.0, 10.0, 10.2, 10.5), row('b', 'cancelled', 14.0, 14.0, None, 18.0)]
   234	    assert nm.compute(run(rows))['windows']['envelope_end'] == 18.0
   235	    for kwargs, message in (
   236	            ({'envelope': (10.0, 17.0)}, 'terminal_at lies outside the declared envelope'),
   237	            ({'envelope': (10.0, 19.0)}, 'offered_cohort_observed envelope must be'),
   238	            ({'envelope': (9.0, 18.0)}, 'offered_cohort_observed envelope must be'),
   239	            ({'envelope': (10.0, 17.0), 'scope': 'full_wall'}, 'outside the declared envelope')):
   240	        with pytest.raises(nm.MetricsInputError, match=message):
   241	            nm.compute(run(copy.deepcopy(rows), **kwargs))
   242	    late = copy.deepcopy(rows)
   243	    late[1].update(scheduled_at=15.5, sent_at=15.5)
   244	    with pytest.raises(nm.MetricsInputError, match='offered window'):
   245	        nm.compute(run(late))
   246	    full = nm.compute(run(copy.deepcopy(rows), envelope=(9.0, 19.0), scope='full_wall'))
   247	    assert (full['windows']['full_wall_s'], full['throughput']['wall_rate_direction']) == (10.0, 'full_wall_rate')
