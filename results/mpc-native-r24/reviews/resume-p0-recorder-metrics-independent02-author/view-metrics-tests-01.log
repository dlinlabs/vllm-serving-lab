   442	def test_comparison_table_alias_refusals_and_no_winner():
   443	    f16, f32 = _fixed('fixed16', ['good', 'rej']), _fixed('fixed32', ['good', 'good'])
   444	    selection = nm.select_train_fixed({'fixed16': f16, 'fixed32': f32})
   445	    table = nm.comparison_table({'fixed16': {'status': 'MEASURED', 'metrics': f16},
