   502	def test_selection_record_binding_and_eval_alias_reuse_refusals():
   503	    f16, f32 = _fixed('fixed16', ['good', 'rej']), _fixed('fixed32', ['good', 'good'])
   504	    selection = nm.select_train_fixed({'fixed16': f16, 'fixed32': f32})
   505	    unsealed = {key: value for key, value in selection.items() if key != 'selection_sha256'}
   506	    assert selection['selection_sha256'] == canonical_sha(unsealed)
   507	    assert (selection['decided_by'], selection['candidates']['fixed16']['metrics_sha256']) == (
   508	        'primary_natural_slo_good', canonical_sha(f16))
   509	    train = {'fixed16': {'status': 'MEASURED', 'metrics': f16}, 'fixed32': {'status': 'MEASURED', 'metrics': f32}}
   510	    tampered = dict(selection, selected_arm='fixed16', selected_budget=16.0)
   511	    contradictory = dict(tampered, decided_by='tie_2_lower_budget')
   512	    contradictory['selection_sha256'] = canonical_sha({key: value for key, value in contradictory.items()
   513	                                                       if key != 'selection_sha256'})
   514	    for forged, message in (({'schema': nm.SELECTION_SCHEMA, 'status': 'SELECTED', 'selected_arm': 'fixed32'},
   515	                             'keys must be exactly'), (tampered, 'tampered or forged'),
   516	                            (contradictory, 'contradicts')):
   517	        with pytest.raises(nm.MetricsInputError, match=message):
   518	            nm.comparison_table(train, purpose='train', train_selection=forged)
   519	    with pytest.raises(nm.MetricsInputError, match='not the measured fixed16'):
   520	        nm.comparison_table(dict(train, fixed16={'status': 'MEASURED', 'metrics': _fixed('fixed16', ['good', 'good'])}),
   521	                            purpose='train', train_selection=selection)
   522	
   523	    def eval_entry(arm, outcomes=('good', 'rej'), identity='9' * 64, prefix='e', **kwargs):
   524	        return {'status': 'MEASURED', 'metrics': _fixed(arm, list(outcomes), identity=identity, purpose='eval',
   525	                                                        prefix=prefix, **kwargs)}
