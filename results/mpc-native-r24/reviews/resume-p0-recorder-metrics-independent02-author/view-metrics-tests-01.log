    57	def keys_recursive(value):
    58	    if isinstance(value, dict):
    59	        for key, item in value.items():
    60	            yield key
    61	            yield from keys_recursive(item)
    62	    elif isinstance(value, list):
    63	        for item in value:
    64	            yield from keys_recursive(item)
