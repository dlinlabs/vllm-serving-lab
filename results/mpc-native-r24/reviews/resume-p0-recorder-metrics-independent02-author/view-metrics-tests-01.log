    67	def test_nearest_rank_counts_and_sample_max_flags():
    68	    block = nm.percentile_block([float(v) for v in range(20, 0, -1)])
    69	    assert (block['n'], block['p50'], block['p95'], block['p99']) == (20, 10.0, 19.0, 20.0)
    70	    assert (block['p95_rank'], block['p95_is_sample_max'], block['p99_is_sample_max']) == (19, False, True)
    71	    small = nm.percentile_block([float(v) for v in range(1, 20)])
    72	    assert (small['p50'], small['p95'], small['p95_is_sample_max']) == (10.0, 19.0, True)
    73	    empty = nm.percentile_block([])
    74	    assert (empty['n'], empty['p50'], empty['null_reason']) == (0, None, 'no_samples')
