   420	def test_train_selection_primary_ties_and_refusals():
   421	    chosen = nm.select_train_fixed({'fixed16': _fixed('fixed16', ['good', 'rej', 'rej']),
   422	                                    'fixed32': _fixed('fixed32', ['good', 'good', 'rej'])})
   423	    assert (chosen['status'], chosen['selected_arm'], chosen['decided_by']) == ('SELECTED', 'fixed32',
   424	                                                                                'primary_natural_slo_good')
   425	    tie1 = nm.select_train_fixed({'fixed16': _fixed('fixed16', ['good', 'slow', 'rej']),
   426	                                  'fixed32': _fixed('fixed32', ['good', 'rej', 'rej'])})
   427	    assert (tie1['selected_arm'], tie1['decided_by']) == ('fixed16', 'tie_1_fewer_not_delivered')
   428	    tie2 = nm.select_train_fixed({'fixed16': _fixed('fixed16', ['good', 'rej']),
   429	                                  'fixed32': _fixed('fixed32', ['rej', 'good'])})
   430	    assert (tie2['selected_arm'], tie2['decided_by']) == ('fixed16', 'tie_2_lower_budget')
   431	    refusals = [
   432	        {'fixed16': _fixed('fixed16', ['good'], missing=['finish_reason']), 'fixed32': _fixed('fixed32', ['good'])},
   433	        {'fixed16': _fixed('fixed16', ['good'], purpose='eval'), 'fixed32': _fixed('fixed32', ['good'])},
   434	        {'fixed16': _fixed('fixed16', ['good']), 'fixed32': _fixed('fixed32', ['good'], identity='f' * 64)},
   435	        {'fixed16': _fixed('fixed16', ['good'])},
   436	    ]
   437	    reasons = [nm.select_train_fixed(item) for item in refusals]
   438	    assert [item['status'] for item in reasons] == ['REFUSED'] * 4
   439	    assert 'no TTFT-only substitute' in reasons[0]['reason'] and 'Train only' in reasons[1]['reason']
