   172	@pytest.mark.parametrize('mutate, message', [
   173	    (lambda r: r['rows'][0].update(first_content_at=10.005), 'clock order'),
   174	    (lambda r: r['rows'][0].update(sent_at=9.0, first_content_at=9.5), 'clock order'),
   175	    (lambda r: r['rows'][0].update(terminal_at=10.1), 'clock order'),
   176	    (lambda r: r['rows'][0].update(first_content_at=None), 'complete requires sent_at, first_content_at'),
   177	    (lambda r: r['rows'][1].update(sent_at=12.0, terminal_at=12.5), 'not_launched carries'),
   178	    (lambda r: r['rows'][0].update(scheduled_at=True), 'finite int/float'),
   179	    (lambda r: r['rows'][0].update(scheduled_at=math.nan), 'finite int/float'),
   180	    (lambda r: r['rows'][1].update(request_id='a'), 'unique'),
