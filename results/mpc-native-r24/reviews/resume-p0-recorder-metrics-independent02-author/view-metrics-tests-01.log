   469	def test_comparability_facts_validated_and_required_for_selection_and_tables():
   470	    rows = [row('a', 'complete', 10.0, 10.0, 10.2, 10.5, slo_fields=slo())]
   471	    declared = nm.compute(run(rows, missing=None, comparability=COMPARABILITY))['comparability']
   472	    assert (declared['status'], declared['sha256']) == ('DECLARED', canonical_sha(COMPARABILITY))
   473	    model = COMPARABILITY['model']
   474	    for change, message in (
   475	            ({'clock': ''}, 'comparability.clock'),
   476	            ({'hardware': {}}, 'hardware must be a non-empty object'),
   477	            ({'extra': {'x': 1}}, 'keys must be exactly'),
   478	            ({'model': dict(model, served_alias_verified=False)}, 'served_alias_verified must be true'),
   479	            ({'model': dict(model, local_model_path='models/Qwen3-4B-Instruct-2507')}, 'absolute local asset path'),
   480	            ({'model': dict(model, asset_sha256='abc')}, '64-hex'),
   481	            ({'gateway': {'settings': {'MAX_ADMITTED_COST': '16.0'}}}, 'per-arm MAX_ADMITTED_COST'),
   482	            ({'client_generation': {'ignore_eos': True, 'max_tokens_policy': 'trace max_tokens'}},
   483	             'requested_ignore_eos differs')):
   484	        with pytest.raises(nm.MetricsInputError, match=message):
   485	            nm.compute(run(copy.deepcopy(rows), missing=None, comparability=dict(COMPARABILITY, **change)))
   486	    base16 = _fixed('fixed16', ['good', 'rej'])
   487	    shifted = nm.select_train_fixed({'fixed16': base16, 'fixed32': _fixed('fixed32', ['good', 'good'], start=500.0)})
   488	    assert (shifted['status'], shifted['selected_arm']) == ('SELECTED', 'fixed32')  # absolute start is not identity
   489	    for candidate, message in (
   490	            (_fixed('fixed32', ['good', 'good'], comparability=None), "comparability UNVERIFIED for ['fixed32']"),
   491	            (_fixed('fixed32', ['good', 'good'], comparability=dict(COMPARABILITY, hardware={'gpu': 'other'})),
   492	             "incomparable: comparability facts differ ['hardware']"),
   493	            (_fixed('fixed32', ['good', 'good'], spacing=0.2), 'relative schedule')):
   494	        refused = nm.select_train_fixed({'fixed16': base16, 'fixed32': candidate})
   495	        assert refused['status'] == 'REFUSED' and message in refused['reason']
   496	        assert 'selected_arm' not in refused
   497	        with pytest.raises(nm.MetricsInputError, match=re.escape(message)):
   498	            nm.comparison_table({'fixed16': {'status': 'MEASURED', 'metrics': base16},
   499	                                 'fixed32': {'status': 'MEASURED', 'metrics': candidate}}, purpose='train')
