   288	def write_raw(directory, mutate=None):
   289	    model = '/workspace/pr32-r23/models/Qwen3-4B-Instruct-2507'
   290	    trace = {'schema_version': 1, 'max_model_len': 8192, 'model': model,
   291	             'duration_seconds': 5.0, 'output_cap': 128,
   292	             'requests': [{'trace_id': f'p0w1-train-000{i}', 'arrival_seconds': arrival, 'input_tokens': tokens,
   293	                           'max_tokens': 128, 'prompt': 'literal'}
   294	                          for i, (arrival, tokens) in enumerate([(0.1, 300), (0.2, 1100), (0.3, 3100), (0.4, 600),
   295	                                                                 (4.9, 700)])],
   296	             'provenance': {'kind': 'SYNTHETIC_OFFERED_WORKLOAD_TAPE', 'offered_tape_schema': nm.OFFERED_TAPE_SCHEMA,
   297	                            'offered_tape_sha256': 'b' * 64, 'purpose': 'train', 'source_id': 'literal:train',
   298	                            'protocol_id': 'literal', 'requested_prompt_tokens': [256, 1024, 3072, 256, 1024]}}
   299	    start = 1000.0
   300	
   301	    def launched(i, **fields):
   302	        request = trace['requests'][i]
   303	        base = {'scheduled_at': start + request['arrival_seconds'], 'workload': 'trace', 'request_id': f'gw-{i}',
   304	                'client_request_id': f'c{i}', 'stream_complete': False, 'started_at': None, 'first_content_at': None,
   305	                'finished_at': None, 'status': 200, 'ttft': None, 'end_to_end': None, 'input_tokens': None,
   306	                'output_tokens': None, 'total_tokens': None, 'max_output_tokens': 128, 'error_type': None,
   307	                'error_message': None, 'error_phase': None, 'success': False, 'rejected': False,
   308	                'trace_id': request['trace_id'], 'expected_input_tokens': request['input_tokens']}
   309	        base.update(fields)
   310	        return base
   311	
   312	    def placeholder(i, message):
   313	        request = trace['requests'][i]
   314	        return {'trace_id': request['trace_id'], 'client_request_id': f'c{i}', 'request_id': None,
   315	                'scheduled_at': start + request['arrival_seconds'], 'started_at': None, 'first_content_at': None,
   316	                'finished_at': None, 'status': None, 'ttft': None, 'end_to_end': None, 'stream_complete': False,
   317	                'input_tokens': None, 'output_tokens': None, 'max_output_tokens': 128,
   318	                'expected_input_tokens': request['input_tokens'], 'success': False, 'rejected': False,
   319	                'error_type': 'NotLaunched', 'error_message': message, 'error_phase': 'scheduler'}
   320	
   321	    client = {'requests': [
   322	        launched(0, stream_complete=True, started_at=1000.1005, first_content_at=1000.3, finished_at=1001.0,
