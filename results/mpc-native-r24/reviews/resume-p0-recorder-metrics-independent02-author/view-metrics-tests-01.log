    33	def row(rid, fate, sched, sent=None, first=None, term=None, tokens=100, ct=None, slo_fields=None, cap=128):
    34	    return {'request_id': rid, 'group_tokens': tokens, 'max_output_tokens': cap, 'scheduled_at': sched,
    35	            'sent_at': sent, 'first_content_at': first, 'terminal_at': term, 'fate': fate,
    36	            'completion_tokens': ct, 'slo': slo_fields}
