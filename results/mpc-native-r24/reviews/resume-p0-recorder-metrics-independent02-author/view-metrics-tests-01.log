   401	def _fixed(arm, outcomes, identity='e' * 64, purpose='train', missing=None, scope='offered_cohort_observed',
   402	           start=10.0, spacing=0.1, prefix='r', comparability=COMPARABILITY, selection=None):
   403	    rows = []
   404	    for index, kind in enumerate(outcomes):
   405	        sched, rid = start + index * spacing, f'{prefix}{index}'
   406	        if kind == 'good':
   407	            rows.append(row(rid, 'complete', sched, sched, sched + 0.1, sched + 0.46, ct=10,
   408	                            slo_fields=None if missing else slo()))
   409	        elif kind == 'slow':
   410	            rows.append(row(rid, 'complete', sched, sched, sched + 0.9, sched + 1.3, ct=10,
   411	                            slo_fields=None if missing else slo()))
   412	        else:
   413	            rows.append(row(rid, 'rejected', sched, sched, None, sched + 0.01,
   414	                            slo_fields=None if missing else slo(status='rejected', finish=None, done=False)))
   415	    return nm.compute(run(rows, arm=arm, purpose=purpose, missing=missing, control=static(nm.FIXED_BUDGETS[arm]),
   416	                          control_missing=None, identity=identity, scope=scope, start=start,
   417	                          comparability=comparability, selection=selection))
