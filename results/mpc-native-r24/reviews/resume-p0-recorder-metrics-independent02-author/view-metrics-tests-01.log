    77	def test_all_offered_fates_ttft_origins_penalty_and_usage_bounds():
    78	    rows = [row('a', 'complete', 10.0, 10.01, 10.21, 11.0, ct=20),
    79	            row('b', 'complete', 10.5, 10.5, 10.9, 11.5, ct=None),
    80	            row('c', 'rejected', 11.0, 11.0, None, 11.01),
    81	            row('d', 'not_launched', 12.0),
    82	            row('e', 'cancelled', 13.0, 13.0, None, 20.0),
    83	            row('f', 'unknown', 14.0),
    84	            row('g', 'stream_error', 14.5, 14.5, 14.6, 15.0, ct=3)]
    85	    metrics = nm.compute(run(rows))
    86	    outcomes = metrics['outcomes']
    87	    assert metrics['all_offered'] == 7
    88	    assert outcomes['fates'] == {'complete': 2, 'rejected': 1, 'http_error': 0, 'stream_error': 1,
    89	                                 'transport_error': 0, 'cancelled': 1, 'not_launched': 1, 'unknown': 1}
    90	    assert outcomes['rejection_rate'] == pytest.approx(1 / 7)  # not_launched is never merged into rejection
    91	    assert outcomes['failure_rate'] == pytest.approx(2 / 7)
    92	    assert outcomes['not_launched_rate'] == pytest.approx(1 / 7) and outcomes['unknown_rate'] == pytest.approx(1 / 7)
    93	    ttft = metrics['ttft_s']
    94	    assert ttft['conditional_scheduled']['n'] == 2
    95	    assert ttft['conditional_scheduled']['p50'] == pytest.approx(0.21)
    96	    assert ttft['conditional_client_send']['p50'] == pytest.approx(0.20)
    97	    assert ttft['conditional_scheduled']['p95'] == pytest.approx(0.4)
    98	    assert ttft['conditional_scheduled']['p95_is_sample_max'] is True
    99	    penalized = ttft['all_offered_penalized_scheduled']
   100	    assert (penalized['n'], penalized['n_failure_penalty'], penalized['p50_rank']) == (7, 4, 4)
   101	    assert penalized['p50'] is None and penalized['p50_null_reason'] == 'rank_falls_on_failure_penalty'
   102	    assert 'NOT a survival-analysis' in penalized['estimand']
   103	    assert metrics['send_lag_s']['n'] == 5 and metrics['send_lag_s']['n_not_sent'] == 2
   104	    throughput = metrics['throughput']
   105	    assert throughput['delivered'] == 2 and throughput['cohort_normalized_delivered_rps'] == pytest.approx(0.4)
   106	    assert throughput['wall_envelope_delivered_rps'] == pytest.approx(0.2)
   107	    assert (throughput['completion_tokens_observed'], throughput['completion_tokens_upper_bound']) == (20, 148)
   108	    assert throughput['cohort_normalized_completion_tokens_per_s'] == {'lower': 4.0, 'upper': 29.6, 'exact': False}
   109	    assert throughput['wall_envelope_completion_tokens_per_s'] == {'lower': 2.0, 'upper': 14.8, 'exact': False}
   110	    assert throughput['undelivered_reported_completion_tokens'] == 3
   111	    natural = metrics['natural_slo']
   112	    assert natural['available'] is False and natural['natural_slo_good'] is None
   113	    assert natural['null_reason'] == 'natural_slo_fields_unavailable' and natural['missing']
   114	    assert metrics['controller_overhead']['available'] is False
   115	    assert metrics['controller_overhead']['null_reason'] == 'no controller journal in literal test'
   116	    windows = metrics['windows']
   117	    assert windows['envelope_scope'] == 'offered_cohort_observed' and windows['full_wall_s'] is None
   118	    assert 'full wall not recorded' in windows['full_wall_null_reason']
   119	    json.dumps(metrics, allow_nan=False)
