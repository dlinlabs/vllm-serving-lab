   527	    def alias(entries, chosen=selection):
   528	        table = nm.comparison_table(entries, purpose='eval', train_selection=chosen)
   529	        return next(item for item in table['rows'] if item['arm'] == 'train_selected_fixed')
   530	
   531	    sha = selection['selection_sha256']
   532	    bound = {arm: eval_entry(arm, selection=sha) for arm in nm.FIXED_BUDGETS}
   533	    accepted = alias(bound)
   534	    assert (accepted['status'], accepted['alias_of'], accepted['selection']['selection_sha256']) == (
   535	        'ALIAS', 'fixed32', sha)
   536	    unbound = alias(dict(bound, fixed16=eval_entry('fixed16')))
   537	    assert unbound['status'] == 'REFUSED' and 'selection provenance UNVERIFIED' in unbound['reason']
   538	    refused_selection = nm.select_train_fixed({'fixed16': f16})
   539	    assert alias(bound, refused_selection)['status'] == 'REFUSED'
   540	    other_environment = dict(COMPARABILITY, hardware={'gpu': 'other'})
   541	    for entries, message in (
   542	            (dict(bound, fixed16=eval_entry('fixed16', selection='0' * 64)), 'different train_selection_sha256'),
   543	            ({arm: eval_entry(arm, identity='e' * 64, selection=sha) for arm in nm.FIXED_BUDGETS},
   544	             'positive Train/Eval reuse signal'),
   545	            ({arm: eval_entry(arm, prefix='r', selection=sha) for arm in nm.FIXED_BUDGETS},
   546	             'positive Train/Eval reuse signal'),
   547	            ({arm: eval_entry(arm, ('good', 'rej', 'rej'), prefix='r', selection=sha) for arm in nm.FIXED_BUDGETS},
   548	             'positive Train/Eval reuse signal'),
   549	            ({arm: eval_entry(arm, comparability=other_environment, selection=sha) for arm in nm.FIXED_BUDGETS},
   550	             'Train selection comparability facts')):
   551	        with pytest.raises(nm.MetricsInputError, match=message):
   552	            alias(entries)
