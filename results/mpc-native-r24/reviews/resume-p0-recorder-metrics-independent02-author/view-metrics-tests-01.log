   270	def test_controller_overhead_union_static_and_null():
   271	    control = {'kind': 'measured_intervals', 'source': 'literal journal',
   272	               'intervals': [[11.0, 11.5], [11.25, 12.0], [19.5, 21.0], [8.0, 9.0]]}
   273	    overhead = nm.compute(run([], control=control, control_missing=None, envelope=(10.0, 20.0),
   274	                              scope='full_wall'))['controller_overhead']
   275	    assert overhead['decisions'] == 4 and overhead['union_total_s'] == pytest.approx(3.5)
   276	    assert overhead['union_within_envelope_s'] == pytest.approx(1.5)
   277	    assert overhead['union_fraction_of_envelope'] == pytest.approx(0.15)
   278	    assert overhead['durations_s']['n'] == 4 and overhead['durations_s']['max'] == pytest.approx(1.5)
   279	    fixed = nm.compute(run([], arm='fixed32', control=static(32.0), control_missing=None))['controller_overhead']
   280	    assert (fixed['decisions'], fixed['union_total_s'], fixed['kind']) == (0, 0.0, 'static_fixed')
   281	    with pytest.raises(nm.MetricsInputError, match='no controller decision intervals'):
   282	        nm.compute(run([], arm='fixed16', control=control, control_missing=None))
   283	    full = nm.compute(run([], control=control, control_missing=None, envelope=(8.0, 22.0), scope='full_wall'))
   284	    assert (full['windows']['full_wall_s'], full['windows']['full_wall_null_reason']) == (14.0, None)
   285	    assert full['controller_overhead']['union_within_envelope_s'] == pytest.approx(3.5)
