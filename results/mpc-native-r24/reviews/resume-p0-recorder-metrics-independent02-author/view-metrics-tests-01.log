   122	def test_unchanged_natural_slo_length_censoring_groups_and_jain():
   123	    rows = [row('g1', 'complete', 0.0, 0.0, 0.3, 0.66, tokens=512, ct=10, slo_fields=slo()),
   124	            row('g2', 'complete', 1.0, 1.0, 1.3, 1.66, tokens=513, ct=10, slo_fields=slo(finish='length')),
   125	            row('g3', 'complete', 2.0, 2.0, 2.6, 2.96, tokens=2048, ct=10, slo_fields=slo()),
   126	            row('g4', 'rejected', 3.0, 3.0, None, 3.01, tokens=2049,
   127	                slo_fields=slo(status='rejected', finish=None, done=False)),
   128	            row('g5', 'complete', 4.0, 4.0, 4.2, 4.45, tokens=100, ct=1, slo_fields=slo()),
   129	            row('g6', 'complete', 4.9, 4.9, 5.2, 5.56, tokens=3000, ct=10, slo_fields=slo())]
   130	    metrics = nm.compute(run(rows, missing=None, start=0.0, duration=5.0, envelope=(0.0, 8.0), scope='full_wall'))
   131	    natural = metrics['natural_slo']
   132	    assert natural['score_http_sha256'] == nm.SCORE_HTTP_SHA256
   133	    assert natural['rule']['schema'] == 'r23-natural-endpoint-slo-v1'
   134	    assert (natural['all_offered'], natural['natural_slo_good']) == (6, 3)
   135	    assert natural['slo_attainment_fraction'] == pytest.approx(0.5)
   136	    assert natural['cohort_slo_goodput_rps'] == pytest.approx(0.6)
   137	    assert natural['in_window_slo_goodput_rps'] == pytest.approx(0.4)
   138	    assert natural['wall_envelope_slo_goodput_rps'] == pytest.approx(0.375)
   139	    assert natural['censored_cap_completions'] == 1 and natural['finish_reasons']['length'] == 1
   140	    assert natural['one_token_complete'] == 1
   141	    groups = metrics['groups']
   142	    assert [groups[name]['n_offered'] for name in nm.GROUPS] == [2, 2, 2]
   143	    assert [groups[name]['slo_attainment_fraction'] for name in nm.GROUPS] == [1.0, 0.0, 0.5]
   144	    spread = metrics['fairness']['slo_attainment_fraction']
   145	    assert spread['jain'] == pytest.approx(0.6)
   146	    assert (spread['worst_min'], spread['best_max'], spread['gap'], spread['min_over_max']) == (0.0, 1.0, 1.0, 0.0)
   147	    assert metrics['fairness']['worst_group_rejection_rate'] == 0.5
   148	    assert metrics['fairness']['worst_group_ttft_conditional_scheduled_p95_group'] == '513to2048'
