   176	def check_binding(trace, binding):
   177	    """Pure strict model binding check (no I/O); returns argv evidence or raises ClientRefusal."""
   178	    if binding is None:
   179	        raise ClientRefusal('unbound served alias: an explicit model binding record is required')
   180	    if not isinstance(binding, dict) or set(binding) != BINDING_KEYS or binding['schema'] != BINDING_SCHEMA:
   181	        raise ClientRefusal(f'binding keys must be exactly {sorted(BINDING_KEYS)} with schema {BINDING_SCHEMA}')
   182	    alias, path, names = binding['served_alias'], binding['local_model_path'], binding['served_model_names']
   183	    if not isinstance(alias, str) or not alias or alias != trace['model']:
   184	        raise ClientRefusal('served_alias must equal the frozen trace.model (trace.model is never changed)')
   185	    if not isinstance(path, str) or not path.startswith('/') or os.path.normpath(path) != path:
   186	        raise ClientRefusal('local_model_path must be an absolute normalized path')
   187	    provenance = trace.get('provenance')
   188	    expected = provenance.get('tokenizer_sha256') if isinstance(provenance, dict) else None
   189	    if not _sha_hex(binding['tokenizer_sha256']) or binding['tokenizer_sha256'] != expected:
   190	        raise ClientRefusal('tokenizer_sha256 must equal the trace provenance tokenizer_sha256')
   191	    if (not isinstance(names, list) or not names or any(not isinstance(name, str) or not name for name in names)
   192	            or len(set(names)) != len(names) or alias not in names):
   193	        raise ClientRefusal('served_model_names must be unique non-empty strings including served_alias')
   194	    argv, source = binding['backend_argv'], binding['backend_argv_source']
   195	    if not isinstance(argv, list) or not argv or any(not isinstance(arg, str) for arg in argv):
   196	        raise ClientRefusal('backend_argv must be the captured non-empty argv list')
   197	    if not isinstance(source, str) or not source:
   198	        raise ClientRefusal('backend_argv_source must state how the driver captured the actual argv')
   199	    launches = any(argv[index:index + 2] in (['serve', path], ['--model', path]) for index in range(len(argv))) \
   200	        or f'--model={path}' in argv
   201	    if not launches:
   202	        raise ClientRefusal('backend_argv does not launch local_model_path (serve <path> or --model <path>)')
   203	    if _option_values(argv, '--served-model-name') != names:
   204	        raise ClientRefusal('backend_argv needs exactly one space-separated --served-model-name whose values equal '
   205	                            'served_model_names')
   206	    def recorded(option):
   207	        values = _option_values(argv, option)
   208	        return 'unparsed_form' if values is None else values[0] if len(values) == 1 else values or None
   209	
   210	    return {
   211	        'served_alias': alias, 'local_model_path': path, 'served_model_names': list(names),
   212	        'argv_scheduling_policy': recorded('--scheduling-policy'),
   213	        'argv_scheduling_policy_note': 'recorded only; FIFO label stays pending (not a verified FCFS ordering)',
   214	        'argv_prefix_caching_flags': [arg for arg in argv if 'prefix-caching' in arg.replace('_', '-')],
   215	        'argv_max_model_len': recorded('--max-model-len'),
   216	        'backend_argv_sha256': hashlib.sha256(json.dumps(argv).encode()).hexdigest(),
   217	        'backend_argv_source': source,
   218	    }
   219	
