   521	def summarize_records(records):
   522	    def counts(key, values):
   523	        out = {value: 0 for value in values}
   524	        for record in records:
   525	            out[str(record[key])] = out.get(str(record[key]), 0) + 1
   526	        return out
   527	
   528	    lags = [record['send_lag_s'] for record in records if record['send_lag_s'] is not None]
   529	    finish = {}
   530	    for record in records:
   531	        if record['fate'] == 'complete':
   532	            finish[str(record['finish_reason'])] = finish.get(str(record['finish_reason']), 0) + 1
   533	    return {
   534	        'offered': len(records), 'sent': len(lags), 'fates': counts('fate', nm.FATES),
   535	        'finish_reason_evidence': counts('finish_reason_evidence', FINISH_EVIDENCE),
   536	        'finish_reasons_of_complete': finish,
   537	        'completion_tokens_evidence': counts('completion_tokens_evidence', ()),
   538	        'prompt_tokens_mismatch': sum(record['prompt_tokens_match'] is False for record in records),
   539	        'prompt_tokens_matched': sum(record['prompt_tokens_match'] is True for record in records),
   540	        'implementation_exceptions': sum(record['fate_reason'] in ('implementation_exception',
   541	                                                                   'implementation_exception_before_send')
   542	                                         for record in records),
   543	        'max_send_lag_s': max(lags) if lags else None,
   544	    }
   545	
