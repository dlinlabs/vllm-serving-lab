   896	
   897	async def _run_cancellable(coroutine):
   898	    task = asyncio.ensure_future(coroutine)
   899	    loop = asyncio.get_running_loop()
   900	    installed = []
   901	    for signum in (signal.SIGINT, signal.SIGTERM):
   902	        try:
   903	            previous = signal.getsignal(signum)
   904	            loop.add_signal_handler(signum, task.cancel)
   905	            installed.append((signum, previous))
   906	        except (NotImplementedError, RuntimeError, ValueError):
   907	            pass
   908	    try:
   909	        return await task
   910	    finally:
   911	        for signum, previous in installed:
   912	            loop.remove_signal_handler(signum)
   913	            if previous is not None:
   914	                signal.signal(signum, previous)
   915	
