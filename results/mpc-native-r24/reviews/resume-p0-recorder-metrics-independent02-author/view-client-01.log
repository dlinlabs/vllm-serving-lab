   638	def _strict_load(path):
   639	    """(value, bytes) of a strict JSON file; unreadable or non-strict input is a ClientRefusal."""
   640	    try:
   641	        data = Path(path).read_bytes()
   642	        return _strict_json(data, str(path)), data
   643	    except (OSError, ValueError) as exc:
   644	        raise ClientRefusal(f'{path}: unreadable or non-strict JSON: {type(exc).__name__}: {exc}') from exc
   645	
   646	
   647	def _write_new(path, value):
   648	    data = (json.dumps(value, sort_keys=True, indent=1, allow_nan=False) + '\n').encode()
   649	    with open(path, 'xb') as handle:
   650	        handle.write(data)
   651	        handle.flush()
   652	        os.fsync(handle.fileno())
   653	    return hashlib.sha256(data).hexdigest()
   654	
