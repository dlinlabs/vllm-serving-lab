   774	def _replay_main(args, argv, transport, tokenizer_loader):
   775	    try:
   776	        args.output_dir.mkdir(mode=0o700)
   777	    except OSError as exc:
   778	        print(json.dumps({'status': 'REFUSED', 'error': f'output dir: {type(exc).__name__}: {exc}'}, sort_keys=True),
   779	              file=sys.stderr)
   780	        return 2
   781	    capture = _new_capture(args.arm, args.purpose, sys.argv[0], argv, {
   782	        'gateway_url': None, 'backend_url': None, 'drain_timeout_s': args.drain_timeout,
   783	        'request_timeout_s': args.request_timeout, 'start_delay_s': args.start_delay,
   784	        'driver_offered_start': args.offered_start, 'trace_path': str(args.trace), 'binding_path': str(args.binding)})
   785	    ending = None
   786	    try:
   787	        trace = _load_inputs(capture, args.trace, args.binding, args.gateway_url, args.backend_url, args.purpose,
   788	                             ('--gateway-url', '--backend-url'))
   789	        if not _finite(args.drain_timeout) or args.drain_timeout < 0 or not _finite(args.request_timeout) \
   790	                or args.request_timeout <= 0 or not _finite(args.start_delay) or args.start_delay <= 0:
   791	            raise ClientRefusal('timeouts and start delay must be finite (drain >= 0, others > 0)')
   792	        asyncio.run(_run_cancellable(_capture(args, capture, trace, capture['binding'], transport,
   793	                                              tokenizer_loader)))
   794	    except (Exception, asyncio.CancelledError, KeyboardInterrupt) as exc:
   795	        ending = exc
   796	    code = _settle(capture, ending)
   797	    digest = _write_new(args.output_dir / 'capture.json', capture)
   798	    print(json.dumps({'status': capture['status'], 'error': capture['error'], 'capture_sha256': digest,
   799	                      'summary': capture['summary']}, sort_keys=True))
   800	    return code
