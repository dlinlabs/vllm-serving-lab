   683	def _load_inputs(capture, trace_path, binding_path, gateway_url, backend_url, purpose, url_names):
   684	    """Strict trace/binding/URL/purpose loading into the envelope; returns the validated trace."""
   685	    capture['sources_sha256'] = {name: tw.sha256_file(path) for name, path in SOURCES.items()}
   686	    loaded, data = _strict_load(trace_path)
   687	    try:
   688	        trace = tw.validate_trace(loaded)
   689	    except (ValueError, KeyError, TypeError, AttributeError) as exc:
   690	        raise ClientRefusal(f'trace refused: {type(exc).__name__}: {exc}') from exc
   691	    capture['trace_sha256'] = hashlib.sha256(data).hexdigest()
   692	    provenance = trace.get('provenance') if isinstance(trace.get('provenance'), dict) else {}
   693	    capture['trace_provenance'] = {key: provenance.get(key) for key in TAPE_KEYS}
   694	    capture['payload_template']['model'] = trace['model']
   695	    capture['offered_count'], capture['offered_duration_s'] = len(trace['requests']), trace['duration_seconds']
   696	    capture['offered_request_ids_sha256'] = nm.request_ids_sha256(request['trace_id']
   697	                                                                  for request in trace['requests'])
   698	    capture['binding'], binding_data = _strict_load(binding_path)
   699	    capture['binding_sha256'] = hashlib.sha256(binding_data).hexdigest()
   700	    capture['config']['gateway_url'] = _loopback(gateway_url, url_names[0])
   701	    capture['config']['backend_url'] = _loopback(backend_url, url_names[1])
   702	    if provenance.get('purpose') != purpose:
   703	        raise ClientRefusal(f'trace provenance purpose {provenance.get("purpose")!r} != declared {purpose!r}')
   704	    return trace
