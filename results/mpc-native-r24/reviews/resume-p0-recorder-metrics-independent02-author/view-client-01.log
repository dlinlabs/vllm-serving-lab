   401	async def _request(client, url, model, request, record):
   402	    """Send one offered request at its absolute time and record every observation; never reschedules."""
   403	    try:
   404	        payload = {'model': model, 'messages': [{'role': 'user', 'content': request['prompt']}], 'temperature': 0,
   405	                   'max_tokens': request['max_tokens'], 'stream': True, 'stream_options': {'include_usage': True},
   406	                   'ignore_eos': IGNORE_EOS}
   407	        headers = {REQUEST_ID_HEADER: record['client_request_id']}
   408	        while (now := time.monotonic()) < record['scheduled_at']:
   409	            await asyncio.sleep(record['scheduled_at'] - now)
   410	    except asyncio.CancelledError:
   411	        record['fate_reason'] = 'cancelled_before_send'
   412	        raise
   413	    except Exception as exc:
   414	        record['fate_reason'] = 'implementation_exception_before_send'
   415	        _error(record, exc, False)
   416	        return
   417	    record['sent_at'] = time.monotonic()
   418	    record['send_lag_s'] = record['sent_at'] - record['scheduled_at']
   419	    record['fate'], record['fate_reason'] = 'unknown', 'sent_outcome_not_recorded'
   420	    parse = None
   421	    try:
   422	        async with client.stream('POST', url, json=payload, headers=headers) as response:
   423	            record['response_headers_at'] = time.monotonic()
   424	            record['http_status'] = response.status_code
   425	            record['request_id'] = response.headers.get(RESPONSE_ID_HEADER)
   426	            if not response.is_success:
   427	                record['body_text_null_reason'] = 'body_read_incomplete'
   428	                body = await response.aread()
   429	                record['body_bytes'], record['body_sha256'] = len(body), hashlib.sha256(body).hexdigest()
   430	                record['body_text'], record['body_text_null_reason'] = _retained_body(body)
   431	                rejection = _admission_rejection(response.status_code, body)
   432	                record['rejection'] = rejection
   433	                record['fate'], record['fate_reason'] = (('rejected', 'admission_capacity_503') if rejection else
   434	                                                         ('http_error', f'http_{response.status_code}'))
   435	            else:
   436	                parse = StreamParse()
   437	                async for line in response.aiter_lines():
   438	                    parse.feed(line, time.monotonic())
   439	                parsed = parse.result()
   440	                _apply(record, parsed)
   441	                record['fate'], record['fate_reason'] = (('stream_error', parsed['anomalies'][0])
   442	                                                         if parsed['anomalies'] else ('complete', 'complete'))
   443	    except asyncio.CancelledError as exc:
   444	        late = record['fate'] != 'unknown'
   445	        if not late:
   446	            if parse is not None:
   447	                _apply(record, parse.result())
   448	            record['fate'], record['fate_reason'] = 'cancelled', ('before_response_headers'
   449	                                                                  if record['http_status'] is None else 'response_body')
   450	        _error(record, exc, late)
   451	        raise
   452	    except httpx.HTTPError as exc:
   453	        late = record['fate'] != 'unknown'
   454	        if not late:
   455	            if parse is not None:
   456	                _apply(record, parse.result())
   457	            record['fate'], record['fate_reason'] = 'transport_error', ('before_response_headers'
   458	                                                                        if record['http_status'] is None
   459	                                                                        else 'response_body')
   460	        _error(record, exc, late)
   461	    except Exception as exc:
   462	        late = record['fate'] != 'unknown'
   463	        if not late:
   464	            record['fate_reason'] = 'implementation_exception'
   465	        _error(record, exc, late)
   466	    finally:
   467	        record['terminal_at'] = time.monotonic()
   468	
