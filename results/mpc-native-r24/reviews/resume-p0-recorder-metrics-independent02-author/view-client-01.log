   256	class StreamParse:
   257	    """Pure SSE evidence accumulator: ``feed(line, at)`` per received line with the caller's monotonic time."""
   258	
   259	    def __init__(self):
   260	        self.data_events = self.content_events = self.finish_events = 0
   261	        self.first_content_at = self.last_content_at = self.done_at = None
   262	        self.finish_reasons, self.usages, self.anomalies = [], [], []
   263	
   264	    def _flag(self, name):
   265	        if name not in self.anomalies:
   266	            self.anomalies.append(name)
   267	
   268	    def feed(self, line, at):
   269	        if not line.startswith('data:'):
   270	            return
   271	        data = line[5:].strip()
   272	        if self.done_at is not None:
   273	            self._flag('data_after_done')
   274	            return
   275	        if data == '[DONE]':
   276	            self.done_at = at
   277	            return
   278	        self.data_events += 1
   279	        try:
   280	            event = _strict_json(data, 'SSE data')
   281	        except ValueError:
   282	            self._flag('invalid_sse')
   283	            return
   284	        try:
   285	            content = telemetry.has_sse_content(event)
   286	        except ValueError:
   287	            self._flag('error_event' if isinstance(event, dict) and event.get('error') is not None else 'invalid_sse')
   288	            return
   289	        if event.get('usage') is not None:
   290	            self.usages.append(event['usage'])
   291	        finished_before = bool(self.finish_reasons)
   292	        for choice in event.get('choices', []):
   293	            index = choice.get('index', 0)
   294	            if type(index) is not int or index != 0:
   295	                self._flag('unexpected_choice_index')
   296	            reason = choice.get('finish_reason')
   297	            if reason is None:
   298	                continue
   299	            if not isinstance(reason, str):
   300	                self._flag('invalid_sse')
   301	                continue
   302	            self.finish_events += 1
   303	            if reason not in self.finish_reasons:
   304	                self.finish_reasons.append(reason)
   305	        if content:
   306	            if finished_before:
   307	                self._flag('finish_reason_contradiction')
   308	            self.content_events += 1
   309	            if self.first_content_at is None:
   310	                self.first_content_at = at
   311	            self.last_content_at = at
   312	
   313	    def result(self):
   314	        anomalies = set(self.anomalies)
   315	        if len(self.finish_reasons) > 1:
   316	            anomalies.add('finish_reason_contradiction')
   317	        if self.done_at is None:
   318	            anomalies.add('missing_done')
   319	        if not self.content_events:
   320	            anomalies.add('empty_content')
   321	        if 'finish_reason_contradiction' in anomalies:
   322	            evidence, finish = 'contradiction', None
   323	        elif self.finish_reasons:
   324	            evidence, finish = 'observed', self.finish_reasons[0]
   325	        else:
   326	            evidence, finish = 'absent', None
   327	        usage, tokens = (self.usages[0], None) if len(self.usages) == 1 else (None, None)
   328	        if not self.usages:
   329	            tokens_evidence = 'absent'
   330	        elif len(self.usages) > 1:
   331	            tokens_evidence = 'multiple_usage'
   332	        else:
   333	            value = usage.get('completion_tokens')
   334	            tokens, tokens_evidence = (value, 'usage') if type(value) is int and value >= 0 else (None, 'invalid_usage')
   335	        prompt = usage.get('prompt_tokens') if usage is not None else None
   336	        return {
   337	            'first_content_at': self.first_content_at, 'last_content_at': self.last_content_at,
   338	            'done_at': self.done_at, 'stream_done': self.done_at is not None, 'data_events': self.data_events,
   339	            'content_events': self.content_events, 'finish_reason': finish, 'finish_reason_evidence': evidence,
   340	            'finish_reasons_seen': list(self.finish_reasons), 'finish_reason_events': self.finish_events,
   341	            'anomalies': [name for name in ANOMALIES if name in anomalies], 'usage': usage,
   342	            'usage_events': len(self.usages), 'completion_tokens': tokens,
   343	            'completion_tokens_evidence': tokens_evidence, 'prompt_tokens': prompt if type(prompt) is int else None,
   344	        }
   345	
