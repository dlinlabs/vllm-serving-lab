   557	def build_run(capture, *, control=None, control_missing=None, control_evidence=None, full_wall=None,
   558	              capture_sha256=None, comparability=None):
   559	    """nominal_metrics run for a collected capture; full wall, control and comparability facts come only from driver
   560	    records (comparability model alias/path/tokenizer and ignore_eos are cross-checked against this capture)."""
   561	    if not isinstance(capture, dict) or capture.get('schema') != SCHEMA:
   562	        raise ClientRefusal(f'not a {SCHEMA} capture')
   563	    if capture['status'] != 'collected':
   564	        raise ClientRefusal(f'capture status {capture["status"]!r}: preserved as failure evidence, not scored')
   565	    if capture['purpose'] not in nm.PURPOSES:
   566	        raise ClientRefusal(f'purpose {capture["purpose"]!r} is a raw engineering capture, not a core train/eval '
   567	                            'metrics run')
   568	    rows = [normalized_row(record) for record in capture['records']]
   569	    if rows != capture['rows']:
   570	        raise ClientRefusal('capture rows differ from the per-request evidence mapping')
   571	    domain, offered_start = capture['clock_domain'], capture['offered_start']
   572	    observed_end = max([offered_start + capture['offered_duration_s']]
   573	                       + [row['terminal_at'] for row in rows if row['terminal_at'] is not None])
   574	    collected_end = max(observed_end, capture['collection_end'])
   575	    if full_wall is None:
   576	        scope, start, end = 'offered_cohort_observed', offered_start, observed_end
   577	    else:
   578	        if (not isinstance(full_wall, dict) or set(full_wall) != {'start', 'end', 'clock_domain', 'source'}
   579	                or full_wall['clock_domain'] != domain or not _finite(full_wall['start'])
   580	                or not _finite(full_wall['end']) or not isinstance(full_wall['source'], str)
   581	                or not full_wall['source']):
   582	            raise ClientRefusal('full_wall must be a driver record {start, end, clock_domain, source} in the capture '
   583	                                'clock domain')
   584	        if full_wall['start'] > offered_start or full_wall['end'] < collected_end:
   585	            raise ClientRefusal('full_wall must contain the offered window, every terminal and the collection end')
   586	        scope, start, end = 'full_wall', full_wall['start'], full_wall['end']
   587	    if isinstance(control, dict) and control.get('kind') == 'static_fixed':
   588	        evidence = control_evidence
   589	        if (not isinstance(evidence, dict) or set(evidence) != CONTROL_EVIDENCE_KEYS
   590	                or evidence['clock_domain'] != domain or not _finite(evidence['acknowledged_at'])
   591	                or not _finite(evidence['held_verified_at']) or not evidence['acknowledged_at'] < offered_start
   592	                or evidence['held_verified_at'] < collected_end or not isinstance(evidence['source'], str)
   593	                or not evidence['source']):
   594	            raise ClientRefusal('static_fixed control needs driver control_evidence {acknowledged_at < offered_start, '
   595	                                'held_verified_at >= collection end, clock_domain, source}')
   596	    elif control_evidence is not None:
   597	        raise ClientRefusal('control_evidence applies only to a static_fixed control')
   598	    if comparability is not None:
   599	        _check_comparability(capture, comparability)
   600	    run = {
   601	        'arm': capture['arm'], 'purpose': capture['purpose'], 'clock_domain': domain, 'offered_start': offered_start,
   602	        'offered_duration_s': capture['offered_duration_s'], 'envelope_start': start, 'envelope_end': end,
   603	        'envelope_scope': scope, 'rows': rows, 'slo_missing': None, 'control': control,
   604	        'control_missing': control_missing,
   605	        'provenance': {
   606	            'source': 'nominal_client.py capture', 'capture_sha256': capture_sha256,
   607	            'offered_trace_sha256': capture['trace_sha256'], 'offered_tape': capture['trace_provenance'],
   608	            'offered_count': capture.get('offered_count'),
   609	            'offered_request_ids_sha256': capture.get('offered_request_ids_sha256'), 'comparability': comparability,
   610	            'run_id': capture['run_id'], 'model_binding': capture['binding_evidence'],
   611	            'client_sources_sha256': capture['sources_sha256'], 'capture_summary': capture['summary'],
   612	            'control_evidence': control_evidence, 'full_wall': full_wall, 'mapping': ROW_MAPPING,
   613	            'qualifiers': list(QUALIFIERS), 'not_client_owned': list(NOT_CLIENT_OWNED),
   614	        },
   615	    }
   616	    try:
   617	        nm.validate_run(run)
   618	    except nm.MetricsInputError as exc:
   619	        raise ClientRefusal(f'normalized run invalid: {exc}') from exc
   620	    return run
