   508	def normalized_row(record):
   509	    """The strict nominal_metrics row of one per-request evidence record (see ROW_MAPPING)."""
   510	    fate = record['fate']
   511	    return {
   512	        'request_id': record['trace_id'], 'group_tokens': record['expected_input_tokens'],
   513	        'max_output_tokens': record['max_tokens'], 'scheduled_at': record['scheduled_at'],
   514	        'sent_at': record['sent_at'], 'first_content_at': record['first_content_at'],
   515	        'terminal_at': record['terminal_at'], 'fate': fate, 'completion_tokens': record['completion_tokens'],
   516	        'slo': {'status': fate, 'finish_reason': record['finish_reason'], 'requested_ignore_eos': IGNORE_EOS,
   517	                'stream_done': record['stream_done'], 'stream_error': fate == 'stream_error'},
   518	    }
