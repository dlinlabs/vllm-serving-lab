   656	def _loopback(url, name):
   657	    parsed = urllib.parse.urlsplit(url)
   658	    if parsed.scheme != 'http' or parsed.hostname not in LOOPBACK_HOSTS or parsed.path not in ('', '/'):
   659	        raise ClientRefusal(f'{name} must be an http loopback base URL without a path')
   660	    return url.rstrip('/')
