   891	def write_capture(path, capture):
   892	    """Persist a capture with the CLI capture.json codec (sorted keys, indent 1, no NaN, exclusive create, fsync);
   893	    returns the sha256 of the written bytes."""
   894	    return _write_new(path, capture)
