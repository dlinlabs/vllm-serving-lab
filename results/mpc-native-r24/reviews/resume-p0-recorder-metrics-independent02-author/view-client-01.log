   623	def _check_comparability(capture, comparability):
   624	    """Declared comparability facts must not contradict what this recorder itself verified or sent."""
   625	    model = comparability.get('model') if isinstance(comparability, dict) else None
   626	    generation = comparability.get('client_generation') if isinstance(comparability, dict) else None
   627	    if not isinstance(model, dict) or not isinstance(generation, dict):
   628	        raise ClientRefusal('comparability must be a driver record with model and client_generation objects')
   629	    evidence = capture.get('binding_evidence') or {}
   630	    observed = {'served_alias': evidence.get('served_alias'), 'local_model_path': evidence.get('local_model_path'),
   631	                'tokenizer_sha256': (evidence.get('tokenizer') or {}).get('fingerprint')}
   632	    differ = sorted(key for key, value in observed.items() if value is None or model.get(key) != value)
   633	    if differ or generation.get('ignore_eos') is not IGNORE_EOS:
   634	        raise ClientRefusal(f'comparability contradicts or exceeds this capture binding evidence: model {differ}; '
   635	                            f'client_generation.ignore_eos must be {IGNORE_EOS}')
   636	
