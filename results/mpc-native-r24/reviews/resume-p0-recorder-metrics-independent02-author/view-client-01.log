   547	def clock_domain():
   548	    """Host-wide CLOCK_MONOTONIC identity; a driver record must carry the identical string."""
   549	    try:
   550	        boot = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
   551	    except OSError:
   552	        boot = 'unavailable'
   553	    info = time.get_clock_info('monotonic')
   554	    return f'time.monotonic {info.implementation} host={socket.gethostname()} boot_id={boot}'
   555	
