   849	
   850	async def capture_replay(prepared, *, offered_start, deadline, cleanup_reserve_s, clock_domain, transport=None):
   851	    """Await one complete raw-v2 capture inside the caller's running loop (no asyncio.run, no signal handlers).
   852	
   853	    ``offered_start`` is the caller's exact future absolute time.monotonic() start (never retimed); in-flight requests
   854	    are cancelled at ``deadline - cleanup_reserve_s`` (the caller's original absolute deadline minus its reserve) and
   855	    every request task is joined.  ``clock_domain`` must equal the envelope clock_domain.  Refusals send nothing.
   856	    Returns ``prepared.capture`` with status collected/refused/failed; on cancellation or KeyboardInterrupt the
   857	    envelope is finalized 'interrupted' in place (every allocated record, rows, summary) and the exception re-raised.
   858	    No full wall, control, comparability, metrics or persistence (``write_capture``) here.
   859	    """
   860	    if not isinstance(prepared, PreparedCapture) or not prepared.ready or prepared.started:
   861	        raise ClientRefusal('capture_replay needs a ready, unused PreparedCapture (one capture per preparation)')
   862	    prepared.started = True
   863	    capture, trace = prepared.capture, prepared.trace
   864	    capture['error'] = None
   865	    capture['config'].update(driver_offered_start=offered_start if _finite(offered_start) else None,
   866	                             caller_deadline=deadline if _finite(deadline) else None,
   867	                             cleanup_reserve_s=cleanup_reserve_s if _finite(cleanup_reserve_s) else None,
   868	                             caller_clock_domain=clock_domain if isinstance(clock_domain, str) else None)
   869	    try:
   870	        if not (_finite(offered_start) and _finite(deadline) and _finite(cleanup_reserve_s)) or cleanup_reserve_s < 0:
   871	            raise ClientRefusal('offered_start, deadline and cleanup_reserve_s must be finite numbers (reserve >= 0)')
   872	        if clock_domain != capture['clock_domain']:
   873	            raise ClientRefusal('caller clock_domain differs from the recorder clock domain (clock_domain())')
   874	        drain_deadline = deadline - cleanup_reserve_s
   875	        if drain_deadline < offered_start + trace['duration_seconds']:
   876	            raise ClientRefusal('deadline - cleanup_reserve_s ends before the offered window: refused, never truncated')
   877	        now = time.monotonic()
   878	        if not now < offered_start <= now + MAX_START_WAIT_S:
   879	            raise ClientRefusal(f'offered_start must lie in (now, now + {MAX_START_WAIT_S}s]: no rescheduling')
   880	        await _collect(capture, trace, capture['binding'], transport, capture['config']['request_timeout_s'],
   881	                       lambda now: (offered_start, drain_deadline))
   882	    except BaseException as exc:
   883	        _settle(capture, exc)
   884	        if not isinstance(exc, Exception):
   885	            raise
   886	        return capture
   887	    _settle(capture)
   888	    return capture
