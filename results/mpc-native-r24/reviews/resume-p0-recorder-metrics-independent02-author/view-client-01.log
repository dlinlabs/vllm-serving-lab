   707	def _preflight_local(capture, trace, binding, tokenizer_loader):
   708	    """Model binding and tokenizer checks from local_model_path (no HTTP), before any offered start."""
   709	    capture['binding_evidence'] = check_binding(trace, binding)
   710	    try:
   711	        tokenizer = tokenizer_loader(binding['local_model_path'])
   712	    except Exception as exc:
   713	        raise ClientRefusal(f'tokenizer not loadable from local_model_path: {type(exc).__name__}: {exc}') from exc
   714	    capture['binding_evidence']['tokenizer'] = check_tokenizer(trace, binding, tokenizer)
