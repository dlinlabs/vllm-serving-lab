   221	def check_served_models(binding, models, max_model_len):
   222	    """The backend must serve exactly the bound names; the alias root must be the local path."""
   223	    data = models.get('data') if isinstance(models, dict) else None
   224	    if not isinstance(data, list) or any(not isinstance(item, dict) for item in data):
   225	        raise ClientRefusal('backend /v1/models response is not a model list')
   226	    ids = [item.get('id') for item in data]
   227	    if any(not isinstance(item, str) for item in ids) or len(set(ids)) != len(ids) \
   228	            or sorted(ids) != sorted(binding['served_model_names']):
   229	        raise ClientRefusal('backend /v1/models ids differ from the bound served_model_names')
   230	    entry = next(item for item in data if item['id'] == binding['served_alias'])
   231	    if entry.get('root') != binding['local_model_path']:
   232	        raise ClientRefusal('backend served alias root differs from local_model_path')
   233	    if entry.get('max_model_len') != max_model_len:
   234	        raise ClientRefusal('backend served alias max_model_len differs from the trace max_model_len')
   235	    return {'ids': ids, 'alias_root': entry['root'], 'alias_max_model_len': entry['max_model_len']}
