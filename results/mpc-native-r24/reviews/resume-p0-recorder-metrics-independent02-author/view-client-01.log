   238	def check_tokenizer(trace, binding, tokenizer):
   239	    """The tokenizer loaded from local_model_path must reproduce the fingerprint and every trace prompt count."""
   240	    fingerprint = tw.tokenizer_fingerprint(tokenizer)
   241	    if fingerprint != binding['tokenizer_sha256']:
   242	        raise ClientRefusal('tokenizer loaded from local_model_path does not match the bound fingerprint')
   243	    try:
   244	        tw.verify_prompts(trace, tokenizer)
   245	    except ValueError as exc:
   246	        raise ClientRefusal(f'trace prompt token counts differ under the bound tokenizer: {exc}') from exc
   247	    return {'fingerprint': fingerprint, 'prompts_verified': len(trace['requests'])}
