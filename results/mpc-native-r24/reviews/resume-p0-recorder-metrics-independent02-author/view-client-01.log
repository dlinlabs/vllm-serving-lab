   917	def _finalize_main(args):
   918	    capture, capture_data = _strict_load(args.capture)
   919	    control = _strict_load(args.control_json)[0] if args.control_json else None
   920	    evidence = _strict_load(args.control_evidence_json)[0] if args.control_evidence_json else None
   921	    full_wall = _strict_load(args.full_wall_json)[0] if args.full_wall_json else None
   922	    comparability = _strict_load(args.comparability_json)[0] if args.comparability_json else None
   923	    run = build_run(capture, control=control, control_missing=args.control_missing, control_evidence=evidence,
   924	                    full_wall=full_wall, capture_sha256=hashlib.sha256(capture_data).hexdigest(),
   925	                    comparability=comparability)
   926	    metrics = nm.compute(run)
   927	    args.output_dir.mkdir(mode=0o700)
   928	    digests = {'run.json': _write_new(args.output_dir / 'run.json', run),
   929	               'metrics.json': _write_new(args.output_dir / 'metrics.json', metrics)}
   930	    print(json.dumps({'status': 'FINALIZED', 'sha256': digests, 'summary': nm.summarize(metrics)}, sort_keys=True))
   931	    return 0
