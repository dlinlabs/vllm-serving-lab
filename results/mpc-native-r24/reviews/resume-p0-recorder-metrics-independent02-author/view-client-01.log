   717	async def _collect(capture, trace, binding, transport, request_timeout, schedule):
   718	    """Backend /v1/models check, then ``schedule(now) -> (offered_start, drain_deadline)``; every offer is allocated
   719	    and replayed to that absolute drain deadline (records stay in the envelope on any exit)."""
   720	    limits = httpx.Limits(max_connections=len(trace['requests']) + 1,
   721	                          max_keepalive_connections=len(trace['requests']) + 1)
   722	    async with httpx.AsyncClient(transport=transport, timeout=request_timeout, limits=limits,
   723	                                 trust_env=False) as client:
   724	        try:
   725	            response = await client.get(capture['config']['backend_url'] + MODELS_PATH)
   726	            response.raise_for_status()
   727	            capture['models_response'] = _strict_json(response.content, 'backend /v1/models')
   728	        except (httpx.HTTPError, ValueError) as exc:
   729	            raise ClientRefusal(f'backend /v1/models unavailable: {type(exc).__name__}: {exc}') from exc
   730	        capture['binding_evidence']['served_models'] = check_served_models(binding, capture['models_response'],
   731	                                                                           trace['max_model_len'])
   732	        now = time.monotonic()
   733	        offered_start, drain_deadline = schedule(now)
   734	        if not now < offered_start <= now + MAX_START_WAIT_S:
   735	            raise ClientRefusal(f'offered_start must lie in (now, now + {MAX_START_WAIT_S}s]: no rescheduling')
   736	        capture['offered_start'] = offered_start
   737	        capture['offered_end'] = offered_start + trace['duration_seconds']
   738	        records = capture['records'] = prepare_records(trace, offered_start, capture['run_id'])
   739	        try:
   740	            capture['drain_deadline'] = drain_deadline
   741	            await _replay(client, trace, records, gateway_url=capture['config']['gateway_url'],
   742	                          offered_start=offered_start, drain_deadline=drain_deadline)
   743	        finally:
   744	            capture['collection_end'] = time.monotonic()
   745	
   746	
   747	async def _capture(args, capture, trace, binding, transport, tokenizer_loader):
   748	    _preflight_local(capture, trace, binding, tokenizer_loader)
   749	
   750	    def schedule(now):
   751	        offered_start = args.offered_start if args.offered_start is not None else now + args.start_delay
   752	        return offered_start, offered_start + trace['duration_seconds'] + args.drain_timeout
   753	
   754	    await _collect(capture, trace, binding, transport, args.request_timeout, schedule)
   755	
   756	
   757	def _settle(capture, ending=None):
   758	    """Status/error from the exception that ended a capture (None: collected), then rows and summary of every
   759	    allocated record; returns the CLI exit code of that status."""
   760	    if ending is None:
   761	        capture['status'], capture['error'] = 'collected', None
   762	    elif isinstance(ending, ClientRefusal):
   763	        capture['status'], capture['error'] = 'refused', f'ClientRefusal: {ending}'
   764	    elif isinstance(ending, (asyncio.CancelledError, KeyboardInterrupt)):
   765	        capture['status'], capture['error'] = 'interrupted', f'{type(ending).__name__}: replay interrupted'
   766	    else:
   767	        capture['status'], capture['error'] = 'failed', f'{type(ending).__name__}: {str(ending)[:300]}'
   768	    if capture['records'] is not None:
   769	        capture['rows'] = [normalized_row(record) for record in capture['records']]
   770	        capture['summary'] = summarize_records(capture['records'])
   771	    return EXIT_CODES[capture['status']]
