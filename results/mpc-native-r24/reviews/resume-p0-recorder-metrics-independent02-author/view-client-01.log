   934	def main(argv=None, *, transport=None, tokenizer_loader=load_tokenizer):
   935	    parser = argparse.ArgumentParser(description='P0 nominal native replay request recorder (no winner, no '
   936	                                                 'qualification).', allow_abbrev=False)
   937	    commands = parser.add_subparsers(dest='command', required=True)
   938	    replay_parser = commands.add_parser('replay', allow_abbrev=False)
   939	    replay_parser.add_argument('--trace', type=Path, required=True)
   940	    replay_parser.add_argument('--binding', type=Path, required=True)
   941	    replay_parser.add_argument('--gateway-url', required=True)
   942	    replay_parser.add_argument('--backend-url', required=True)
   943	    replay_parser.add_argument('--arm', required=True, choices=nm.RUN_ARMS)
   944	    replay_parser.add_argument('--purpose', required=True, type=_purpose)
   945	    replay_parser.add_argument('--output-dir', type=Path, required=True)
   946	    replay_parser.add_argument('--offered-start', type=_finite_float, help='driver absolute time.monotonic() origin')
   947	    replay_parser.add_argument('--start-delay', type=_finite_float, default=0.2)
   948	    replay_parser.add_argument('--drain-timeout', type=_finite_float, default=120.0)
   949	    replay_parser.add_argument('--request-timeout', type=_finite_float, default=120.0)
   950	    finalize_parser = commands.add_parser('finalize', allow_abbrev=False)
   951	    finalize_parser.add_argument('--capture', type=Path, required=True)
   952	    finalize_parser.add_argument('--output-dir', type=Path, required=True)
   953	    finalize_parser.add_argument('--control-json', type=Path)
   954	    finalize_parser.add_argument('--control-evidence-json', type=Path)
   955	    finalize_parser.add_argument('--control-missing')
   956	    finalize_parser.add_argument('--full-wall-json', type=Path)
   957	    finalize_parser.add_argument('--comparability-json', type=Path)
   958	    argv = list(sys.argv[1:] if argv is None else argv)
   959	    args = parser.parse_args(argv)
   960	    if args.command == 'replay':
   961	        return _replay_main(args, argv, transport, tokenizer_loader)
   962	    try:
   963	        return _finalize_main(args)
   964	    except (ClientRefusal, nm.MetricsInputError, OSError, ValueError) as exc:
   965	        print(json.dumps({'status': 'REFUSED', 'error': f'{type(exc).__name__}: {exc}'}, sort_keys=True),
   966	              file=sys.stderr)
   967	        return 2
   968	
   969	
   970	if __name__ == '__main__':
   971	    sys.exit(main())
