   118	class ClientRefusal(ValueError):
   119	    """A prerequisite or input the recorder cannot honour truthfully: refused, never repaired."""
   120	
   121	
   122	def _finite(value):
   123	    return type(value) in (int, float) and math.isfinite(value)
   124	
   125	
   126	def _reject_constant(token):
   127	    raise ValueError(f'non-finite JSON constant {token}')
   128	
   129	
   130	def _strict_json(data, label):
   131	    """JSON without duplicate keys or NaN/Infinity, so every capture stays writable with allow_nan=False."""
   132	    def pairs(items):
   133	        if len({key for key, _ in items}) != len(items):
   134	            raise ValueError(f'{label}: duplicate JSON object key')
   135	        return dict(items)
   136	
   137	    return json.loads(data, object_pairs_hook=pairs, parse_constant=_reject_constant)
   138	
   139	
   140	def _finite_float(text):
   141	    value = float(text)
   142	    if not math.isfinite(value):
   143	        raise argparse.ArgumentTypeError('must be a finite number')
   144	    return value
   145	
   146	
   147	def _purpose(text):
   148	    if text in nm.PURPOSES:
   149	        return text
   150	    if (not text or not text[0].islower() or not text.isascii()
   151	            or any(not (char.islower() or char.isdigit() or char == '_') for char in text)
   152	            or 'eval' in text or 'held' in text):
   153	        raise argparse.ArgumentTypeError(f'core {nm.PURPOSES} or {RAW_PURPOSE_RULE}')
   154	    return text
   155	
   156	
   157	def _sha_hex(value):
   158	    return isinstance(value, str) and len(value) == 64 and all(char in '0123456789abcdef' for char in value)
   159	
   160	
   161	def _option_values(argv, option):
   162	    """Values of a space-separated option; ``--opt=value`` or repeated forms return None (refused by callers)."""
   163	    spelled = [index for index, arg in enumerate(argv) if arg.replace('_', '-').split('=', 1)[0] == option]
   164	    if not spelled:
   165	        return []
   166	    if len(spelled) != 1 or argv[spelled[0]] != option:
   167	        return None
   168	    values = []
   169	    for arg in argv[spelled[0] + 1:]:
   170	        if arg.startswith('-'):
   171	            break
   172	        values.append(arg)
   173	    return values
