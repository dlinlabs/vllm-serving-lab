   664	    """The raw-v2 capture envelope (status 'failed' until an outcome is recorded); shared by the CLI and library."""
   665	    return {
   666	        'schema': SCHEMA, 'status': 'failed', 'error': None, 'arm': arm, 'purpose': purpose,
   667	        'run_id': str(uuid.uuid4()), 'clock_domain': clock_domain(), 'program': program, 'argv': argv,
   668	        'config': config,
   669	        'host': socket.gethostname(), 'pid': os.getpid(), 'python': sys.version, 'httpx': httpx.__version__,
   670	        'sources_sha256': None,
   671	        'payload_template': {'model': None, 'messages': [{'role': 'user', 'content': '<trace prompt>'}],
   672	                             'temperature': 0, 'max_tokens': '<trace max_tokens>', 'stream': True,
   673	                             'stream_options': {'include_usage': True}, 'ignore_eos': IGNORE_EOS},
   674	        'trace_sha256': None, 'trace_provenance': None, 'binding': None, 'binding_sha256': None,
   675	        'binding_evidence': None, 'models_response': None, 'offered_count': None, 'offered_request_ids_sha256': None,
   676	        'offered_duration_s': None,
   677	        'offered_start': None, 'offered_end': None, 'drain_deadline': None, 'collection_end': None,
   678	        'records': None, 'rows': None, 'summary': None, 'mapping': ROW_MAPPING, 'qualifiers': QUALIFIERS,
   679	        'not_client_owned': NOT_CLIENT_OWNED,
   680	    }
