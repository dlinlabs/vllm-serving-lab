   347	def prepare_records(trace, offered_start, run_id):
   348	    """One placeholder per offered request (fate not_launched until sent), allocated before any send."""
   349	    namespace = uuid.UUID(run_id)
   350	    return [{
   351	        'trace_id': request['trace_id'], 'client_request_id': uuid.uuid5(namespace, request['trace_id']).hex,
   352	        'request_id': None, 'expected_input_tokens': request['input_tokens'], 'max_tokens': request['max_tokens'],
   353	        'scheduled_at': offered_start + request['arrival_seconds'], 'sent_at': None, 'send_lag_s': None,
   354	        'response_headers_at': None, 'first_content_at': None, 'last_content_at': None, 'done_at': None,
   355	        'terminal_at': None, 'http_status': None, 'fate': 'not_launched', 'fate_reason': 'not_sent',
   356	        'stream_done': False, 'data_events': 0, 'content_events': 0, 'finish_reason': None,
   357	        'finish_reason_evidence': 'not_applicable', 'finish_reasons_seen': [], 'finish_reason_events': 0,
   358	        'anomalies': [], 'usage': None, 'usage_events': 0, 'completion_tokens': None,
   359	        'completion_tokens_evidence': 'not_applicable', 'prompt_tokens': None, 'prompt_tokens_match': None,
   360	        'rejection': None, 'body_bytes': None, 'body_sha256': None, 'body_text': None,
   361	        'body_text_null_reason': 'not_applicable', 'error_type': None, 'error_message': None,
   362	    } for request in trace['requests']]
   363	
   364	
   365	def _apply(record, parsed):
   366	    record.update(parsed)
   367	    if parsed['prompt_tokens'] is not None:
   368	        record['prompt_tokens_match'] = parsed['prompt_tokens'] == record['expected_input_tokens']
   369	
   370	
   371	def _retained_body(body):
   372	    if len(body) > MAX_RETAINED_BODY_BYTES:
   373	        return None, f'over_{MAX_RETAINED_BODY_BYTES}_bytes'
   374	    try:
   375	        return body.decode('utf-8'), None
   376	    except UnicodeDecodeError:
   377	        return None, 'not_utf8'
   378	
   379	
   380	def _admission_rejection(status, body):
   381	    if status != 503:
   382	        return None
   383	    try:
   384	        value = _strict_json(body, 'admission body')
   385	    except ValueError:
   386	        return None
   387	    if isinstance(value, dict) and value.get('detail') == ADMISSION_DETAIL and 'estimated_request_cost' in value:
   388	        cost = value['estimated_request_cost']
   389	        rejection = {'detail': ADMISSION_DETAIL, 'estimated_request_cost': cost if _finite(cost) else None}
   390	        rejection.update({key: value.get(key) for key in GATEWAY_REJECTION_FIELDS})
   391	        rejection['fields_absent'] = sorted(key for key in GATEWAY_REJECTION_FIELDS if key not in value)
   392	        return rejection
   393	    return None
   394	
   395	
   396	def _error(record, exc, late):
   397	    record['error_type'] = type(exc).__name__
   398	    record['error_message'] = ('after_outcome: ' if late else '') + str(exc)[:300]
   399	
