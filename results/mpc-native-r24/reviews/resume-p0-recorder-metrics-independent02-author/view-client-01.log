   470	async def replay(client, trace, records, *, gateway_url, offered_start, drain_timeout):
   471	    """Offer every request at offered_start + arrival_seconds; retain every outcome in ``records`` (in place).
   472	
   473	    In-flight requests are cancelled at offered_end + drain_timeout.  Returns the drain deadline.
   474	    """
   475	    if not _finite(drain_timeout) or drain_timeout < 0:
   476	        raise ClientRefusal('drain_timeout must be a finite non-negative number')
   477	    return await _replay(client, trace, records, gateway_url=gateway_url, offered_start=offered_start,
   478	                         drain_timeout=drain_timeout)
   479	
   480	
   481	async def _replay(client, trace, records, *, gateway_url, offered_start, drain_timeout=None, drain_deadline=None):
   482	    """``replay`` body; the drain deadline is offered_end + drain_timeout or the caller's absolute drain_deadline.
   483	
   484	    Every request task is cancelled and awaited before returning or raising (a cancelled gather defers the
   485	    caller's CancelledError until all of its children are done)."""
   486	    if len(records) != len(trace['requests']):
   487	        raise ClientRefusal('records must cover the offered trace one-to-one')
   488	    if not time.monotonic() < offered_start:
   489	        raise ClientRefusal('offered_start already passed: absolute offsets cannot be honoured (no rescheduling)')
   490	    url = gateway_url.rstrip('/') + CHAT_PATH
   491	    tasks = [asyncio.create_task(_request(client, url, trace['model'], request, record))
   492	             for request, record in zip(trace['requests'], records)]
   493	    offered_end = offered_start + trace['duration_seconds']
   494	    deadline = offered_end + drain_timeout if drain_deadline is None else drain_deadline
   495	    try:
   496	        while (now := time.monotonic()) < offered_end:
   497	            await asyncio.sleep(offered_end - now)
   498	        pending = [task for task in tasks if not task.done()]
   499	        if pending:
   500	            await asyncio.wait(pending, timeout=max(0.0, deadline - time.monotonic()))
   501	    finally:
   502	        for task in tasks:
   503	            task.cancel()
   504	        await asyncio.gather(*tasks, return_exceptions=True)
   505	    return deadline
   506	
