   663	def test_library_cancellation_and_failure_keep_every_allocated_offer_after_joining_requests(tmp_path):
   664	    prepared = lib_prepare(tmp_path, 'cancel', ['stop', 'hang', 'stop'], [0.0, 0.05, 0.6], duration=1.0)
   665	    seen = []
   666	
   667	    async def scenario():
   668	        start = time.monotonic() + 0.2
   669	        task = asyncio.create_task(nc.capture_replay(
   670	            prepared, offered_start=start, deadline=start + 3.0, cleanup_reserve_s=0.5,
   671	            clock_domain=nc.clock_domain(), transport=httpx.MockTransport(make_handler(seen))))
   672	        await asyncio.sleep(max(0.0, start + 0.3 - time.monotonic()))
   673	        for _ in range(3):  # repeated caller cancellation while the request tasks are being joined
   674	            task.cancel()
   675	            await asyncio.sleep(0)
   676	        with pytest.raises(asyncio.CancelledError):
   677	            await task
   678	        left = [other for other in asyncio.all_tasks() if other is not asyncio.current_task()]
   679	        frozen = json.dumps(prepared.capture, sort_keys=True)
   680	        await asyncio.sleep(max(0.0, start + 0.75 - time.monotonic()))  # past r02's scheduled send
   681	        return left, frozen
   682	
   683	    left, frozen = asyncio.run(scenario())
   684	    capture = prepared.capture
   685	    assert (left, json.dumps(capture, sort_keys=True), len(seen)) == ([], frozen, 3)
   686	    assert (capture['status'], capture['error']) == ('interrupted', 'CancelledError: replay interrupted')
   687	    assert [(record['fate'], record['fate_reason']) for record in capture['records']] == [
   688	        ('complete', 'complete'), ('cancelled', 'response_body'), ('not_launched', 'cancelled_before_send')]
   689	    assert capture['rows'] == [nc.normalized_row(record) for record in capture['records']]
   690	    assert (capture['summary']['offered'], capture['summary']['sent']) == (3, 2)
   691	    with pytest.raises(nc.ClientRefusal, match='preserved as failure evidence'):
   692	        nc.build_run(capture, control_missing='interrupted')
   693	    failed = lib_replay(lib_prepare(tmp_path, 'closefail', ['stop'], [0.0]), CloseFails(make_handler([])))
   694	    assert (failed['status'], failed['error']) == ('failed', 'RuntimeError: literal transport close failure')
   695	    assert [record['fate'] for record in failed['records']] == ['complete'] and failed['summary']['offered'] == 1
   696	    assert failed['rows'] == [nc.normalized_row(record) for record in failed['records']]
