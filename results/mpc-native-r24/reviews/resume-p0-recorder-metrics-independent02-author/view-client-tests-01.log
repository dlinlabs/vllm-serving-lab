    92	def parse(lines):
    93	    stream = nc.StreamParse()
    94	    for at, line in enumerate(lines, start=1):
    95	        stream.feed(line, float(at))
    96	    return stream.result()
    97	
    98	
    99	async def _body(lines, hang):
   100	    for line in lines:
   101	        yield (line + '\n\n').encode()
   102	    if hang:
   103	        await asyncio.sleep(30)
   104	
   105	
   106	def sse(lines, hang=False):
   107	    return httpx.Response(200, headers={'content-type': 'text/event-stream', 'x-request-id': 'gw-1'},
   108	                          content=_body(lines, hang))
   109	
   110	
   111	def refuse_connect(request):
   112	    raise httpx.ConnectError('literal connection refused', request=request)
   113	
   114	
   115	def interrupt(request):
   116	    os.kill(os.getpid(), signal.SIGINT)
   117	    return sse([chunk('a')], hang=True)
