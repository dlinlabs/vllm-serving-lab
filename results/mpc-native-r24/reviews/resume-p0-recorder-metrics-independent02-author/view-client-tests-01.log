   316	def test_external_cancel_keeps_unsent_request_not_launched():
   317	    trace = tw.validate_trace(make_trace(['stop', 'stop'], [0.0, 0.6], duration=1.0))
   318	
   319	    async def scenario():
   320	        async with httpx.AsyncClient(transport=httpx.MockTransport(make_handler([]))) as client:
   321	            start = time.monotonic() + 0.05
   322	            records = nc.prepare_records(trace, start, RUN_ID)
   323	            task = asyncio.create_task(nc.replay(client, trace, records, gateway_url=GATEWAY, offered_start=start,
   324	                                                 drain_timeout=0.5))
   325	            await asyncio.sleep(0.3)
   326	            task.cancel()
   327	            with pytest.raises(asyncio.CancelledError):
   328	                await task
   329	            return start, records
   330	
   331	    start, records = asyncio.run(scenario())
   332	    assert records[0]['fate'] == 'complete'
   333	    assert (records[1]['fate'], records[1]['fate_reason'], records[1]['sent_at']) == (
   334	        'not_launched', 'cancelled_before_send', None)
   335	    assert run_metrics(records, start, 1.0)['outcomes']['fates']['not_launched'] == 1
