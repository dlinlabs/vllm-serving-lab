   143	def make_handler(seen, models=None):
   144	    async def handler(request):
   145	        if request.method == 'GET' and request.url.path == nc.MODELS_PATH:
   146	            seen.append(('models', str(request.url)))
   147	            return httpx.Response(200, json=MODELS if models is None else models)
   148	        body = json.loads(request.content)
   149	        seen.append((body, dict(request.headers), str(request.url)))
   150	        return BEHAVIOR[body['messages'][0]['content']](request)
   151	    return handler
