   217	def _replay(trace, seen, lead=0.05, drain=0.3, before=None):
   218	    async def scenario():
   219	        async with httpx.AsyncClient(transport=httpx.MockTransport(make_handler(seen))) as client:
   220	            start = time.monotonic() + lead
   221	            records = nc.prepare_records(trace, start, RUN_ID)
   222	            helper = asyncio.create_task(before(start)) if before else None
   223	            deadline = await nc.replay(client, trace, records, gateway_url=GATEWAY, offered_start=start,
   224	                                       drain_timeout=drain)
   225	            if helper:
   226	                await helper
   227	            return start, records, deadline
   228	    return asyncio.run(scenario())
