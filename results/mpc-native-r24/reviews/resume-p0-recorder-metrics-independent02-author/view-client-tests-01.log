   208	@pytest.mark.parametrize('name', sorted(PARSE_CASES))
   209	def test_stream_parse_literal_edge_cases(name):
   210	    lines, finish, evidence, anomalies, tokens, tokens_evidence = PARSE_CASES[name]
   211	    result = parse(lines)
   212	    assert (result['finish_reason'], result['finish_reason_evidence'], result['anomalies'],
   213	            result['completion_tokens'], result['completion_tokens_evidence']) == (
   214	        finish, evidence, anomalies, tokens, tokens_evidence)
