   450	def cli_replay(tmp_path, name, prompts, arrivals, *, purpose='train', declared=None, arm='fixed16', binding=True,
   451	               models=None, extra=()):
   452	    trace_path = write_json(tmp_path / f'{name}.trace.json', make_trace(prompts, arrivals, 0.4, purpose))
   453	    binding_path = tmp_path / f'{name}.binding.json'
   454	    if binding:
   455	        write_json(binding_path, make_binding())
   456	    out, seen = tmp_path / name, []
   457	    code = nc.main(['replay', '--trace', trace_path, '--binding', str(binding_path), '--gateway-url', GATEWAY,
   458	                    '--backend-url', BACKEND, '--arm', arm, '--purpose', declared or purpose, '--output-dir',
   459	                    str(out), '--start-delay', '0.3', '--drain-timeout', '0.5', *extra],
   460	                   transport=httpx.MockTransport(make_handler(seen, models)),
   461	                   tokenizer_loader=lambda path: FakeTokenizer() if path == LOCAL else None)
   462	    capture_path = out / 'capture.json'
   463	    return code, json.loads(capture_path.read_text()) if capture_path.exists() else None, seen, capture_path
