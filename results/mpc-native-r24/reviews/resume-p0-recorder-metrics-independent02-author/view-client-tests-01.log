   120	# Literal shape of the root gateway.py (0b1a80ad lines 653-692) admission 503 body; values are CPU literals.
   121	GATEWAY_REJECTION = {'detail': nc.ADMISSION_DETAIL, 'estimated_request_cost': 1.5, 'estimated_input_tokens': 9,
   122	                     'estimated_output_tokens': 8, 'max_admitted_cost': 16.0, 'budget_version': 3}
   123	REJECTION_TEXT = json.dumps(GATEWAY_REJECTION, separators=(',', ':'))
   124	
   125	
   126	async def _failing_body():
   127	    yield b'{"detail":'
   128	    raise httpx.ReadError('literal body read failure')
   129	
   130	
   131	BEHAVIOR = {
   132	    'stop': lambda request: sse(STOP), 'length': lambda request: sse(LENGTH),
   133	    'admission': lambda request: httpx.Response(503, headers={'x-request-id': 'gw-rejected'},
   134	                                                content=REJECTION_TEXT.encode()),
   135	    'busy': lambda request: httpx.Response(503, json={'detail': 'overloaded'}),
   136	    'server': lambda request: httpx.Response(500, text='literal failure'),
   137	    'bodyfail': lambda request: httpx.Response(503, content=_failing_body()),
   138	    'connect': refuse_connect, 'nodone': lambda request: sse(STOP[:-1]),
   139	    'hang': lambda request: sse([chunk('a')], hang=True), 'interrupt': interrupt,
   140	}
   141	
