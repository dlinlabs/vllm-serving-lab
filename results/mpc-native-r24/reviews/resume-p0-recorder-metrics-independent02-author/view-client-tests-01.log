   269	def test_rejection_body_retention_is_verbatim_and_never_invented():
   270	    partial = {'detail': nc.ADMISSION_DETAIL, 'estimated_request_cost': 2.0, 'budget_version': 7}
   271	    assert nc._admission_rejection(503, json.dumps(partial).encode()) == dict(
   272	        partial, estimated_input_tokens=None, estimated_output_tokens=None, max_admitted_cost=None,
   273	        fields_absent=['estimated_input_tokens', 'estimated_output_tokens', 'max_admitted_cost'])
   274	    assert nc._admission_rejection(500, REJECTION_TEXT.encode()) is None
   275	    assert nc._admission_rejection(503, json.dumps(dict(GATEWAY_REJECTION, detail='overloaded')).encode()) is None
   276	    big = b'x' * nc.MAX_RETAINED_BODY_BYTES
   277	    assert nc._retained_body(big) == (big.decode(), None)
   278	    assert nc._retained_body(big + b'x') == (None, 'over_65536_bytes')
   279	    assert nc._retained_body(b'\xff literal') == (None, 'not_utf8')
   280	    prompts = ['busy', 'server', 'bodyfail', 'stop']
   281	    trace = tw.validate_trace(make_trace(prompts, [0.0, 0.01, 0.02, 0.03], duration=0.1))
   282	    records = dict(zip(prompts, _replay(trace, [])[1]))
   283	    busy, server, failed, stop = (records[prompt] for prompt in prompts)
   284	    assert (busy['fate'], busy['rejection'], json.loads(busy['body_text'])) == (
   285	        'http_error', None, {'detail': 'overloaded'})
   286	    assert busy['body_sha256'] == hashlib.sha256(busy['body_text'].encode()).hexdigest()
   287	    assert (server['body_text'], server['body_text_null_reason']) == ('literal failure', None)
   288	    assert (failed['fate'], failed['fate_reason'], failed['http_status'], failed['body_text'],
   289	            failed['body_text_null_reason'], failed['body_bytes']) == (
   290	        'transport_error', 'response_body', 503, None, 'body_read_incomplete', None)
   291	    assert (stop['body_text'], stop['body_text_null_reason']) == (None, 'not_applicable')
