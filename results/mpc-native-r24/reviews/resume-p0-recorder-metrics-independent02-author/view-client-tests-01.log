    68	def make_comparability(ignore_eos=False, **model_changes):
    69	    model = {'local_model_path': LOCAL, 'asset_sha256': '1' * 64, 'served_alias': ALIAS,
    70	             'served_alias_verified': True, 'tokenizer_sha256': FINGERPRINT}
    71	    return {'hardware': {'gpu': 'literal CPU control'}, 'model': dict(model, **model_changes),
    72	            'backend': {'argv': 'literal'}, 'gateway': {'source_sha256': '2' * 64}, 'resources': {'cpu': 'literal'},
    73	            'code': {'client': 'literal'}, 'client_generation': {'ignore_eos': ignore_eos,
    74	                                                                 'max_tokens_policy': 'trace max_tokens'},
