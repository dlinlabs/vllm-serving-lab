   563	def lib_prepare(tmp_path, name, prompts, arrivals, duration=0.4, *, purpose='train', **binding_changes):
   564	    trace_path = write_json(tmp_path / f'{name}.trace.json', make_trace(prompts, arrivals, duration, purpose))
   565	    binding_path = write_json(tmp_path / f'{name}.binding.json', make_binding(**binding_changes))
   566	    return nc.prepare_capture(trace_path=trace_path, binding_path=binding_path, arm='mpc', purpose=purpose,
   567	                              gateway_url=GATEWAY, backend_url=BACKEND,
   568	                              tokenizer_loader=lambda path: FakeTokenizer() if path == LOCAL else None)
