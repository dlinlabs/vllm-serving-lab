    46	def make_trace(prompts, arrivals, duration=1.0, purpose='train', cap=8):
    47	    return {
    48	        'schema_version': 1, 'model': ALIAS, 'max_model_len': 8192, 'duration_seconds': duration, 'output_cap': cap,
    49	        'requests': [{'trace_id': f'r{index:02d}', 'arrival_seconds': arrival, 'input_tokens': len(prompt) + 4,
    50	                      'max_tokens': cap, 'prompt': prompt}
    51	                     for index, (prompt, arrival) in enumerate(zip(prompts, arrivals))],
    52	        'provenance': {'purpose': purpose, 'tokenizer_sha256': FINGERPRINT},
    53	    }
