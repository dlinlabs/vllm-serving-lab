    78	def chunk(content=None, finish=None, index=0, usage=None, choices=True):
    79	    event = {'id': 'c', 'object': 'chat.completion.chunk', 'choices': [], 'usage': usage}
    80	    if choices:
    81	        delta = {} if content is None else {'content': content}
    82	        event['choices'] = [{'index': index, 'delta': delta, 'finish_reason': finish}]
    83	    return 'data: ' + json.dumps(event)
    84	
    85	
    86	ROLE = 'data: ' + json.dumps({'choices': [{'index': 0, 'delta': {'role': 'assistant', 'content': ''},
    87	                                           'finish_reason': None}]})
    88	STOP = [ROLE, chunk('Hi'), chunk(' there', 'stop'), chunk(usage=USAGE, choices=False), DONE]
    89	LENGTH = [chunk('a'), chunk('b', 'length'), chunk(usage=USAGE, choices=False), DONE]
    90	
