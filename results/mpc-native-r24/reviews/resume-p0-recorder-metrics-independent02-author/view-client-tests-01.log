   154	def run_metrics(records, start, duration, arm='fixed16'):
   155	    rows = [nc.normalized_row(record) for record in records]
   156	    end = max([start + duration] + [row['terminal_at'] for row in rows if row['terminal_at'] is not None])
   157	    control = {'kind': 'static_fixed', 'budget': 16.0, 'basis': 'literal'} if arm == 'fixed16' else None
   158	    return nm.compute({
   159	        'arm': arm, 'purpose': 'train', 'clock_domain': 'literal', 'offered_start': start,
   160	        'offered_duration_s': duration, 'envelope_start': start, 'envelope_end': end,
   161	        'envelope_scope': 'offered_cohort_observed', 'rows': rows, 'slo_missing': None, 'control': control,
   162	        'control_missing': None if control else 'literal: no controller',
   163	        'provenance': {'offered_trace_sha256': 'x', 'offered_count': len(rows),
   164	                       'offered_request_ids_sha256': nm.request_ids_sha256(row['request_id'] for row in rows)},
   165	    })
