   571	def lib_replay(prepared, transport, **change):
   572	    """capture_replay awaited in a fresh loop; change values may be callables of the planned offered start."""
   573	    async def scenario():
   574	        start = time.monotonic() + 0.2
   575	        kwargs = dict(offered_start=start, deadline=start + 1.0, cleanup_reserve_s=0.1, clock_domain=nc.clock_domain())
   576	        kwargs.update({key: value(start) if callable(value) else value for key, value in change.items()})
   577	        return await nc.capture_replay(prepared, transport=transport, **kwargs)
   578	    return asyncio.run(scenario())
   579	
   580	
   581	def test_library_capture_inside_running_loop_keeps_caller_clock_and_cli_envelope(tmp_path):
   582	    prepared = lib_prepare(tmp_path, 'lib', ['stop', 'admission', 'length', 'hang'], [0.0, 0.05, 0.1, 0.15])
   583	    capture, seen, beats = prepared.capture, [], []
   584	    assert (prepared.ready, capture['status'], capture['error'], capture['records']) == (
   585	        True, 'failed', nc.NOT_RUN_ERROR, None)
   586	    assert capture['binding_evidence']['tokenizer']['prompts_verified'] == 4
   587	
   588	    def handlers():
   589	        return signal.getsignal(signal.SIGINT), signal.getsignal(signal.SIGTERM)
   590	
   591	    async def scenario():
   592	        inside = handlers()
   593	
   594	        async def heartbeat():
   595	            while True:
   596	                beats.append((time.monotonic(), handlers()))
   597	                await asyncio.sleep(0.02)
   598	
   599	        beat = asyncio.create_task(heartbeat())
   600	        start = time.monotonic() + 0.3
   601	        result = await nc.capture_replay(prepared, offered_start=start, deadline=start + 1.2, cleanup_reserve_s=0.5,
   602	                                         clock_domain=nc.clock_domain(),
   603	                                         transport=httpx.MockTransport(make_handler(seen)))
   604	        left = [task for task in asyncio.all_tasks() if task not in (beat, asyncio.current_task())]
   605	        beat.cancel()
   606	        await asyncio.gather(beat, return_exceptions=True)
   607	        return start, inside, result, left
   608	
   609	    start, inside, result, left = asyncio.run(scenario())
   610	    records = capture['records']
   611	    assert result is capture and (capture['status'], capture['error'], left) == ('collected', None, [])
   612	    assert (capture['offered_start'], capture['offered_end'], capture['drain_deadline']) == (
   613	        start, start + 0.4, start + 1.2 - 0.5)
   614	    assert {key: capture['config'][key] for key in ('entry', 'driver_offered_start', 'caller_deadline',
   615	                                                    'cleanup_reserve_s', 'caller_clock_domain')} == {
   616	        'entry': 'library', 'driver_offered_start': start, 'caller_deadline': start + 1.2, 'cleanup_reserve_s': 0.5,
   617	        'caller_clock_domain': capture['clock_domain']}
   618	    assert [(record['fate'], record['fate_reason']) for record in records] == [
   619	        ('complete', 'complete'), ('rejected', 'admission_capacity_503'), ('complete', 'complete'),
   620	        ('cancelled', 'response_body')]
   621	    assert [record['scheduled_at'] for record in records] == [start + arrival for arrival in (0.0, 0.05, 0.1, 0.15)]
   622	    # the hung request is cancelled at deadline - reserve, leaving the caller's cleanup reserve unused
   623	    assert capture['drain_deadline'] - 0.01 <= records[3]['terminal_at'] < start + 1.2
   624	    assert capture['rows'] == [nc.normalized_row(record) for record in records]
   625	    assert capture['summary'] == nc.summarize_records(records)
   626	    assert seen[0] == ('models', BACKEND + nc.MODELS_PATH) and len(seen) == 5
   627	    assert {sample for _, sample in beats} == {inside}  # no signal handler installed or removed
   628	    assert beats[0][0] < start and beats[-1][0] > capture['offered_end']  # the caller's own task kept running
   629	    digest = nc.write_capture(tmp_path / 'lib.capture.json', capture)
   630	    data = (tmp_path / 'lib.capture.json').read_bytes()
   631	    assert digest == hashlib.sha256(data).hexdigest() and json.loads(data) == capture
   632	    with pytest.raises(FileExistsError):
   633	        nc.write_capture(tmp_path / 'lib.capture.json', capture)
   634	    metrics = nm.compute(nc.build_run(json.loads(data), control_missing='literal: no controller journal'))
   635	    assert metrics['all_offered'] == 4 and metrics['outcomes']['fates']['cancelled'] == 1
   636	    cli = cli_replay(tmp_path, 'cli', ['stop'], [0.0], arm='mpc')[1]
   637	    assert set(cli) == set(capture) and set(cli['config']) < set(capture['config'])
   638	    frozen, sent = json.dumps(capture, sort_keys=True), []
   639	    for name, change, match in (('truncated', {'deadline': lambda planned: planned + 0.45}, 'never truncated'),
   640	                                ('passed', {'offered_start': lambda planned: planned - 0.5}, 'no rescheduling'),
   641	                                ('domain', {'clock_domain': 'literal other host'}, 'clock_domain differs'),
   642	                                ('nan', {'cleanup_reserve_s': float('nan')}, 'finite'),
   643	                                ('negative', {'cleanup_reserve_s': -0.1}, 'finite')):
   644	        refused = lib_replay(lib_prepare(tmp_path, name, ['stop'], [0.0]), httpx.MockTransport(make_handler(sent)),
   645	                             **change)
   646	        assert (refused['status'], refused['records'], sent) == ('refused', None, []) and match in refused['error']
   647	        nc.write_capture(tmp_path / f'{name}.capture.json', refused)
   648	    unbound = lib_prepare(tmp_path, 'unbound', ['stop'], [0.0], served_alias='other/alias')
   649	    assert (unbound.ready, unbound.capture['status']) == (False, 'refused')
   650	    assert 'served_alias' in unbound.capture['error']
   651	    assert lib_prepare(tmp_path, 'heldout', ['stop'], [0.0], purpose='heldout').capture['status'] == 'refused'
   652	    for unusable in (unbound, prepared):
   653	        with pytest.raises(nc.ClientRefusal, match='ready, unused'):
   654	            lib_replay(unusable, httpx.MockTransport(make_handler(sent)))
   655	    assert sent == [] and json.dumps(capture, sort_keys=True) == frozen
