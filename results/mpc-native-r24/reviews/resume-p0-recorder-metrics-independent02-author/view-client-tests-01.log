   294	def test_blocked_loop_sends_late_with_recorded_lag_never_early_or_retimed():
   295	    trace = tw.validate_trace(make_trace(['stop', 'stop'], [0.0, 0.05], duration=0.1))
   296	
   297	    async def block(start):
   298	        await asyncio.sleep(max(0.0, start - 0.001 - time.monotonic()))
   299	        time.sleep(0.15)
   300	
   301	    start, records, _ = _replay(trace, [], drain=0.5, before=block)
   302	    assert [record['fate'] for record in records] == ['complete', 'complete']
   303	    assert [record['scheduled_at'] for record in records] == [start, start + 0.05]
   304	    assert records[0]['send_lag_s'] >= 0.14 and records[1]['send_lag_s'] >= 0.09
   305	    assert all(record['sent_at'] >= record['scheduled_at'] for record in records)
