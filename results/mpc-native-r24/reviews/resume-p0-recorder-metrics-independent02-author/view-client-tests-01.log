   338	def test_literal_records_map_to_unchanged_natural_slo_with_all_offered_denominator():
   339	    trace = make_trace(['a' * 10, 'b' * 600, 'c' * 3000], [0.0, 0.1, 0.2], duration=1.0, cap=128)
   340	    records = nc.prepare_records(trace, 100.0, RUN_ID)
   341	    for record, lines, sent, terminal in (
   342	            (records[0], [(100.2, chunk('Hi')), (100.22, chunk('!', 'stop')),
   343	                          (100.23, chunk(usage=USAGE, choices=False)), (100.235, DONE)], 100.01, 100.24),
   344	            (records[1], [(100.4, chunk('a')), (100.45, chunk('b', 'length')),
   345	                          (100.46, chunk(usage={'completion_tokens': 3}, choices=False)), (100.465, DONE)],
   346	             100.11, 100.47)):
   347	        stream = nc.StreamParse()
   348	        for at, line in lines:
   349	            stream.feed(line, at)
   350	        nc._apply(record, stream.result())
   351	        record.update(sent_at=sent, send_lag_s=sent - record['scheduled_at'], terminal_at=terminal,
   352	                      fate='complete', fate_reason='complete')
   353	    rows = [nc.normalized_row(record) for record in records]
   354	    capture = {
   355	        'schema': nc.SCHEMA, 'status': 'collected', 'arm': 'mpc', 'purpose': 'train', 'records': records,
   356	        'rows': rows, 'clock_domain': 'literal', 'offered_start': 100.0, 'offered_duration_s': 1.0,
   357	        'collection_end': 101.2, 'trace_sha256': 'f' * 64, 'trace_provenance': {}, 'run_id': RUN_ID,
   358	        'binding_evidence': None, 'sources_sha256': {}, 'summary': nc.summarize_records(records),
   359	        'offered_count': 3,
   360	        'offered_request_ids_sha256': nm.request_ids_sha256(request['trace_id'] for request in trace['requests']),
   361	    }
   362	    for change, match in (({'offered_count': 4}, 'all-offered cohort: 3 rows'),
   363	                          ({'offered_request_ids_sha256': nm.request_ids_sha256(['r00', 'r02', 'r01'])},
   364	                           'request ids')):
   365	        with pytest.raises(nc.ClientRefusal, match=match):
   366	            nc.build_run(dict(capture, **change), control_missing='literal: no controller journal')
   367	    with pytest.raises(nc.ClientRefusal, match='comparability contradicts'):
   368	        nc.build_run(capture, control_missing='literal', comparability=make_comparability())
   369	    assert capture['summary']['finish_reasons_of_complete'] == {'stop': 1, 'length': 1}
   370	    metrics = nm.compute(nc.build_run(capture, control_missing='literal: no controller journal'))
   371	    assert metrics['natural_slo']['natural_slo_good'] == 1
   372	    assert metrics['natural_slo']['slo_attainment_fraction'] == pytest.approx(1 / 3)
   373	    assert metrics['outcomes']['fates']['not_launched'] == 1 and metrics['windows']['envelope_end'] == 101.0
   374	    assert metrics['ttft_s']['all_offered_penalized_scheduled']['n'] == 3
   375	    assert metrics['controller_overhead']['null_reason'] == 'literal: no controller journal'
   376	    assert {name: block['n_offered'] for name, block in metrics['groups'].items()} == {
   377	        'le512': 1, '513to2048': 1, 'gt2048': 1}
