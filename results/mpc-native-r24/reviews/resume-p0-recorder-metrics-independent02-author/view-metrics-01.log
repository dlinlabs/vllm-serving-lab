   985	def _strict_json(data, name):
   986	    def pairs(items):
   987	        keys = [key for key, _ in items]
   988	        if len(keys) != len(set(keys)):
   989	            raise AdapterRefusal(f'{name}: duplicate JSON object key')
   990	        return dict(items)
   991	
   992	    def constant(token):
   993	        raise AdapterRefusal(f'{name}: non-finite JSON constant {token}')
   994	
   995	    try:
   996	        return json.loads(data, object_pairs_hook=pairs, parse_constant=constant)
   997	    except AdapterRefusal:
   998	        raise
   999	    except ValueError as exc:
  1000	        raise AdapterRefusal(f'{name}: not JSON') from exc
