   469	def _throughput(run, rows, envelope_s):
   470	    duration = run['offered_duration_s']
   471	    delivered = [row for row in rows if row['fate'] == 'complete']
   472	    missing = [row for row in delivered if row['completion_tokens'] is None]
   473	    observed = sum(row['completion_tokens'] for row in delivered if row['completion_tokens'] is not None)
   474	    upper = observed + sum(row['max_output_tokens'] for row in missing)
   475	
   476	    def per_second(window):
   477	        return {'lower': observed / window, 'upper': upper / window, 'exact': not missing}
   478	
   479	    return {
   480	        'delivered_definition': 'fate complete (client success; includes length-capped completions)',
   481	        'delivered': len(delivered), 'offered_rps': len(rows) / duration,
   482	        'cohort_normalized_delivered_rps': len(delivered) / duration, 'cohort_label': COHORT_LABEL,
   483	        'wall_envelope_delivered_rps': len(delivered) / envelope_s,
   484	        'wall_envelope_label': ENVELOPE_LABELS[run['envelope_scope']], 'wall_envelope_scope': run['envelope_scope'],
   485	        'wall_rate_direction': WALL_RATE_DIRECTION[run['envelope_scope']], 'token_rate_scope': TOKEN_RATE_SCOPE,
   486	        'completion_tokens_observed': observed, 'completion_tokens_missing_usage_rows': len(missing),
   487	        'completion_tokens_upper_bound': upper,
   488	        'bounds_rule': 'lower = observed endpoint usage; upper adds max_output_tokens per delivered row lacking usage; '
   489	                       'no chunk-count or max_tokens substitution as a point value',
   490	        'cohort_normalized_completion_tokens_per_s': per_second(duration),
   491	        'wall_envelope_completion_tokens_per_s': per_second(envelope_s),
   492	        'undelivered_reported_completion_tokens': sum(row['completion_tokens'] for row in rows
   493	                                                      if row['fate'] != 'complete'
   494	                                                      and row['completion_tokens'] is not None),
   495	    }
