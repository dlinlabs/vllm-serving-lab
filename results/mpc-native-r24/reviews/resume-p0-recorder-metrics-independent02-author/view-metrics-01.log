   786	def summarize(metrics):
   787	    ttft = metrics['ttft_s']
   788	
   789	    def q(block):
   790	        return {key: block[key] for key in ('n', 'p50', 'p95', 'p99', 'p95_is_sample_max', 'p99_is_sample_max',
   791	                                            'n_failure_penalty')}
   792	
   793	    natural, throughput, overhead = metrics['natural_slo'], metrics['throughput'], metrics['controller_overhead']
   794	    fairness = metrics['fairness']
   795	    return {
   796	        'all_offered': metrics['all_offered'], 'envelope_scope': metrics['windows']['envelope_scope'],
   797	        'fates': metrics['outcomes']['fates'],
   798	        'rejection_rate': metrics['outcomes']['rejection_rate'], 'failure_rate': metrics['outcomes']['failure_rate'],
   799	        'not_launched_rate': metrics['outcomes']['not_launched_rate'],
   800	        'unknown_rate': metrics['outcomes']['unknown_rate'],
   801	        'ttft_conditional_scheduled': q(ttft['conditional_scheduled']),
   802	        'ttft_conditional_client_send': q(ttft['conditional_client_send']),
   803	        'ttft_all_offered_penalized_scheduled': q(ttft['all_offered_penalized_scheduled']),
   804	        'ttft_all_offered_penalized_client_send': q(ttft['all_offered_penalized_client_send']),
   805	        'natural_slo_available': natural['available'], 'natural_slo_null_reason': natural['null_reason'],
   806	        'natural_slo_good': natural['natural_slo_good'], 'slo_attainment_fraction': natural['slo_attainment_fraction'],
   807	        'cohort_slo_goodput_rps': natural['cohort_slo_goodput_rps'],
   808	        'wall_envelope_slo_goodput_rps': natural['wall_envelope_slo_goodput_rps'],
   809	        'cohort_normalized_delivered_rps': throughput['cohort_normalized_delivered_rps'],
   810	        'wall_envelope_delivered_rps': throughput['wall_envelope_delivered_rps'],
   811	        'cohort_normalized_completion_tokens_per_s': throughput['cohort_normalized_completion_tokens_per_s'],
   812	        'wall_envelope_completion_tokens_per_s': throughput['wall_envelope_completion_tokens_per_s'],
   813	        'jain_slo_attainment': metrics['fairness']['slo_attainment_fraction']['jain'],
   814	        'jain_delivered_fraction': metrics['fairness']['delivered_fraction']['jain'],
   815	        'controller_decisions': overhead['decisions'], 'controller_union_within_envelope_s':
   816	            overhead['union_within_envelope_s'], 'controller_overhead_null_reason': overhead.get('null_reason'),
   817	        'send_lag_min_s': metrics['send_lag_s']['min'], 'send_lag_n_negative': metrics['send_lag_s']['n_negative'],
   818	        'wall_rate_direction': throughput['wall_rate_direction'], 'token_rate_scope': throughput['token_rate_scope'],
   819	        'group_k': fairness['delivered_fraction']['k'],
   820	        'n_offered_by_group': fairness['delivered_fraction']['n_offered_by_group'],
   821	        'worst_group_rejection_rate': fairness['worst_group_rejection_rate'],
   822	        'worst_group_rejection_rate_group': fairness['worst_group_rejection_rate_group'],
   823	        'worst_group_rejection_rate_n': fairness['worst_group_rejection_rate_n'], 'fairness_note': JAIN_NOTE,
   824	        'comparability_status': metrics['comparability']['status'],
   825	        'comparability_sha256': metrics['comparability']['sha256'],
