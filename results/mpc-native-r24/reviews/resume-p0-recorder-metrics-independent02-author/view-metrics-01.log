   557	def _union(intervals):
   558	    total, current = 0.0, None
   559	    for start, end in sorted(intervals):
   560	        if current is None or start > current[1]:
   561	            if current is not None:
   562	                total += current[1] - current[0]
   563	            current = [start, end]
   564	        else:
   565	            current[1] = max(current[1], end)
   566	    return total + (current[1] - current[0] if current is not None else 0.0)
   567	
