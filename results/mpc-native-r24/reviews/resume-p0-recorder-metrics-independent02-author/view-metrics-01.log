   610	def compute(run):
   611	    """Measured metrics for one arm on one offered cohort (strict normalized input)."""
   612	    validate_run(run)
   613	    rows = run['rows']
   614	    envelope_s = run['envelope_end'] - run['envelope_start']
   615	    natural, good = _natural_slo(run)
   616	    groups = _groups(rows, good)
   617	    sent = [row['sent_at'] - row['scheduled_at'] for row in rows if row['sent_at'] is not None]
   618	    return {
   619	        'schema': SCHEMA, 'lineage': LINEAGE, 'qualification': QUALIFICATION, 'arm': run['arm'],
   620	        'purpose': run['purpose'], 'claim_scope': CLAIM_SCOPE[run['purpose']], 'clock_domain': run['clock_domain'],
   621	        'offered_trace_sha256': run['provenance']['offered_trace_sha256'], 'offered_cohort': _offered_cohort(run),
   622	        'comparability': _comparability(run['provenance']),
   623	        'train_selection_sha256': run['provenance'].get('train_selection_sha256'),
   624	        'windows': {'offered_start': run['offered_start'], 'offered_duration_s': run['offered_duration_s'],
   625	                    'offered_end': run['offered_start'] + run['offered_duration_s'],
   626	                    'envelope_start': run['envelope_start'], 'envelope_end': run['envelope_end'],
   627	                    'envelope_s': envelope_s, 'envelope_scope': run['envelope_scope'],
   628	                    'envelope_scope_label': ENVELOPE_SCOPES[run['envelope_scope']],
   629	                    'full_wall_s': envelope_s if run['envelope_scope'] == 'full_wall' else None,
   630	                    'full_wall_null_reason': None if run['envelope_scope'] == 'full_wall' else
   631	                    'full wall not recorded: wall-envelope rates use the offered-cohort observed envelope'},
   632	        'all_offered': len(rows), 'outcomes': _fate_summary(rows), 'ttft_s': _ttft(rows),
   633	        'send_lag_s': dict(percentile_block(sent, 'sent_at - scheduled_at over sent rows'),
   634	                           n_not_sent=len(rows) - len(sent), min=min(sent) if sent else None,
   635	                           n_negative=sum(lag < 0 for lag in sent), early_send_tolerance_s=EARLY_SEND_TOLERANCE_S),
   636	        'natural_slo': natural, 'throughput': _throughput(run, rows, envelope_s), 'groups': groups,
   637	        'group_edges': {'le512': '<=512', '513to2048': '513..2048', 'gt2048': '>2048',
   638	                        'key': 'group_tokens (tokenizer-measured prompt tokens frozen before outcomes)'},
   639	        'fairness': _fairness(groups), 'controller_overhead': _overhead(run, envelope_s),
   640	        'fifo_label': FIFO_LABEL, 'fifo_note': FIFO_NOTE, 'provenance': run['provenance'],
   641	        'claims_not_made': list(CLAIMS_NOT_MADE),
   642	    }
