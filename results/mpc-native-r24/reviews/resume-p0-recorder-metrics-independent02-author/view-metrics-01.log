  1072	def _static_control(manifest, config, changes, start, arm):
  1073	    budget = FIXED_BUDGETS[arm]
  1074	    if config.get('budget_schedule') is not None:
  1075	        raise AdapterRefusal(f'{arm}: fixed arm must use --budget, not a --budget-schedule')
  1076	    if type(config.get('budget')) not in (int, float) or float(config['budget']) != budget:
  1077	        raise AdapterRefusal(f'{arm}: config budget {config.get("budget")!r} != {budget}')
  1078	    if not isinstance(changes, list) or len(changes) != 1 or not isinstance(changes[0], dict):
  1079	        raise AdapterRefusal(f'{arm}: static run needs exactly one budget actuation record')
  1080	    record = changes[0]
  1081	    sent = _raw_number(record.get('sent'), 'budget record sent', optional=False)
  1082	    acknowledged = _raw_number(record.get('acknowledged'), 'budget record acknowledged', optional=False)
  1083	    if not sent <= acknowledged < start or record.get('target') != start:
  1084	        raise AdapterRefusal(f'{arm}: budget not acknowledged before measurement_start')
  1085	    if record.get('status', 'acknowledged') != 'acknowledged' or record.get('requested_budget', budget) != budget:
