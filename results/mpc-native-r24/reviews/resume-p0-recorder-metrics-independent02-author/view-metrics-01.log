  1002	
  1003	def _raw_number(value, name, optional=True):
  1004	    if value is None and optional:
  1005	        return None
  1006	    if not _is_number(value):
  1007	        raise AdapterRefusal(f'{name} must be a finite number')
  1008	    return value
