   114	_SCORE_HTTP = None
   115	
   116	
   117	def score_http():
   118	    """The unchanged r23 natural-SLO scorer, executed only from bytes matching the pinned sha256."""
   119	    global _SCORE_HTTP
   120	    if _SCORE_HTTP is None:
   121	        data = SCORE_HTTP_PATH.read_bytes()
   122	        if hashlib.sha256(data).hexdigest() != SCORE_HTTP_SHA256:
   123	            raise RuntimeError('score_http.py differs from the pinned sha256; natural SLO scoring refused')
   124	        module = types.ModuleType('r23_score_http_pinned')
   125	        module.__file__ = str(SCORE_HTTP_PATH)
   126	        exec(compile(data, str(SCORE_HTTP_PATH), 'exec'), module.__dict__)
   127	        _SCORE_HTTP = module
   128	    return _SCORE_HTTP
