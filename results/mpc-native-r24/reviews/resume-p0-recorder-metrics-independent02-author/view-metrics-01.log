   701	def select_train_fixed(results):
   702	    """Empirical Train-only fixed16 vs fixed32 choice, frozen before any Eval replay.
   703	
   704	    Primary: more natural-SLO good completions (equal offered cohort, so identical to cohort goodput order);
   705	    tie 1: fewer not-delivered offered requests; tie 2: lower budget.  Refusals are returned, not raised.
   706	    Both arms need one offered cohort and identical declared comparability facts.  SELECTED binds each candidate's
   707	    metrics digest and carries its own ``selection_sha256``; freezing it before any Eval replay is a driver/commit
   708	    protocol obligation that this function cannot observe.
   709	    """
   710	    def refused(reason):
   711	        return {'schema': SELECTION_SCHEMA, 'status': 'REFUSED', 'reason': reason, 'rule': dict(SELECTION_RULE)}
   712	
   713	    if not isinstance(results, dict) or set(results) != set(FIXED_BUDGETS):
   714	        return refused('exactly fixed16 and fixed32 Train measurements are required')
   715	    for arm, metrics in results.items():
   716	        if not isinstance(metrics, dict) or metrics.get('schema') != SCHEMA or metrics.get('arm') != arm:
   717	            return refused(f'{arm}: not a {SCHEMA} result for this arm')
   718	        if metrics['purpose'] != 'train':
   719	            return refused(f'{arm}: purpose {metrics["purpose"]!r}; selection uses Train only')
   720	        overhead = metrics['controller_overhead']
   721	        if overhead.get('kind') != 'static_fixed' or overhead.get('budget') != FIXED_BUDGETS[arm]:
   722	            return refused(f'{arm}: not a verified static fixed runtime')
   723	        if not metrics['natural_slo']['available']:
   724	            return refused(f'{arm}: natural SLO unavailable ({metrics["natural_slo"]["missing"]}); no TTFT-only '
   725	                           'substitute')
   726	        error = _binding_error(metrics)
   727	        if error:
   728	            return refused(f'{arm}: {error}')
   729	    reason = _cross_arm_refusal(results)
   730	    if reason:
   731	        return refused(f'fixed16 and fixed32 are not a claim-qualified Train comparison: {reason}')
   732	    candidates = {arm: {'budget': FIXED_BUDGETS[arm], 'natural_slo_good': metrics['natural_slo']['natural_slo_good'],
   733	                        'cohort_slo_goodput_rps': metrics['natural_slo']['cohort_slo_goodput_rps'],
   734	                        'not_delivered': metrics['all_offered'] - metrics['outcomes']['delivered'],
   735	                        'metrics_sha256': _digest(metrics)}
   736	                  for arm, metrics in results.items()}
   737	    selected, decided_by = _decide(candidates)
   738	    reference = results['fixed16']
   739	    record = {'schema': SELECTION_SCHEMA, 'status': 'SELECTED', 'purpose': 'train', 'selected_arm': selected,
   740	              'selected_budget': FIXED_BUDGETS[selected], 'decided_by': decided_by, 'rule': dict(SELECTION_RULE),
   741	              'candidates': candidates, 'offered_trace_sha256': reference['offered_trace_sha256'],
   742	              'request_ids_sha256': reference['offered_cohort']['request_ids_sha256'],
   743	              'request_ids': list(reference['offered_cohort']['request_ids']),
   744	              'comparability_sha256': reference['comparability']['sha256'],
   745	              'scope': 'Train in-sample selection; must be frozen before any Eval replay; not a performance claim'}
   746	    record['selection_sha256'] = _digest(record)
   747	    return record
   748	
   749	
   750	def _verify_selection(selection):
   751	    """Raise unless ``selection`` is a complete, self-consistent select_train_fixed v2 record.
   752	
   753	    This binds declared digests only: a self-consistent record can still be fabricated, so provenance of the
   754	    candidate runs remains a driver/commit obligation.
   755	    """
   756	    if not isinstance(selection, dict) or selection.get('schema') != SELECTION_SCHEMA:
   757	        raise MetricsInputError(f'train_selection must be a {SELECTION_SCHEMA} select_train_fixed record')
   758	    if selection.get('status') == 'REFUSED':
   759	        if set(selection) != {'schema', 'status', 'reason', 'rule'} or not isinstance(selection['reason'], str) \
   760	                or not selection['reason'] or selection['rule'] != SELECTION_RULE:
   761	            raise MetricsInputError('train_selection REFUSED record is incomplete')
   762	        return
   763	    if selection.get('status') != 'SELECTED' or set(selection) != SELECTION_KEYS:
   764	        raise MetricsInputError(f'train_selection SELECTED record keys must be exactly {sorted(SELECTION_KEYS)}')
   765	    try:
   766	        digest = _digest({key: value for key, value in selection.items() if key != 'selection_sha256'})
   767	    except (TypeError, ValueError):
   768	        raise MetricsInputError('train_selection is not canonical JSON') from None
   769	    if digest != selection['selection_sha256']:
   770	        raise MetricsInputError('train_selection selection_sha256 does not match the record (tampered or forged)')
   771	    candidates = selection['candidates']
   772	    if selection['purpose'] != 'train' or selection['rule'] != SELECTION_RULE or not isinstance(candidates, dict) \
   773	            or set(candidates) != set(FIXED_BUDGETS) or any(
   774	                not isinstance(item, dict) or set(item) != CANDIDATE_KEYS or item['budget'] != FIXED_BUDGETS[arm]
   775	                or type(item['natural_slo_good']) is not int or type(item['not_delivered']) is not int
   776	                or not _is_sha(item['metrics_sha256']) for arm, item in candidates.items()):
   777	        raise MetricsInputError('train_selection purpose, rule or candidates are incomplete')
   778	    if _decide(candidates) != (selection['selected_arm'], selection['decided_by']) \
   779	            or selection['selected_budget'] != FIXED_BUDGETS[selection['selected_arm']]:
   780	        raise MetricsInputError('train_selection decision contradicts its own candidates under the unchanged rule')
   781	    if not isinstance(selection['request_ids'], list) or not _is_sha(selection['comparability_sha256']) \
   782	            or request_ids_sha256(selection['request_ids']) != selection['request_ids_sha256']:
   783	        raise MetricsInputError('train_selection cohort or comparability binding is incomplete')
