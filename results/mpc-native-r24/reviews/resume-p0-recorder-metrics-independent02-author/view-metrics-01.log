   829	def comparison_table(entries, *, purpose, train_selection=None):
   830	    """Measured comparison rows for one split; arms absent from ``entries`` are NOT_RUN.  No winner field."""
   831	    if purpose not in PURPOSES:
   832	        raise MetricsInputError(f'purpose must be one of {PURPOSES}')
   833	    if not isinstance(entries, dict) or not set(entries) <= set(RUN_ARMS):
   834	        raise MetricsInputError(f'entries must map a subset of {RUN_ARMS} (train_selected_fixed is derived)')
   835	    rows, measured = [], {}
   836	    for arm in RUN_ARMS:
   837	        entry = entries.get(arm, {'status': 'NOT_RUN', 'reason': 'not provided'})
   838	        status = entry.get('status') if isinstance(entry, dict) else None
   839	        if status == 'MEASURED':
   840	            metrics = entry.get('metrics')
   841	            if set(entry) != {'status', 'metrics'} or not isinstance(metrics, dict) or metrics.get('arm') != arm \
   842	                    or metrics.get('schema') != SCHEMA or metrics.get('purpose') != purpose:
   843	                raise MetricsInputError(f'{arm}: MEASURED entry needs this arm/split {SCHEMA} metrics')
   844	            error = _binding_error(metrics)
   845	            if error:
   846	                raise MetricsInputError(f'{arm}: {error}')
   847	            measured[arm] = metrics
   848	            rows.append({'arm': arm, 'status': status, 'reason': None, 'alias_of': None,
   849	                         'summary': summarize(metrics)})
   850	        elif status in ('REFUSED', 'NOT_RUN') and set(entry) == {'status', 'reason'} \
   851	                and isinstance(entry['reason'], str) and entry['reason']:
   852	            rows.append({'arm': arm, 'status': status, 'reason': entry['reason'], 'alias_of': None, 'summary': None})
   853	        else:
   854	            raise MetricsInputError(f'{arm}: entry status must be MEASURED, REFUSED or NOT_RUN (with reason)')
   855	    reason = _cross_arm_refusal(measured)
   856	    if reason:
   857	        raise MetricsInputError(reason)
   858	    rows.insert(2, _alias_row(train_selection, purpose, measured, rows))
   859	    reference = next(iter(measured.values()), None)
   860	    comparability = {'status': 'NO_MEASURED_ARMS', 'sha256': None, 'record': None, 'basis': COMPARABILITY_BASIS} \
   861	        if reference is None else {'status': 'DECLARED_IDENTICAL', 'sha256': reference['comparability']['sha256'],
   862	                                   'record': reference['comparability']['record'], 'basis': COMPARABILITY_BASIS}
   863	    return {'schema': SCHEMA + '-table', 'lineage': LINEAGE, 'qualification': QUALIFICATION, 'purpose': purpose,
   864	            'claim_scope': CLAIM_SCOPE[purpose],
   865	            'offered_trace_sha256': reference and reference['offered_trace_sha256'],
   866	            'all_offered': reference and reference['all_offered'],
   867	            'request_ids_sha256': reference and reference['offered_cohort']['request_ids_sha256'],
   868	            'offered_duration_s': reference and reference['windows']['offered_duration_s'],
   869	            'envelope_scope': reference and reference['windows']['envelope_scope'], 'comparability': comparability,
   870	            'rows': rows, 'fifo_label': FIFO_LABEL, 'fifo_note': FIFO_NOTE, 'claims_not_made': list(CLAIMS_NOT_MADE)}
   871	
   872	
   873	def _alias_row(selection, purpose, measured, rows):
   874	    base = {'arm': 'train_selected_fixed', 'alias_of': None, 'summary': None, 'selection': None}
   875	    if selection is None:
   876	        return dict(base, status='NOT_RUN', reason='no Train selection provided')
   877	    _verify_selection(selection)
   878	    if selection['status'] == 'REFUSED':
   879	        return dict(base, status='REFUSED', reason=f'Train selection refused: {selection["reason"]}')
   880	    target = selection['selected_arm']
   881	    base.update(alias_of=target, selection={key: selection[key] for key in (
   882	        'selection_sha256', 'decided_by', 'candidates', 'offered_trace_sha256', 'request_ids_sha256')})
   883	    if purpose == 'train':
   884	        for arm in FIXED_BUDGETS:
   885	            if arm not in measured or _digest(measured[arm]) != selection['candidates'][arm]['metrics_sha256']:
   886	                raise MetricsInputError(f'Train selection candidates are not the measured {arm} of this Train table')
   887	    elif measured:
   888	        reference = next(iter(measured.values()))
   889	        cohort = reference['offered_cohort']
   890	        if selection['offered_trace_sha256'] == reference['offered_trace_sha256'] \
   891	                or selection['request_ids_sha256'] == cohort['request_ids_sha256'] \
   892	                or set(selection['request_ids']) & set(cohort['request_ids']):
   893	            raise MetricsInputError('positive Train/Eval reuse signal: the Eval cohort shares the Train trace sha256, '
   894	                                    'request-id digest or request ids (passing this check is not disjointness proof)')
   895	        if reference['comparability']['sha256'] != selection['comparability_sha256']:
   896	            raise MetricsInputError('Eval arms differ from the Train selection comparability facts (sha256)')
   897	        recorded = {arm: metrics['train_selection_sha256'] for arm, metrics in measured.items()}
   898	        if any(value is not None and value != selection['selection_sha256'] for value in recorded.values()):
   899	            raise MetricsInputError('Eval arms record a different train_selection_sha256 than the provided selection')
   900	        unbound = sorted(arm for arm, value in recorded.items() if value is None)
   901	        if unbound:
   902	            return dict(base, status='REFUSED', reason=f'selection provenance UNVERIFIED: Eval arms {unbound} do not '
   903	                                                       'record train_selection_sha256')
   904	    source = next(row for row in rows if row['arm'] == target)
   905	    return dict(base, status='ALIAS' if source['status'] == 'MEASURED' else source['status'],
   906	                reason=source['reason'], summary=source['summary'],
   907	                note='alias of a measured static fixed arm, not an independent algorithm')
