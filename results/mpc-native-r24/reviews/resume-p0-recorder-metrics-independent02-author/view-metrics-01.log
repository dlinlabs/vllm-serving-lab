   424	            [row['first_content_at'] - row['scheduled_at'] for row in complete], CONDITIONAL_ESTIMAND),
   425	        'conditional_client_send': percentile_block(
   426	            [row['first_content_at'] - row['sent_at'] for row in complete], CONDITIONAL_ESTIMAND),
   427	        'all_offered_penalized_scheduled': percentile_block(_penalized(rows, 'scheduled_at'), PENALIZED_ESTIMAND),
   428	        'all_offered_penalized_client_send': percentile_block(_penalized(rows, 'sent_at'), PENALIZED_ESTIMAND),
