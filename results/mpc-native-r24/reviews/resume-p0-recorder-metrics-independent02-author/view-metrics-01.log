   517	def _spread(groups, key):
   518	    used = [name for name in GROUPS if groups[name]['n_offered']]
   519	    out = {'metric': key, 'groups_used': used, 'k': len(used),
   520	           'n_offered_by_group': {name: groups[name]['n_offered'] for name in used}, 'worst_min': None,
   521	           'best_max': None, 'gap': None, 'min_over_max': None, 'jain': None, 'note': JAIN_NOTE}
   522	    if len(used) < 2:
   523	        return dict(out, null_reason='fewer_than_two_nonempty_groups')
   524	    values = [groups[name][key] for name in used]
   525	    if any(value is None for value in values):
   526	        return dict(out, null_reason='metric_unavailable')
   527	    total, low, high = sum(values), min(values), max(values)
   528	    out.update(worst_min=low, best_max=high, gap=high - low, min_over_max=low / high if high else None,
   529	               jain=total * total / (len(values) * sum(value * value for value in values)) if total else None,
   530	               null_reason=None if total else 'all_zero: jain and min_over_max undefined')
   531	    return out
   532	
