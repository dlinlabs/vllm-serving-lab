   670	def _cross_arm_refusal(measured):
   671	    """None when every measured arm has one offered cohort and identical declared comparability facts."""
   672	    items = list(measured.values())
   673	    if not items:
   674	        return None
   675	
   676	    def identity(metrics):
   677	        cohort, windows = metrics['offered_cohort'], metrics['windows']
   678	        return (metrics['offered_trace_sha256'], metrics['all_offered'], cohort['request_ids_sha256'],
   679	                cohort['request_shape_sha256'], windows['offered_duration_s'], windows['envelope_scope'])
   680	
   681	    first, schedule = items[0], items[0]['offered_cohort']['relative_scheduled_s']
   682	    if any(identity(metrics) != identity(first) or any(
   683	            abs(value - other) > SCHEDULE_TOLERANCE_S
   684	            for value, other in zip(metrics['offered_cohort']['relative_scheduled_s'], schedule))
   685	           for metrics in items[1:]):
   686	        return ('measured arms differ in offered trace identity, all-offered count, request ids, request shape, '
   687	                'relative schedule, duration or envelope scope: incomparable')
   688	    undeclared = [metrics['arm'] for metrics in items if metrics['comparability']['status'] != 'DECLARED']
   689	    if undeclared:
   690	        return (f'comparability UNVERIFIED for {undeclared}: hardware/model assets/verified served alias/backend/'
   691	                'gateway/resources/code/client generation/clock facts not recorded')
   692	    reference = first['comparability']['record']
   693	    differ = [key for key in COMPARABILITY_FACTS
   694	              if any(_digest(metrics['comparability']['record'][key]) != _digest(reference[key])
   695	                     for metrics in items[1:])]
   696	    if differ:
   697	        return f'incomparable: comparability facts differ {differ}'
   698	    return None
   699	
