   131	def _is_number(value):
   132	    return type(value) in (int, float) and math.isfinite(value)
   133	
   134	
   135	def _number(value, name):
   136	    if not _is_number(value):
   137	        raise MetricsInputError(f'{name} must be a finite int/float (bool refused)')
   138	    return value
   139	
   140	
   141	def _optional_number(value, name):
   142	    return None if value is None else _number(value, name)
   143	
   144	
   145	def _nonempty_str(value, name):
   146	    if not isinstance(value, str) or not value:
   147	        raise MetricsInputError(f'{name} must be a non-empty string')
   148	    return value
   149	
   150	
   151	def _is_sha(value):
   152	    return isinstance(value, str) and len(value) == 64 and all(char in '0123456789abcdef' for char in value)
   153	
   154	
   155	def _digest(value):
   156	    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
   157	                                     allow_nan=False).encode()).hexdigest()
   158	
   159	
   160	def request_ids_sha256(request_ids):
   161	    """Ordered offered request-id digest; producers derive it from the frozen offered trace order."""
   162	    return _digest(list(request_ids))
   163	
   164	
   165	def group_of(tokens):
   166	    """Predeclared prompt-token groups (edges 512 and 2048 inclusive on the left group)."""
   167	    if tokens <= GROUP_EDGES[0]:
   168	        return GROUPS[0]
   169	    return GROUPS[1] if tokens <= GROUP_EDGES[1] else GROUPS[2]
   170	
   171	
   172	def percentile_block(values, estimand=None):
   173	    """Nearest-rank ordered[ceil(q*n/100)-1] (integer rank arithmetic); a rank on +inf yields null with a reason."""
   174	    ordered = sorted(values)
   175	    n = len(ordered)
   176	    block = {'n': n, 'method': 'nearest_rank_ceil'}
   177	    if estimand is not None:
   178	        block['estimand'] = estimand
   179	    if not n:
   180	        for q in QUANTILES:
   181	            block.update({f'p{q}': None, f'p{q}_rank': None, f'p{q}_is_sample_max': None})
   182	        block.update(max=None, n_failure_penalty=0, null_reason='no_samples')
   183	        return block
   184	    block['n_failure_penalty'] = sum(value == math.inf for value in ordered)
   185	    for q in QUANTILES:
   186	        rank = (q * n + 99) // 100
   187	        value = ordered[rank - 1]
   188	        block[f'p{q}'] = value if math.isfinite(value) else None
   189	        block[f'p{q}_rank'] = rank
   190	        block[f'p{q}_is_sample_max'] = rank == n
   191	        if not math.isfinite(value):
   192	            block[f'p{q}_null_reason'] = 'rank_falls_on_failure_penalty'
   193	    block['max'] = ordered[-1] if math.isfinite(ordered[-1]) else None
   194	    block['null_reason'] = None
   195	    return block
