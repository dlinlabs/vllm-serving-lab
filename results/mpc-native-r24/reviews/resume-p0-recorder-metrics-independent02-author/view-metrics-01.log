   569	def _overhead(run, envelope_s):
   570	    control = run['control']
   571	    scope = 'separate from TTFT/E2E/goodput (never added to request latencies); no fabricated solver cost'
   572	    if control is None:
   573	        return {'available': False, 'null_reason': run['control_missing'], 'decisions': None, 'union_total_s': None,
   574	                'union_within_envelope_s': None, 'union_fraction_of_envelope': None, 'durations_s': None,
   575	                'scope': scope}
   576	    if control['kind'] == 'static_fixed':
   577	        return {'available': True, 'kind': 'static_fixed', 'budget': control['budget'], 'basis': control['basis'],
   578	                'decisions': 0, 'union_total_s': 0.0, 'union_within_envelope_s': 0.0,
   579	                'union_fraction_of_envelope': 0.0, 'durations_s': percentile_block([]), 'scope': scope}
   580	    intervals = [tuple(item) for item in control['intervals']]
   581	    clipped = [(max(start, run['envelope_start']), min(end, run['envelope_end'])) for start, end in intervals]
   582	    within = _union([item for item in clipped if item[0] <= item[1]])
   583	    return {'available': True, 'kind': 'measured_intervals', 'source': control['source'],
   584	            'decisions': len(intervals), 'union_total_s': _union(intervals), 'union_within_envelope_s': within,
   585	            'union_fraction_of_envelope': within / envelope_s,
   586	            'durations_s': percentile_block([end - start for start, end in intervals]), 'scope': scope}
   587	
