  1111	def adapt_run_trace_pilot(output_dir, *, arm, purpose):
  1112	    """Normalized run for one static fixed arm from a run_trace_pilot.py output directory (see RAW_MAPPING)."""
  1113	    if arm not in FIXED_BUDGETS:
  1114	        raise AdapterRefusal(f'{arm!r}: run_trace_pilot hosts only static --budget or a predeclared open-loop '
  1115	                             '--budget-schedule with a process-internal admin key, so closed-loop arms need the '
  1116	                             'coordinator journal; this adapter maps fixed16/fixed32 only')
  1117	    if purpose not in PURPOSES:
  1118	        raise AdapterRefusal(f'purpose must be one of {PURPOSES}')
  1119	    out = Path(output_dir)
  1120	    data, parsed = {}, {}
  1121	    for name in RAW_FILES:
  1122	        try:
  1123	            data[name] = (out / name).read_bytes()
  1124	        except OSError as exc:
  1125	            raise AdapterRefusal(f'{name}: unreadable ({type(exc).__name__})') from exc
  1126	        parsed[name] = _strict_json(data[name], name)
  1127	    manifest, client, trace, changes = (parsed[name] for name in RAW_FILES)
  1128	    if not isinstance(manifest, dict) or manifest.get('schema_version') != 1:
  1129	        raise AdapterRefusal('manifest.json: schema_version must be 1')
  1130	    if manifest.get('status') != 'collected':
  1131	        raise AdapterRefusal(f'manifest status {manifest.get("status")!r} != collected '
  1132	                             f'(error {manifest.get("error")!r}); failed captures are refused, not rescored')
  1133	    config = manifest.get('config')
  1134	    if not isinstance(config, dict):
  1135	        raise AdapterRefusal('manifest.json: config missing')
  1136	    if hashlib.sha256(data['trace.json']).hexdigest() != manifest.get('trace_sha256'):
  1137	        raise AdapterRefusal('trace.json sha256 differs from manifest.trace_sha256')
  1138	    if not isinstance(trace, dict) or trace.get('schema_version') != 1 or not isinstance(trace.get('requests'), list) \
  1139	            or not trace['requests'] or not _is_number(trace.get('duration_seconds')):
  1140	        raise AdapterRefusal('trace.json: not a schema_version 1 replay trace')
  1141	    for index, request in enumerate(trace['requests']):
  1142	        if not isinstance(request, dict) or set(request) != TRACE_REQUEST_KEYS \
  1143	                or not _is_number(request['arrival_seconds']) or type(request['input_tokens']) is not int \
  1144	                or type(request['max_tokens']) is not int:
  1145	            raise AdapterRefusal(f'trace request {index}: not a schema_version 1 request')
  1146	    provenance = trace.get('provenance')
  1147	    if not isinstance(provenance, dict) or provenance.get('offered_tape_schema') != OFFERED_TAPE_SCHEMA:
  1148	        raise AdapterRefusal(f'trace.json: provenance is not a nominal {OFFERED_TAPE_SCHEMA} replay')
  1149	    if provenance.get('purpose') != purpose:
  1150	        raise AdapterRefusal(f'trace provenance purpose {provenance.get("purpose")!r} != declared {purpose!r}')
  1151	    if config.get('cache_policy') != 'disabled':
  1152	        raise AdapterRefusal(f'cache_policy {config.get("cache_policy")!r}: protocol requires disabled')
  1153	    _model_fidelity(manifest, trace)
  1154	    start = _raw_number(manifest.get('measurement_start'), 'measurement_start', optional=False)
  1155	    end = _raw_number(manifest.get('measurement_end'), 'measurement_end', optional=False)
  1156	    if abs((end - start) - trace['duration_seconds']) > 1e-6:
  1157	        raise AdapterRefusal('measurement window differs from the trace duration')
  1158	    if not isinstance(client, dict) or set(client) != {'requests'} or not isinstance(client['requests'], list) \
  1159	            or len(client['requests']) != len(trace['requests']):
  1160	        raise AdapterRefusal('client.json: request rows do not cover the offered trace one-to-one')
  1161	    rows = [_map_row(raw, request, start, index)
  1162	            for index, (raw, request) in enumerate(zip(client['requests'], trace['requests']))]
  1163	    control = _static_control(manifest, config, changes, start, arm)
  1164	    error_types = {}
  1165	    for raw in client['requests']:
  1166	        error_types[str(raw['error_type'])] = error_types.get(str(raw['error_type']), 0) + 1
  1167	    run = {
  1168	        'arm': arm, 'purpose': purpose, 'clock_domain': 'run_trace_pilot runner time.monotonic()',
  1169	        'offered_start': start, 'offered_duration_s': trace['duration_seconds'], 'envelope_start': start,
  1170	        'envelope_end': max([end] + [row['terminal_at'] for row in rows if row['terminal_at'] is not None]),
  1171	        'envelope_scope': 'offered_cohort_observed', 'rows': rows, 'slo_missing': list(SLO_MISSING_RUN_TRACE_PILOT), 'control': control, 'control_missing': None,
  1172	        'provenance': {
  1173	            'source': 'run_trace_pilot.py output directory', 'output_dir': str(out),
  1174	            'raw_file_sha256': {name: hashlib.sha256(data[name]).hexdigest() for name in RAW_FILES},
  1175	            'offered_trace_sha256': manifest['trace_sha256'],
  1176	            'offered_count': len(trace['requests']),
  1177	            'offered_request_ids_sha256': request_ids_sha256(request['trace_id'] for request in trace['requests']),
  1178	            'offered_tape': {key: provenance.get(key) for key in TAPE_PRESERVED},
  1179	            'manifest': {key: manifest.get(key) for key in MANIFEST_PRESERVED},
  1180	            'raw_error_type_counts': error_types,
  1181	            'client_config_slo_not_used': {'ttft_slo': config.get('ttft_slo'), 'e2e_slo': config.get('e2e_slo')},
  1182	            'mapping': RAW_MAPPING, 'qualifiers': list(ADAPTER_QUALIFIERS),
  1183	        },
  1184	    }
  1185	    try:
  1186	        validate_run(run)
  1187	    except MetricsInputError as exc:
  1188	        raise AdapterRefusal(f'normalized run invalid: {exc}') from exc
  1189	    return run
  1190	
