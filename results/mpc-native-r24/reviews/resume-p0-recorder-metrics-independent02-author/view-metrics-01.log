  1192	def main(argv=None):
  1193	    parser = argparse.ArgumentParser(description='Measured P0 nominal metrics for one static fixed run_trace_pilot '
  1194	                                                 'output directory (no winner, no qualification).',
  1195	                                     allow_abbrev=False)
  1196	    parser.add_argument('--output-dir', required=True)
  1197	    parser.add_argument('--arm', required=True, choices=sorted(FIXED_BUDGETS))
  1198	    parser.add_argument('--purpose', required=True, choices=PURPOSES)
  1199	    args = parser.parse_args(argv)
  1200	    try:
  1201	        metrics = compute(adapt_run_trace_pilot(args.output_dir, arm=args.arm, purpose=args.purpose))
  1202	    except (AdapterRefusal, MetricsInputError) as exc:
  1203	        print(json.dumps({'status': 'REFUSED', 'error': f'{type(exc).__name__}: {exc}'}, sort_keys=True),
  1204	              file=sys.stderr)
  1205	        return 1
  1206	    print(json.dumps(metrics, sort_keys=True, indent=1, allow_nan=False))
  1207	    return 0
  1208	
  1209	
  1210	if __name__ == '__main__':
  1211	    sys.exit(main())
