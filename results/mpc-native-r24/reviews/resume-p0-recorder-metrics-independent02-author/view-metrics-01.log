   498	def _groups(rows, good):
   499	    result = {}
   500	    for name in GROUPS:
   501	        members = [index for index, row in enumerate(rows) if group_of(row['group_tokens']) == name]
   502	        member_rows = [rows[index] for index in members]
   503	        summary = _fate_summary(member_rows)
   504	        count = None if good is None else sum(good[index] for index in members)
   505	        summary.update(
   506	            natural_slo_good=count,
   507	            slo_attainment_fraction=None if good is None else _rate(count, len(members)),
   508	            ttft_conditional_scheduled=percentile_block(
   509	                [row['first_content_at'] - row['scheduled_at'] for row in member_rows if row['fate'] == 'complete'],
   510	                CONDITIONAL_ESTIMAND),
   511	            ttft_all_offered_penalized_scheduled=percentile_block(_penalized(member_rows, 'scheduled_at'),
   512	                                                                  PENALIZED_ESTIMAND))
   513	        result[name] = summary
   514	    return result
