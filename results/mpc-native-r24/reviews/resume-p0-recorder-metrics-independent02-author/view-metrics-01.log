   241	def _validate_control(run):
   242	    control, missing = run['control'], run['control_missing']
   243	    if control is None:
   244	        _nonempty_str(missing, 'control_missing (required when control is null)')
   245	        if run['arm'] in FIXED_BUDGETS:
   246	            raise MetricsInputError('fixed arms require a verified static_fixed control record')
   247	        return
   248	    if missing is not None:
   249	        raise MetricsInputError('control_missing must be null when control is provided')
   250	    if not isinstance(control, dict):
   251	        raise MetricsInputError('control must be a dict')
   252	    kind = control.get('kind')
   253	    if kind == 'static_fixed':
   254	        if set(control) != {'kind', 'budget', 'basis'}:
   255	            raise MetricsInputError('static_fixed control keys must be exactly kind, budget, basis')
   256	        _nonempty_str(control['basis'], 'control.basis')
   257	        if run['arm'] not in FIXED_BUDGETS or control['budget'] != FIXED_BUDGETS[run['arm']] \
   258	                or type(control['budget']) is not float:
   259	            raise MetricsInputError('static_fixed control must belong to fixed16/fixed32 with its exact float budget')
   260	    elif kind == 'measured_intervals':
   261	        if set(control) != {'kind', 'source', 'intervals'}:
   262	            raise MetricsInputError('measured_intervals control keys must be exactly kind, source, intervals')
   263	        if run['arm'] in FIXED_BUDGETS:
   264	            raise MetricsInputError('fixed arms are static: no controller decision intervals')
   265	        _nonempty_str(control['source'], 'control.source')
   266	        if not isinstance(control['intervals'], list):
   267	            raise MetricsInputError('control.intervals must be a list')
   268	        for index, item in enumerate(control['intervals']):
   269	            if not isinstance(item, list) or len(item) != 2:
   270	                raise MetricsInputError(f'control interval {index} must be [start, end]')
   271	            start, end = (_number(value, f'control interval {index}') for value in item)
   272	            if end < start:
   273	                raise MetricsInputError(f'control interval {index} ends before it starts')
   274	    else:
   275	        raise MetricsInputError('control.kind must be static_fixed or measured_intervals')
   276	
   277	
   278	def validate_run(run):
   279	    if not isinstance(run, dict) or set(run) != RUN_KEYS:
   280	        raise MetricsInputError(f'run keys must be exactly {sorted(RUN_KEYS)}')
   281	    if run['arm'] not in RUN_ARMS:
   282	        raise MetricsInputError(f'run arm must be one of {RUN_ARMS} (train_selected_fixed is a table alias)')
   283	    if run['purpose'] not in PURPOSES:
   284	        raise MetricsInputError(f'purpose must be one of {PURPOSES}')
   285	    _nonempty_str(run['clock_domain'], 'clock_domain')
   286	    offered_start = _number(run['offered_start'], 'offered_start')
   287	    duration = _number(run['offered_duration_s'], 'offered_duration_s')
   288	    start, end = _number(run['envelope_start'], 'envelope_start'), _number(run['envelope_end'], 'envelope_end')
   289	    if duration <= 0 or start > offered_start or end < offered_start + duration:
   290	        raise MetricsInputError('envelope must cover [offered_start, offered_start + offered_duration_s] with '
   291	                                'positive duration')
   292	    if run['envelope_scope'] not in ENVELOPE_SCOPES:
   293	        raise MetricsInputError(f'envelope_scope must be one of {sorted(ENVELOPE_SCOPES)}')
   294	    if not isinstance(run['rows'], list):
   295	        raise MetricsInputError('rows must be a list')
   296	    for index, row in enumerate(run['rows']):
   297	        _validate_row(row, index)
   298	    if len({row['request_id'] for row in run['rows']}) != len(run['rows']):
   299	        raise MetricsInputError('request_id values must be unique (all-offered denominator)')
   300	    missing = run['slo_missing']
   301	    if missing is None:
   302	        if any(row['slo'] is None for row in run['rows']):
   303	            raise MetricsInputError('natural SLO fields must be present on every row or on none')
   304	    else:
   305	        if (not isinstance(missing, list) or not missing
   306	                or any(not isinstance(item, str) or not item for item in missing)):
   307	            raise MetricsInputError('slo_missing must be null or a non-empty list of reasons')
   308	        if any(row['slo'] is not None for row in run['rows']):
   309	            raise MetricsInputError('natural SLO fields must be present on every row or on none')
   310	    _validate_control(run)
   311	    provenance = run['provenance']
   312	    if not isinstance(provenance, dict):
   313	        raise MetricsInputError('provenance must be a dict')
   314	    _nonempty_str(provenance.get('offered_trace_sha256'), 'provenance.offered_trace_sha256')
   315	    _validate_cohort(run, provenance)
   316	    _validate_windows(run, offered_start, duration, start, end)
   317	    _validate_comparability(provenance.get('comparability'), run)
   318	    selection = provenance.get('train_selection_sha256')
   319	    if selection is not None and not _is_sha(selection):
   320	        raise MetricsInputError('provenance.train_selection_sha256 must be null or a 64-hex sha256')
   321	
   322	
   323	def _validate_cohort(run, provenance):
   324	    count = provenance.get('offered_count')
   325	    if type(count) is not int or count < 0:
   326	        raise MetricsInputError('provenance.offered_count must be an int >= 0 taken from the frozen offered trace')
   327	    if count != len(run['rows']):
   328	        raise MetricsInputError(f'all-offered cohort: {len(run["rows"])} rows but provenance.offered_count {count}')
   329	    digest = provenance.get('offered_request_ids_sha256')
   330	    if not _is_sha(digest):
   331	        raise MetricsInputError('provenance.offered_request_ids_sha256 must be a 64-hex sha256')
   332	    if request_ids_sha256(row['request_id'] for row in run['rows']) != digest:
   333	        raise MetricsInputError('all-offered cohort: row request ids (in order) differ from '
   334	                                'provenance.offered_request_ids_sha256')
   335	
   336	
   337	def _validate_windows(run, offered_start, duration, start, end):
   338	    offered_end = offered_start + duration
   339	    for index, row in enumerate(run['rows']):
   340	        if not offered_start <= row['scheduled_at'] <= offered_end:
   341	            raise MetricsInputError(f'row {index} scheduled_at lies outside the offered window '
   342	                                    '[offered_start, offered_start + offered_duration_s]')
   343	        for key in ('sent_at', 'first_content_at', 'terminal_at'):
   344	            if row[key] is not None and not start <= row[key] <= end:
   345	                raise MetricsInputError(f'row {index} {key} lies outside the declared envelope '
   346	                                        '[envelope_start, envelope_end]')
   347	    if run['envelope_scope'] == 'offered_cohort_observed':
   348	        last = max([offered_end] + [row['terminal_at'] for row in run['rows'] if row['terminal_at'] is not None])
   349	        if start != offered_start or abs(end - last) > ENVELOPE_TOLERANCE_S:
   350	            raise MetricsInputError('offered_cohort_observed envelope must be [offered_start, max(offered_end, last '
   351	                                    f'terminal_at)] (tolerance {ENVELOPE_TOLERANCE_S} s)')
   352	
   353	
   354	def _contains_key(value, key):
   355	    if isinstance(value, dict):
   356	        return key in value or any(_contains_key(item, key) for item in value.values())
   357	    return isinstance(value, list) and any(_contains_key(item, key) for item in value)
   358	
   359	
   360	def _validate_comparability(record, run):
   361	    if record is None:
   362	        return
   363	    if not isinstance(record, dict) or set(record) != set(COMPARABILITY_FACTS):
   364	        raise MetricsInputError(f'provenance.comparability keys must be exactly {list(COMPARABILITY_FACTS)}')
   365	    for key in COMPARABILITY_FACTS:
   366	        if key == 'clock':
   367	            _nonempty_str(record[key], 'provenance.comparability.clock')
   368	        elif not isinstance(record[key], dict) or not record[key]:
   369	            raise MetricsInputError(f'provenance.comparability.{key} must be a non-empty object')
   370	    model = record['model']
   371	    if set(model) != MODEL_FACTS:
   372	        raise MetricsInputError(f'provenance.comparability.model keys must be exactly {sorted(MODEL_FACTS)}')
   373	    if not isinstance(model['local_model_path'], str) or not Path(model['local_model_path']).is_absolute():
   374	        raise MetricsInputError('comparability.model.local_model_path must be an absolute local asset path')
   375	    if not (_is_sha(model['asset_sha256']) and _is_sha(model['tokenizer_sha256'])):
   376	        raise MetricsInputError('comparability.model asset_sha256 and tokenizer_sha256 must be 64-hex sha256')
   377	    _nonempty_str(model['served_alias'], 'comparability.model.served_alias')
   378	    if model['served_alias_verified'] is not True:
   379	        raise MetricsInputError('comparability.model.served_alias_verified must be true: an unverified served alias '
   380	                                'cannot qualify a comparison')
   381	    generation = record['client_generation']
   382	    if type(generation.get('ignore_eos')) is not bool:
   383	        raise MetricsInputError('comparability.client_generation.ignore_eos must be bool')
   384	    _nonempty_str(generation.get('max_tokens_policy'), 'comparability.client_generation.max_tokens_policy')
   385	    if _contains_key(record['gateway'], ARM_BUDGET_SETTING):
   386	        raise MetricsInputError(f'comparability.gateway must not carry the per-arm {ARM_BUDGET_SETTING} (it is the '
   387	                                'arm control record)')
   388	    try:
   389	        _digest(record)
   390	    except (TypeError, ValueError) as exc:
   391	        raise MetricsInputError(f'provenance.comparability must be canonical JSON: {exc}') from None
   392	    if run['slo_missing'] is None and any(row['slo']['requested_ignore_eos'] is not generation['ignore_eos']
   393	                                          for row in run['rows']):
   394	        raise MetricsInputError('row slo.requested_ignore_eos differs from comparability.client_generation.ignore_eos')
