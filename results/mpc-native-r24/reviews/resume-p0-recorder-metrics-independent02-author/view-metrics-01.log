   645	def _decide(candidates):
   646	    a, b = (candidates[arm] for arm in ('fixed16', 'fixed32'))
   647	    decided_by = ('primary_natural_slo_good' if a['natural_slo_good'] != b['natural_slo_good'] else
   648	                  'tie_1_fewer_not_delivered' if a['not_delivered'] != b['not_delivered'] else 'tie_2_lower_budget')
   649	    selected = min(candidates, key=lambda arm: (-candidates[arm]['natural_slo_good'],
   650	                                                candidates[arm]['not_delivered'], candidates[arm]['budget']))
   651	    return selected, decided_by
