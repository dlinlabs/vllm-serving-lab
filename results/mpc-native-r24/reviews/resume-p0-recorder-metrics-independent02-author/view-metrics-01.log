   594	                                         for row in rows]),
   595	        'request_ids': [row['request_id'] for row in rows],
   596	        'relative_scheduled_s': [row['scheduled_at'] - run['offered_start'] for row in rows],
   597	        'offered_duration_s': run['offered_duration_s'],
   598	        'basis': 'rows validated against provenance offered_count and ordered request-id digest taken from the '
   599	                 'frozen offered trace by the producer',
   600	    }
