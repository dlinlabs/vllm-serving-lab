   436	            'substitution': 'none: no TTFT-only or client --ttft-slo substitute', 'natural_slo_good': None,
   437	            'slo_attainment_fraction': None, 'cohort_slo_goodput_rps': None, 'in_window_slo_goodput_rps': None,
