   654	def _binding_error(metrics):
   655	    """Internal consistency of one compute() result used across arms; None when consistent."""
   656	    try:
   657	        cohort, comparability, count = metrics['offered_cohort'], metrics['comparability'], metrics['all_offered']
   658	        if cohort['offered_count'] != count or len(cohort['request_ids']) != count \
   659	                or len(cohort['relative_scheduled_s']) != count \
   660	                or request_ids_sha256(cohort['request_ids']) != cohort['request_ids_sha256']:
   661	            return 'offered_cohort ids/count/schedule do not match its request-id digest'
   662	        if comparability['status'] == 'DECLARED' and _digest(comparability['record']) != comparability['sha256']:
   663	            return 'comparability sha256 does not match its record'
   664	        _digest(metrics)
   665	    except (KeyError, TypeError, ValueError) as exc:
   666	        return f'not a complete canonical {SCHEMA} result ({type(exc).__name__}: {exc})'
   667	    return None
   668	
