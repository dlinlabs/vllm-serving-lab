   198	def _validate_row(row, index):
   199	    if not isinstance(row, dict) or set(row) != ROW_KEYS:
   200	        raise MetricsInputError(f'row {index}: keys must be exactly {sorted(ROW_KEYS)}')
   201	    name = f'row {index}'
   202	    _nonempty_str(row['request_id'], f'{name} request_id')
   203	    for key in ('group_tokens', 'max_output_tokens'):
   204	        if type(row[key]) is not int or row[key] <= 0:
   205	            raise MetricsInputError(f'{name} {key} must be a positive int')
   206	    scheduled = _number(row['scheduled_at'], f'{name} scheduled_at')
   207	    sent, first, terminal = (_optional_number(row[key], f'{name} {key}')
   208	                             for key in ('sent_at', 'first_content_at', 'terminal_at'))
   209	    fate = row['fate']
   210	    if fate not in FATES:
   211	        raise MetricsInputError(f'{name} fate must be one of {FATES}')
   212	    tokens = row['completion_tokens']
   213	    if tokens is not None and (type(tokens) is not int or tokens < 0):
   214	        raise MetricsInputError(f'{name} completion_tokens must be null or an int >= 0')
   215	    slo = row['slo']
   216	    if slo is not None:
   217	        if not isinstance(slo, dict) or set(slo) != SLO_KEYS:
   218	            raise MetricsInputError(f'{name} slo keys must be exactly {sorted(SLO_KEYS)}')
   219	        _nonempty_str(slo['status'], f'{name} slo.status')
   220	        if slo['finish_reason'] is not None and not isinstance(slo['finish_reason'], str):
   221	            raise MetricsInputError(f'{name} slo.finish_reason must be null or a string')
   222	        if any(type(slo[key]) is not bool for key in ('requested_ignore_eos', 'stream_done', 'stream_error')):
   223	            raise MetricsInputError(f'{name} slo flags must be bool')
   224	        if (slo['status'] == 'complete') != (fate == 'complete'):
   225	            raise MetricsInputError(f'{name} slo.status complete must coincide with fate complete')
   226	    if sent is not None and sent < scheduled - EARLY_SEND_TOLERANCE_S:
   227	        raise MetricsInputError(f'{name} clock order: early send, sent_at < scheduled_at (tolerance '
   228	                                f'{EARLY_SEND_TOLERANCE_S} s; never credited)')
   229	    if first is not None and (sent is None or first < sent or first < scheduled):
   230	        raise MetricsInputError(f'{name} clock order: first_content_at needs sent_at <= first and scheduled_at <= first')
   231	    if terminal is not None and (sent is None or terminal < sent or (first is not None and terminal < first)):
   232	        raise MetricsInputError(f'{name} clock order: terminal_at needs sent_at <= terminal and first <= terminal')
   233	    if fate == 'not_launched' and not (sent is None and first is None and terminal is None and tokens is None):
   234	        raise MetricsInputError(f'{name} not_launched carries no send/first/terminal/token observation')
   235	    if fate == 'complete' and (sent is None or first is None or terminal is None):
   236	        raise MetricsInputError(f'{name} complete requires sent_at, first_content_at and terminal_at')
   237	    if fate in ('rejected',) + FAILURE_FATES and (sent is None or terminal is None):
   238	        raise MetricsInputError(f'{name} {fate} requires sent_at and terminal_at')
   239	
