   106	class MetricsInputError(ValueError):
   107	    """Normalized input violates the frozen schema: refused, never repaired."""
   108	
   109	
   110	class AdapterRefusal(ValueError):
   111	    """Raw run_trace_pilot output cannot support the normalized schema: refused, no events invented."""
