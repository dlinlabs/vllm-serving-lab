   401	def _fate_summary(rows):
   402	    fates = {fate: 0 for fate in FATES}
   403	    for row in rows:
   404	        fates[row['fate']] += 1
   405	    total = len(rows)
   406	    failures = sum(fates[fate] for fate in FAILURE_FATES)
   407	    return {
   408	        'n_offered': total, 'fates': fates, 'delivered': fates['complete'], 'failures': failures,
   409	        'rejection_rate': _rate(fates['rejected'], total), 'failure_rate': _rate(failures, total),
   410	        'not_launched_rate': _rate(fates['not_launched'], total), 'unknown_rate': _rate(fates['unknown'], total),
   411	        'delivered_fraction': _rate(fates['complete'], total),
   412	    }
