  1097	def _model_fidelity(manifest, trace):
  1098	    model = trace.get('model')
  1099	    if not isinstance(model, str) or not model.startswith('/'):
  1100	        raise AdapterRefusal(f'trace model {model!r}: protocol requires the absolute local model path (a repo id '
  1101	                             'MODEL_NAME can silently use the gateway character fallback)')
  1102	    launch = manifest.get('gateway_launch')
  1103	    settings = launch.get('settings') if isinstance(launch, dict) else None
  1104	    if not isinstance(settings, dict) or settings.get('MODEL_NAME') != model:
  1105	        raise AdapterRefusal('gateway launch MODEL_NAME differs from the trace model')
  1106	    initial = manifest.get('initial_metrics')
  1107	    if not isinstance(initial, dict) or initial.get('tokenizer_available') is not True:
  1108	        raise AdapterRefusal('gateway initial metrics do not show tokenizer_available true')
