    92	                  'tie_2': 'budget (lower)', 'not': 'nominal forecast freeze_fixed', 'data': 'Train split only'}
    93	SELECTION_KEYS = frozenset({'schema', 'status', 'purpose', 'selected_arm', 'selected_budget', 'decided_by', 'rule',
    94	                            'candidates', 'offered_trace_sha256', 'request_ids_sha256', 'request_ids',
    95	                            'comparability_sha256', 'scope', 'selection_sha256'})
