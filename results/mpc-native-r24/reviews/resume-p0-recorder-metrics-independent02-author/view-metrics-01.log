  1011	def _map_row(raw, request, start, index):
  1012	    name = f'client row {index}'
  1013	    if not isinstance(raw, dict):
  1014	        raise AdapterRefusal(f'{name}: not an object')
  1015	    if raw.get('trace_id') != request['trace_id']:
  1016	        raise AdapterRefusal(f'{name}: trace_id differs from trace order')
  1017	    if type(raw.get('expected_input_tokens')) is not int or raw['expected_input_tokens'] != request['input_tokens']:
  1018	        raise AdapterRefusal(f'{name}: expected_input_tokens differs from the trace')
  1019	    if raw.get('max_output_tokens') != request['max_tokens']:
  1020	        raise AdapterRefusal(f'{name}: max_output_tokens differs from the trace')
  1021	    scheduled = _raw_number(raw.get('scheduled_at'), f'{name} scheduled_at', optional=False)
  1022	    if abs(scheduled - (start + request['arrival_seconds'])) > 1e-6:
  1023	        raise AdapterRefusal(f'{name}: scheduled_at is not measurement_start + arrival_seconds')
  1024	    keys = set(raw)
  1025	    sent = first = terminal = tokens = None
  1026	    if keys == PLACEHOLDER_KEYS:
  1027	        if raw['error_type'] != 'NotLaunched' or raw['success'] is not False or raw['rejected'] is not False:
  1028	            raise AdapterRefusal(f'{name}: placeholder row is not a NotLaunched record')
  1029	        pristine = (raw['error_message'] == NOT_LAUNCHED_MESSAGE and raw['stream_complete'] is False and
  1030	                    all(raw[key] is None for key in ('request_id', 'started_at', 'first_content_at', 'finished_at',
  1031	                                                     'status', 'ttft', 'end_to_end', 'input_tokens', 'output_tokens')))
  1032	        fate = 'not_launched' if pristine else 'unknown'
  1033	    elif keys == LAUNCHED_KEYS:
  1034	        sent, first, terminal = (_raw_number(raw[key], f'{name} {key}')
  1035	                                 for key in ('started_at', 'first_content_at', 'finished_at'))
  1036	        ttft = _raw_number(raw['ttft'], f'{name} ttft')
  1037	        if (ttft is None) != (first is None) or (ttft is not None and (sent is None or abs(ttft - (first - sent)) > 1e-9)):
  1038	            raise AdapterRefusal(f'{name}: ttft is not first_content_at - started_at')
  1039	        tokens = raw['output_tokens']
  1040	        if tokens is not None and (type(tokens) is not int or tokens < 0):
  1041	            raise AdapterRefusal(f'{name}: output_tokens must be null or an int >= 0')
  1042	        if type(raw['success']) is not bool or type(raw['rejected']) is not bool:
  1043	            raise AdapterRefusal(f'{name}: success/rejected must be bool')
  1044	        error_type = raw['error_type']
  1045	        if raw['success']:
  1046	            if raw['rejected'] or error_type is not None or raw['stream_complete'] is not True:
  1047	                raise AdapterRefusal(f'{name}: inconsistent success record')
  1048	            fate = 'complete'
  1049	        elif raw['rejected']:
  1050	            if error_type is not None or raw['status'] != 503:
  1051	                raise AdapterRefusal(f'{name}: inconsistent rejection record')
  1052	            fate = 'rejected'
  1053	        elif error_type == 'CancelledError':
  1054	            fate = 'cancelled'
  1055	        elif error_type == 'HTTPStatusError':
  1056	            fate = 'http_error'
  1057	        elif error_type in STREAM_ERROR_TYPES:
  1058	            fate = 'stream_error'
  1059	        elif isinstance(error_type, str) and error_type and error_type != 'NotLaunched':
  1060	            fate = 'transport_error'
  1061	        else:
  1062	            fate = 'unknown'
  1063	    else:
  1064	        raise AdapterRefusal(f'{name}: raw schema drift (missing {sorted(LAUNCHED_KEYS - keys)}, '
  1065	                             f'extra {sorted(keys - LAUNCHED_KEYS)})')
  1066	    return {'request_id': raw['trace_id'], 'group_tokens': raw['expected_input_tokens'],
  1067	            'max_output_tokens': raw['max_output_tokens'], 'scheduled_at': scheduled, 'sent_at': sent,
  1068	            'first_content_at': first, 'terminal_at': terminal, 'fate': fate, 'completion_tokens': tokens,
  1069	            'slo': None}
