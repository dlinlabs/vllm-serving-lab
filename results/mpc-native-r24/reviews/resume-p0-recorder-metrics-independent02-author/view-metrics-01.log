   534	def _fairness(groups):
   535	    used = [name for name in GROUPS if groups[name]['n_offered']]
   536	    rejection = {name: groups[name]['rejection_rate'] for name in used}
   537	    ttft = {name: groups[name]['ttft_conditional_scheduled'] for name in used}
   538	    numeric = {name: block['p95'] for name, block in ttft.items() if block['p95'] is not None}
   539	    worst = max(numeric, key=numeric.get) if numeric else None
   540	    worst_rejection = max(rejection.values()) if rejection else None
   541	    rejection_groups = [name for name in used if rejection[name] == worst_rejection]
   542	    return {
   543	        'scope': 'descriptive across predeclared prompt-token groups; no starvation or fairness guarantee',
   544	        'slo_attainment_fraction': _spread(groups, 'slo_attainment_fraction'),
   545	        'delivered_fraction': _spread(groups, 'delivered_fraction'),
   546	        'worst_group_rejection_rate': worst_rejection,
   547	        'worst_group_rejection_rate_group': rejection_groups[0] if rejection_groups else None,
   548	        'worst_group_rejection_rate_n': groups[rejection_groups[0]]['n_offered'] if rejection_groups else None,
   549	        'worst_group_rejection_rate_tied_groups': rejection_groups,
   550	        'worst_group_ttft_conditional_scheduled_p95': None if worst is None else numeric[worst],
   551	        'worst_group_ttft_conditional_scheduled_p95_group': worst,
   552	        'worst_group_ttft_conditional_scheduled_p95_n': None if worst is None else ttft[worst]['n'],
   553	        'groups_without_conditional_p95': [name for name in used if name not in numeric],
   554	    }
