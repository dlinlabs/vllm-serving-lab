+            child = subprocess.Popen(command, cwd=outside, env=environment, stdout=stdout, stderr=stderr)
+            identity = {
+                "pid": child.pid,
+                "start_ticks": Path(f"/proc/{child.pid}/stat").read_text().rsplit(")", 1)[1].split()[19],
