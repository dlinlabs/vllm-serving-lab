+            "records": [{"fate": "complete", "stream_done": True, "finish_reason": "stop"} for _ in range(3)],
+            "summary": {"prompt_tokens_mismatch": 0}})
+        prepared = types.SimpleNamespace(
+            error=prepared_error, recorder=types.SimpleNamespace(
+                trace={"requests": [{"trace_id": f"CPU-{i}"} for i in range(5)]},
+                capture={"status": "failed", "error": "not_run", "records": None}))
+
+        class Client:
+            async def __aenter__(self):
