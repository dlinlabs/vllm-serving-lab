+def _root_endpoint(value):
+    """Validate the supplied root spelling before HTTPX can normalize a path."""
+    reason = "explicit_HTTP_root_endpoint_required"
+    _require(isinstance(value, (str, httpx.URL)), reason)
+    raw = str(value)
+    _require(not any(char.isspace() or ord(char) < 32 or ord(char) == 127 for char in raw)
+             and not any(char in raw for char in ("?", "#", "\\")), reason)
+    try:
+        parts = urlsplit(raw)
+        port = parts.port
+        endpoint = httpx.URL(raw)
+    except (ValueError, httpx.InvalidURL) as exc:
+        raise RuntimeRefused(reason) from exc
+    _require(parts.scheme in ("http", "https") and parts.netloc
+             and parts.username is None and parts.password is None
+             and parts.path in ("", "/") and not parts.netloc.endswith(":")
+             and (port is None or 0 <= port <= 65535)
+             and endpoint.host and endpoint.is_absolute_url and endpoint.raw_path == b"/", reason)
+    return str(endpoint.copy_with(path="/"))
+
