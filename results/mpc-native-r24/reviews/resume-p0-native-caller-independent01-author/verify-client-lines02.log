  683  def _load_inputs(capture, trace_path, binding_path, gateway_url, backend_url, purpose, url_names):
  684      """Strict trace/binding/URL/purpose loading into the envelope; returns the validated trace."""
  685      capture['sources_sha256'] = {name: tw.sha256_file(path) for name, path in SOURCES.items()}
  686      loaded, data = _strict_load(trace_path)
  687      try:
  688          trace = tw.validate_trace(loaded)
  689      except (ValueError, KeyError, TypeError, AttributeError) as exc:
  690          raise ClientRefusal(f'trace refused: {type(exc).__name__}: {exc}') from exc
  691      capture['trace_sha256'] = hashlib.sha256(data).hexdigest()
  692      provenance = trace.get('provenance') if isinstance(trace.get('provenance'), dict) else {}
  693      capture['trace_provenance'] = {key: provenance.get(key) for key in TAPE_KEYS}
  694      capture['payload_template']['model'] = trace['model']
  695      capture['offered_count'], capture['offered_duration_s'] = len(trace['requests']), trace['duration_seconds']
  696      capture['offered_request_ids_sha256'] = nm.request_ids_sha256(request['trace_id']
  697                                                                    for request in trace['requests'])
  698      capture['binding'], binding_data = _strict_load(binding_path)
  699      capture['binding_sha256'] = hashlib.sha256(binding_data).hexdigest()
  700      capture['config']['gateway_url'] = _loopback(gateway_url, url_names[0])
  714      capture['binding_evidence']['tokenizer'] = check_tokenizer(trace, binding, tokenizer)
  715  
  716  
  717  async def _collect(capture, trace, binding, transport, request_timeout, schedule):
  718      """Backend /v1/models check, then ``schedule(now) -> (offered_start, drain_deadline)``; every offer is allocated
  719      and replayed to that absolute drain deadline (records stay in the envelope on any exit)."""
  720      limits = httpx.Limits(max_connections=len(trace['requests']) + 1,
  721                            max_keepalive_connections=len(trace['requests']) + 1)
  722      async with httpx.AsyncClient(transport=transport, timeout=request_timeout, limits=limits,
  723                                   trust_env=False) as client:
  724          try:
  725              response = await client.get(capture['config']['backend_url'] + MODELS_PATH)
  726              response.raise_for_status()
  727              capture['models_response'] = _strict_json(response.content, 'backend /v1/models')
  728          except (httpx.HTTPError, ValueError) as exc:
  729              raise ClientRefusal(f'backend /v1/models unavailable: {type(exc).__name__}: {exc}') from exc
  730          capture['binding_evidence']['served_models'] = check_served_models(binding, capture['models_response'],
  731                                                                             trace['max_model_len'])
  732          now = time.monotonic()
  733          offered_start, drain_deadline = schedule(now)
  734          if not now < offered_start <= now + MAX_START_WAIT_S:
  735              raise ClientRefusal(f'offered_start must lie in (now, now + {MAX_START_WAIT_S}s]: no rescheduling')
  736          capture['offered_start'] = offered_start
  737          capture['offered_end'] = offered_start + trace['duration_seconds']
  738          records = capture['records'] = prepare_records(trace, offered_start, capture['run_id'])
  739          try:
  740              capture['drain_deadline'] = drain_deadline
  838              raise ClientRefusal('request_timeout must be a finite number > 0')
  839          trace = _load_inputs(capture, trace_path, binding_path, gateway_url, backend_url, purpose,
  840                               ('gateway_url', 'backend_url'))
  841          _preflight_local(capture, trace, capture['binding'], tokenizer_loader)
  842      except Exception as exc:
  843          _settle(capture, exc)
  844          return prepared
  845      capture['error'] = NOT_RUN_ERROR
  846      prepared.trace, prepared.ready = trace, True
  847      return prepared
