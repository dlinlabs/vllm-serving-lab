   137	def _root_endpoint(value):
   138	    """Validate the supplied root spelling before HTTPX can normalize a path."""
   139	    reason = "explicit_HTTP_root_endpoint_required"
   140	    _require(isinstance(value, (str, httpx.URL)), reason)
   141	    raw = str(value)
   142	    _require(not any(char.isspace() or ord(char) < 32 or ord(char) == 127 for char in raw)
   143	             and not any(char in raw for char in ("?", "#", "\\")), reason)
   144	    try:
   145	        parts = urlsplit(raw)
   146	        port = parts.port
   147	        endpoint = httpx.URL(raw)
   148	    except (ValueError, httpx.InvalidURL) as exc:
   149	        raise RuntimeRefused(reason) from exc
   150	    _require(parts.scheme in ("http", "https") and parts.netloc
   151	             and parts.username is None and parts.password is None
   152	             and parts.path in ("", "/") and not parts.netloc.endswith(":")
   153	             and (port is None or 0 <= port <= 65535)
   154	             and endpoint.host and endpoint.is_absolute_url and endpoint.raw_path == b"/", reason)
   155	    return str(endpoint.copy_with(path="/"))
   156	
