   778	def main(argv=None):
   779	    cli_entered = time.monotonic()
   780	    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
   781	    parser.add_argument("--url", default="http://127.0.0.1:8080")
   782	    parser.add_argument("--journal", type=Path, required=True)
   783	    source = parser.add_mutually_exclusive_group()
   784	    source.add_argument("--scenario-file", type=Path)
   785	    source.add_argument("--train-tape", type=Path)
   786	    parser.add_argument("--forecast-purpose", choices=("train", "evaluation", "engineering"))
   787	    parser.add_argument("--cost-spec-file", type=Path)
   788	    parser.add_argument("--policy", choices=("mpc", "one_move"), default="mpc")
   789	    parser.add_argument("--steps", type=int, default=4)
   790	    parser.add_argument("--episode-seconds", type=float, default=4.0)
   791	    parser.add_argument("--poll-seconds", type=float, default=0.0)
   792	    parser.add_argument("--describe-protocol", action="store_true")
   793	    parser.add_argument("--start-at", type=float)
   794	    parser.add_argument("--experimental-nominal-demo", action="store_true")
   795	    parser.add_argument("--nominal-permit", type=Path)
   796	    args = parser.parse_args(argv)
   797	    if (args.train_tape is not None) != (args.forecast_purpose is not None):
   798	        parser.error("--train-tape requires an explicit --forecast-purpose, used only with Train")
   799	    if not args.describe_protocol and args.experimental_nominal_demo and (
   800	            args.nominal_permit is None or (args.scenario_file is None and args.train_tape is None)):
   801	        parser.error("experimental POST requires a separate nominal permit and causal scenario file or Train tape")
   802	    endpoint = _root_endpoint(args.url)
   803	    cost = CostSpec(**_strict(args.cost_spec_file.read_bytes())) if args.cost_spec_file else CostSpec()
   804	    planner = NominalPlanner(ModelParameters(cost_spec=cost))
   805	    if args.train_tape:
   806	        factory, binding = load_train_scenario(args.train_tape, purpose=args.forecast_purpose)
   807	    else:
   808	        factory, binding = load_causal_scenario(args.scenario_file) if args.scenario_file else (None, {"kind": "observe_only"})
   809	    limits = RuntimeLimits(iterations=args.steps, episode_s=args.episode_seconds, poll_s=args.poll_seconds)
   810	    if args.describe_protocol:
   811	        print(json.dumps(describe_protocol(
   812	            planner, args.journal, endpoint=endpoint, scenario_binding=binding,
   813	            policy=args.policy, limits=limits, start_at=args.start_at,
   814	        ), sort_keys=True, allow_nan=False))
   815	        return
   816	    permit = _load_permit(args.nominal_permit) if args.nominal_permit else None
   817	    key = os.environ.get("ADMIN_API_KEY", "")
   818	    _require(bool(key), "ADMIN_API_KEY_required")
   819	
   820	    async def execute():
   821	        async with httpx.AsyncClient(base_url=endpoint, follow_redirects=False, trust_env=False) as client:
   822	            runtime = NominalRuntime(
   823	                client, planner, factory, args.journal, admin_key=key, scenario_binding=binding,
   824	                permit=permit, enabled=args.experimental_nominal_demo, policy=args.policy,
   825	                limits=limits, start_at=args.start_at,
   826	            )
   827	            startup = await wait_for_start(runtime, cli_entered=cli_entered)
   828	            result = await runtime.run()
   829	            result.update(startup=startup, module_paths=module_paths())
   830	            return result
   831	
   832	    print(json.dumps(asyncio.run(execute()), sort_keys=True, allow_nan=False))
