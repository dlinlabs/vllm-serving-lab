   101	def module_paths():
   102	    paths = {"nominal_runtime": str(Path(__file__).resolve())}
   103	    expected = {
   104	        "mpc_lab.contracts": ROOT / "mpc_lab/contracts.py",
   105	        "mpc_lab.controller": ROOT / "mpc_lab/controller.py",
   106	        "mpc_lab.model": ROOT / "mpc_lab/model.py",
   107	        "mpc_lab.runtime": ROOT / "mpc_lab/runtime.py",
   108	        "prefill_lab.live_http": ROOT / "prefill_lab/live_http.py",
   109	        **{name: HERE / (name + ".py") for name in
   110	           ("nominal_permit", "nominal_planner", "nominal_scenario", "nominal_workload")},
   111	    }
   112	    for name, path in expected.items():
   113	        if name not in sys.modules and name in ("nominal_scenario", "nominal_workload"):
   114	            continue
   115	        actual = Path(sys.modules[name].__file__).resolve()
   116	        _require(actual == path, "module_outside_frozen_root:" + name)
   117	        paths[name] = str(actual)
   118	    return paths
