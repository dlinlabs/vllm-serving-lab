   296	class NominalRuntime:
   297	    """Caller owns the AsyncClient; run() owns only its bounded journal lock."""
   298	
   299	    def __init__(
   300	        self, client: httpx.AsyncClient, planner: NominalPlanner,
   301	        scenario_factory: Callable[[Snapshot], CausalScenario] | None, journal_path: Path, *,
   302	        admin_key: str, scenario_binding: dict, permit: NominalDemoPermit | None = None,
   303	        enabled: bool = False, policy: str = "mpc", limits: RuntimeLimits = RuntimeLimits(),
   304	        parameters: ModelParameters | None = None, clock: Callable[[], float] = time.monotonic,
   305	        sleeper=asyncio.sleep, start_at: float | None = None,
   306	    ):
   307	        _require(type(enabled) is bool and policy in ("mpc", "one_move"),
   308	                 "explicit_mode_required_static_baselines_not_per_tick")
   309	        _require(type(planner) is NominalPlanner and type(limits) is RuntimeLimits, "typed_nominal_planner_required")
   310	        parameters = planner.parameters if parameters is None else parameters
   311	        _require(type(parameters) is ModelParameters and parameters == planner.parameters
   312	                 and parameters.identity == planner.identity, "exact_model_parameter_binding")
   313	        _require(isinstance(admin_key, str) and bool(admin_key), "admin_header_required")
   314	        _require(client.follow_redirects is False and client.base_url.scheme in ("http", "https")
   315	                 and not client.base_url.username and not client.base_url.password
   316	                 and client.base_url.path == "/" and not client.base_url.query and not client.base_url.fragment,
   317	                 "explicit_nonredirecting_HTTP_endpoint_required")
   318	        self.client, self.planner, self.scenario_factory = client, planner, scenario_factory
   319	        self.parameters, self.identity = parameters, planner.identity
   320	        self.permit, self.enabled, self.policy, self.limits = permit, enabled, policy, limits
   321	        self.admin_key, self.clock, self.sleeper = admin_key, clock, sleeper
   322	        self.start_at = start_at
   323	        self.store = _Journal(journal_path)
   324	        self.protocol = _protocol(parameters, policy, limits, scenario_binding, client.base_url,
   325	                                  self.store.path, start_at)
   326	        self.protocol_sha256 = digest(self.protocol)
   327	        self.state = None
   328	        self.observed = None
   329	        self.last_clock = None
   330	
   331	    def _binding(self):
   332	        _require(self.planner.parameters == self.parameters and self.planner.identity == self.identity
   333	                 and digest(asdict(self.parameters)) == digest(self.protocol["parameters"])
   334	                 and asdict(self.limits) == self.protocol["limits"]
   335	                 and self.policy == self.protocol["policy"]
   336	                 and self.start_at == self.protocol.get("start_at")
   337	                 and str(self.store.path) == self.protocol["journal_path"]
   338	                 and _root_endpoint(self.client.base_url) == self.protocol["endpoint"]
   339	                 and self.client.follow_redirects is False
   340	                 and digest(self.protocol) == self.protocol_sha256,
   341	                 "runtime_configuration_or_parameter_binding_changed")
   342	
   343	    def _now(self):
   344	        now = self.clock()
   345	        _require(finite(now) and now >= 0 and (self.last_clock is None or now >= self.last_clock),
   346	                 "nonmonotonic_local_clock")
   347	        self.last_clock = now
   348	        return now
   349	
   350	    def _remaining(self, deadline):
   351	        remaining = deadline - self._now()
   352	        _require(remaining > 0, "absolute_entry_or_episode_deadline")
   353	        return remaining
   354	
   355	    def _record(self, event, **values):
   356	        self.state["events"].append({"event": event, "at": self.clock(), **_plain(values)})
   357	        self.store.save(self.state)
   358	
   359	    def _version(self):
   360	        _require(self.observed is not None, "no_actual_GET_observation")
   361	        return StateVersion.from_snapshot(self.observed)
   362	
   363	    async def _wire(self, method, path, deadline, *, command=None, body=None):
   364	        started = self._now()
   365	        remaining = self._remaining(deadline)
   366	        chunks, size, stored, chunk_count, status, complete, error = [], 0, 0, 0, None, False, None
   367	        arguments = {"headers": {"x-admin-api-key": self.admin_key}, "timeout": min(0.2, remaining)}
   368	        if command is not None:
   369	            _require(type(body) is bytes, "preencoded_durable_command_required")
   370	            arguments["content"] = body
   371	            arguments["headers"]["content-type"] = "application/json"
   372	        try:
   373	            async with asyncio.timeout(min(0.2, remaining)):
   374	                async with self.client.stream(method, path, **arguments) as response:
   375	                    status = response.status_code
   376	                    async for chunk in response.aiter_bytes():
   377	                        chunk_count += 1
   378	                        _require(chunk_count <= 4096, "HTTP_chunk_limit")
   379	                        size += len(chunk)
   380	                        part = chunk[:max(0, MAX_BODY - stored)]
   381	                        chunks.append(part)
   382	                        stored += len(part)
   383	                        _require(size <= MAX_BODY, "HTTP_body_limit")
   384	                        self._remaining(deadline)
   385	                    complete = True
   386	        except BaseException as exc:
   387	            error = exc
   388	        raw = b"".join(chunks)
   389	        saved = raw.replace(self.admin_key.encode(), b"[REDACTED_AUTH]")
   390	        self._record("HTTP", method=method, path=path, status_code=status,
   391	                     started_at=started, received_at=self.clock(), bytes_received=size,
   392	                     response_complete=complete, redacted=saved != raw,
   393	                     received_prefix_sha256=hashlib.sha256(raw).hexdigest(),
   394	                     body_b64=base64.b64encode(saved).decode(),
   395	                     error_type=type(error).__name__ if error else None,
   396	                     operation_id=command["operation_id"] if command else None)
   397	        if error is not None:
   398	            raise error
   399	        self._remaining(deadline)
   400	        return status, raw
   401	
   402	    async def _state(self, deadline, *, entered_at):
   403	        get_entered = self._now()
   404	        status, raw = await self._wire("GET", "/admin/mpc/state", deadline)
   405	        _require(status == 200, "state_HTTP_status")
   406	        document = _strict(raw)
   407	        require_guarded_capability(document)
   408	        _require(isinstance(document.get("requests"), (list, tuple))
   409	                 and len(document["requests"]) <= 512, "ledger_capacity")
   410	        snapshot = snapshot_from_dict(document)
   411	        local_domain = clock_domain()
   412	        reason = validate_snapshot(snapshot, now=self._now(), clock_domain=local_domain,
   413	                                   expected_identity=self.identity, max_age_s=0.5)
   414	        _require(reason is None, reason or "invalid_snapshot")
   415	        _require(snapshot.sampled_at >= max(get_entered, entered_at), "snapshot_predates_current_GET_entry")
   416	        _require(snapshot.budget in BUDGETS, "unsupported_observed_budget")
   417	        _require(type(document.get("cost_spec")) is dict, "missing_cost_spec")
   418	        cost = CostSpec(**document["cost_spec"])
   419	        _require(cost.fingerprint == self.parameters.cost_spec.fingerprint == snapshot.identity.cost_hash,
   420	                 "cost_spec_fingerprint_mismatch")
   421	        for mark in snapshot.requests:
   422	            _require(mark.cost == self.parameters.cost_spec.estimate(mark.prompt_tokens, mark.max_tokens),
   423	                     "immutable_ledger_cost_mismatch")
   424	        _require(local_domain == self.state["clock_domain"], "local_clock_domain_changed")
   425	        if self.state["run_id"] is None:
   426	            self.state["run_id"] = snapshot.run_id
   427	            self._record("RunBound", run_id=snapshot.run_id)
   428	        _require(snapshot.run_id == self.state["run_id"], "gateway_run_changed")
   429	        self.observed = snapshot
   430	        self._remaining(deadline)
   431	        return snapshot
   432	
   433	    def _reconcile(self, snapshot):
   434	        pending = self.state["pending"]
   435	        if pending is None:
   436	            return None
   437	        command, ack = pending["command"], pending["ack"]
   438	        if (snapshot.run_id != command["run_id"] or snapshot.clock_domain != command["clock_domain"]
   439	                or asdict(snapshot.identity) != command["identity"]):
   440	            return {"status": "pending", "reason": "identity_changed_no_fence"}
   441	        version = snapshot.budget_version
   442	        if version < command["expected_version"]:
   443	            return {"status": "pending", "reason": "version_regression_no_fence"}
   444	        if ack is not None:
   445	            if version < ack["budget_version"] or snapshot.sampled_at < ack["applied_at"]:
   446	                return {"status": "pending", "reason": "ACK_requires_real_reobservation"}
   447	            if version == ack["budget_version"] and snapshot.budget != command["budget"]:
   448	                return {"status": "pending", "reason": "ACK_observation_inconsistent"}
   449	            status, event = "applied_reobserved", "CapReobserved"
   450	        elif version > command["expected_version"]:
   451	            status, event = "unknown_fenced_by_CAS", "UnknownFenced"
   452	        elif snapshot.sampled_at >= command["not_after"]:
   453	            status, event = "unknown_fenced_by_server_expiry", "UnknownFenced"
   454	        else:
   455	            return {"status": "pending", "reason": "unchanged_GET_is_not_a_fence"}
   456	        self.state["pending"] = None
   457	        self._record(event, outcome=status, pending=pending, observed=asdict(snapshot),
   458	                     application_known_from_ACK=ack is not None, native_token_application_at=None)
   459	        return {"status": status, "operation_id": command["operation_id"],
   460	                "cap_application_known": ack is not None, "native_token_application_at": None}
   461	
   462	    def _authorize(self, snapshot, budget, entered, deadline, *, issued):
   463	        self._binding()
   464	        if not self.enabled or type(self.permit) is not NominalDemoPermit:
   465	            return "nominal_not_authorized"
   466	        current_source = source_digest()
   467	        reason = self.permit.refusal_reason(
   468	            snapshot, enabled=self.enabled, expected_identity=self.identity,
   469	            current_source_sha256=current_source, protocol_sha256=self.protocol_sha256,
   470	            current_clock_domain=clock_domain(), budget=budget, entered_at=entered,
   471	            deadline=deadline, now=self._now(), issued_commands=issued,
   472	        )
   473	        if reason is None and self.state["source_sha256"] not in (None, current_source):
   474	            return "journal_source_binding_changed"
   475	        if reason is None:
   476	            self.state["source_sha256"] = current_source
   477	        return reason
   478	
   479	    def _decision(self, snapshot, window):
   480	        self._binding()
   481	        planning_started = self._now()
   482	        source = self.scenario_factory(snapshot)
   483	        _require(type(source) is CausalScenario, "typed_causal_scenario_required")
   484	        _require(type(source.scenario) is Scenario and type(source.scenario.offers) is tuple
   485	                 and len(source.scenario.offers) <= MAX_OFFERS, "bounded_causal_scenario_required")
   486	        scenario = _plain(source)
   487	        scenario_bytes = json.dumps(scenario, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
   488	        _require(len(scenario_bytes) <= MAX_BODY, "causal_receipt_byte_limit")
   489	        scenario_sha256 = hashlib.sha256(scenario_bytes).hexdigest()
   490	        snapshot_sha256 = digest(asdict(snapshot))
   491	        self._record("PlanningInput", planning_started_at=planning_started,
   492	                     snapshot_sha256=snapshot_sha256, scenario=scenario,
   493	                     scenario_sha256=scenario_sha256, window=window)
   494	        decision = self.planner.plan(snapshot, source, window, policy=self.policy,
   495	                                     clock_domain=clock_domain(), read_state=self._version, clock=self._now)
   496	        _require(self._now() < window.solve_deadline, "planner_finished_after_original_solve_deadline")
   497	        _require(type(decision) is NominalDecision and decision.policy == self.policy
   498	                 and decision.contract_sha256 == CONTRACT_SHA256 and decision.objective_id == OBJECTIVE_ID
   499	                 and decision.planner_version == PLANNER_VERSION and decision.evaluated_paths == 8,
   500	                 "typed_nominal_decision_contract")
   501	        action, plan = decision.first_action, decision.plan
   502	        _require(type(action) is FirstAction and type(plan) is TimedPlan
   503	                 and type(action.source) is StateVersion
   504	                 and action.source == StateVersion.from_snapshot(snapshot)
   505	                 and type(plan.actions) is tuple and len(plan.actions) == 3
   506	                 and all(finite(value) and value in BUDGETS for value in plan.actions)
   507	                 and action.budget == plan.actions[0] and finite(action.budget)
   508	                 and plan.received_budget == snapshot.budget and plan.sampled_at == snapshot.sampled_at
   509	                 and plan.first_action_at == action.not_before == window.first_action_at
   510	                 and action.not_after == window.action_deadline, "first_action_source_or_time_mismatch")
   511	        self._record("Planned", planning_started_at=planning_started, selected_at=self._now(),
   512	                     snapshot_sha256=snapshot_sha256, scenario=scenario,
   513	                     scenario_sha256=scenario_sha256, decision=_plain(decision),
   514	                     suffix_execution_permitted=False)
   515	        return decision
   516	
   517	    async def _step(self, entered, deadline):
   518	        snapshot = await self._state(deadline, entered_at=entered)
   519	        if self.state["pending"] is not None:
   520	            return self._reconcile(snapshot)
   521	        if self.scenario_factory is None:
   522	            _require(not self.enabled, "causal_scenario_required_for_demo")
   523	            return {"status": "GET_only", "reason": "no_scenario_no_planning", "cap_change_applied": False}
   524	        solve_deadline = entered + self.limits.solve_s
   525	        _require(self._now() < solve_deadline < deadline, "entry_GET_exhausted_solver_window")
   526	        window = DecisionWindow(entered, solve_deadline, solve_deadline,
   527	                                min(deadline, snapshot.sampled_at + 0.5))
   528	        decision = self._decision(snapshot, window)
   529	        self._remaining(deadline)
   530	        action = decision.first_action
   531	        if action.budget == snapshot.budget:
   532	            return {"status": "hold", "cap_change_applied": False, "actual_cap_applied_at": None}
   533	        before = self.state["issued_commands"]
   534	        reason = self._authorize(snapshot, action.budget, entered, deadline, issued=before)
   535	        if reason:
   536	            return {"status": "GET_only" if not self.enabled else "refused", "reason": reason,
   537	                    "cap_change_applied": False}
   538	        delay = action.not_before - self._now()
   539	        if delay > 0:
   540	            _require(delay < self._remaining(deadline), "first_action_not_yet_permitted")
   541	            await self.sleeper(delay)
   542	        _require(self._now() >= action.not_before, "first_action_before_not_before")
   543	        current = await self._state(deadline, entered_at=entered)
   544	        _require(StateVersion.from_snapshot(current) == StateVersion.from_snapshot(snapshot)
   545	                 and current.requests == snapshot.requests, "precommit_observation_changed")
   546	        reason = self._authorize(snapshot, action.budget, entered, deadline, issued=before)
   547	        _require(reason is None, reason or "nominal_authorization")
   548	        now = self._now()
   549	        not_after = min(deadline, self.permit.expires_at, snapshot.sampled_at + 0.5, now + 0.1)
   550	        _require(now < not_after <= action.not_after, "first_action_expired")
   551	        command = {
   552	            "schema": SCHEMA, "run_id": snapshot.run_id, "clock_domain": snapshot.clock_domain,
   553	            "identity": asdict(self.identity), "expected_version": snapshot.budget_version,
   554	            "operation_id": f"nominal-{self.state['controller_id']}-{before + 1}",
   555	            "budget": action.budget, "not_after": not_after,
   556	        }
   557	        body = json.dumps(command, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
   558	        self.state["issued_commands"] = before + 1
   559	        self.state["pending"] = {"command": command, "ordinal": before + 1, "ack": None}
   560	        self._record("PendingPrepared", ordinal=before + 1, command=command,
   561	                     entered_at=entered, deadline=deadline, not_before=action.not_before,
   562	                     exact_POST_body_sha256=hashlib.sha256(body).hexdigest())
   563	        # Count includes this durable reservation. Recheck that same reservation,
   564	        # not authorization for a second command, after fsync consumed real time.
   565	        reason = self._authorize(snapshot, action.budget, entered, deadline, issued=before)
   566	        _require(reason is None, reason or "nominal_authorization_after_persist")
   567	        self._remaining(not_after)
   568	        post_started = self._now()
   569	        status, raw = await self._wire("POST", "/admin/mpc/budget", deadline, command=command, body=body)
   570	        reply = _strict(raw)
   571	        valid = (
   572	            status == 200 and type(reply) is dict and reply.get("schema") == SCHEMA
   573	            and reply.get("status") == "applied" and reply.get("operation_id") == command["operation_id"]
   574	            and reply.get("run_id") == command["run_id"] and reply.get("clock_domain") == command["clock_domain"]
   575	            and type(reply.get("budget_version")) is int
   576	            and reply["budget_version"] == command["expected_version"] + 1
   577	            and finite(reply.get("budget")) and reply["budget"] == command["budget"]
   578	            and finite(reply.get("previous_budget")) and reply["previous_budget"] == snapshot.budget
   579	            and finite(reply.get("applied_at"))
   580	            and post_started <= reply["applied_at"] <= self._now()
   581	            and reply["applied_at"] < not_after
   582	        )
   583	        _require(valid, "unknown_POST_outcome_no_fallback")
   584	        self.state["pending"]["ack"] = reply
   585	        self._record("CapApplied", acknowledgment=reply, actual_cap_change=True,
   586	                     scope="Gateway_admission_budget_only", native_token_application_at=None)
   587	        observed = await self._state(deadline, entered_at=entered)
   588	        return self._reconcile(observed)
   589	
   590	    async def run(self):
   591	        call_entered = self._now()
   592	        steps, failure = [], None
   593	        try:
   594	            self._binding()
   595	            with self.store.locked():
   596	                self.state = self.store.read()
   597	                domain = clock_domain()
   598	                if self.state is None:
   599	                    _require(self.start_at is None or call_entered >= self.start_at, "shared_start_not_reached")
   600	                    self.state = {
   601	                        "schema": JOURNAL_SCHEMA, "scope": SCOPE, "controller_id": uuid.uuid4().hex,
   602	                        "identity": asdict(self.identity), "clock_domain": domain,
   603	                        "protocol_sha256": self.protocol_sha256, "run_id": None,
   604	                        "episode_started_at": call_entered, "episode_deadline": call_entered + self.limits.episode_s,
   605	                        "issued_commands": 0, "source_sha256": None, "pending": None, "events": [],
   606	                    }
   607	                    self._record("ProtocolBound", protocol=self.protocol, module_paths=module_paths())
   608	                _require(self.state["identity"] == asdict(self.identity)
   609	                         and self.state["protocol_sha256"] == self.protocol_sha256
   610	                         and self.state["clock_domain"] == domain, "journal_identity_protocol_or_clock_changed")
   611	                for index in range(self.limits.iterations):
   612	                    entered = call_entered if index == 0 else self._now()
   613	                    deadline = min(entered + self.limits.decision_s, self.state["episode_deadline"])
   614	                    if self._now() >= deadline:
   615	                        failure = ("persistent_episode_deadline_exhausted"
   616	                                   if self._now() >= self.state["episode_deadline"]
   617	                                   else "absolute_entry_deadline_exhausted")
   618	                        break
   619	                    try:
   620	                        row = await self._step(entered, deadline)
   621	                    except asyncio.CancelledError:
   622	                        self._record("Cancelled", pending_unknown=self.state["pending"] is not None)
   623	                        raise
   624	                    except OSError:
   625	                        raise
   626	                    except Exception as error:
   627	                        pending = self.state["pending"]
   628	                        ack = pending["ack"] if pending else None
   629	                        row = {"status": "pending" if self.state["pending"] else "refused",
   630	                               "reason": str(error).replace(self.admin_key, "[REDACTED_AUTH]")[:1024],
   631	                               "error_type": type(error).__name__,
   632	                               "cap_change_applied": True if ack else (None if pending else False),
   633	                               "actual_cap_applied_at": ack["applied_at"] if ack else None,
   634	                               "native_token_application_at": None}
   635	                    row.update(entered_at=entered, deadline=deadline, outcome_observed_at=self._now())
   636	                    self._record("StepFinished", **row)
   637	                    row["finished_at"] = self._now()
   638	                    row["elapsed_s"] = row["finished_at"] - entered
   639	                    row["deadline_met"] = row["finished_at"] <= deadline
   640	                    steps.append(row)
   641	                    if index + 1 < self.limits.iterations and self.limits.poll_s:
   642	                        remaining = self.state["episode_deadline"] - self._now()
   643	                        if remaining <= 0:
   644	                            break
   645	                        await self.sleeper(min(self.limits.poll_s, remaining))
   646	        except asyncio.CancelledError:
   647	            raise
   648	        except Exception as error:
   649	            failure = type(error).__name__ + ":" + str(error).replace(self.admin_key, "[REDACTED_AUTH]")[:1024]
   650	        pending = self.state["pending"] if self.state else None
   651	        return {
   652	            "scope": SCOPE, "mode": "experimental_nominal_demo" if self.enabled else "GET_only",
   653	            "steps": steps, "failure": failure, "issued_commands": self.state["issued_commands"] if self.state else None,
   654	            "pending": self.state["pending"] is not None if self.state else None,
   655	            "pending_outcome": ("unknown" if pending["ack"] is None else "ACK_requires_reobservation")
   656	            if pending else None,
   657	            "episode_deadline": self.state["episode_deadline"] if self.state else None,
   658	            "protocol_sha256": self.protocol_sha256, "ledger_CAS": False,
   659	            "Native_qualified": False, "native_token_application_at": None,
   660	            "objective": OBJECTIVE_ID, "static_Fixed_FIFO_benchmark_implemented": False,
   661	        }
