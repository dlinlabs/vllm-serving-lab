    83	def _strict(raw):
    84	    def pairs(items):
    85	        result = {}
    86	        for key, value in items:
    87	            _require(key not in result, "duplicate_JSON_key")
    88	            result[key] = value
    89	        return result
    90	
    91	    def constant(value):
    92	        raise RuntimeRefused("nonfinite_JSON")
    93	
    94	    return json.loads(raw, object_pairs_hook=pairs, parse_constant=constant)
    95	
