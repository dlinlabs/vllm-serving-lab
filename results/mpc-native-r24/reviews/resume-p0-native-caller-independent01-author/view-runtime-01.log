   664	def _load_permit(path):
   665	    _require(path.is_file() and not path.is_symlink() and path.stat().st_size <= 65536,
   666	             "separate_regular_nominal_permit_required")
   667	    document = _strict(path.read_bytes())
   668	    _require(type(document) is dict and set(document) == {field.name for field in fields(NominalDemoPermit)},
   669	             "nominal_permit_fields")
   670	    document["identity"] = Identity(**document["identity"])
   671	    return NominalDemoPermit(**document)
