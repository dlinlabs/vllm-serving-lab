   674	def load_causal_scenario(path):
   675	    """Load one frozen development/TRAIN-derived forecast, never a replay tape.
   676	
   677	    The file's actual digest is protocol-bound. Its cutoff/availability must use
   678	    this host's monotonic clock. The producer's Train-only provenance still needs
   679	    an independent audit; this loader does not infer a forecast from Eval offers.
   680	    """
   681	    from mpc_lab.contracts import FutureOffer, Scenario
   682	
   683	    path = Path(path)
   684	    _require(path.is_file() and not path.is_symlink() and path.stat().st_size <= MAX_BODY,
   685	             "regular_bounded_causal_scenario_file_required")
   686	    raw = path.read_bytes()
   687	    _require(len(raw) <= MAX_BODY, "causal_scenario_file_limit")
   688	    document = _strict(raw)
   689	    _require(set(document) == {"clock_domain", "information_cutoff_at", "available_at", "origin", "purpose", "scenario"}
   690	             and document["clock_domain"] == clock_domain()
   691	             and document["origin"] in ("development", "past_observations")
   692	             and document["purpose"] in ("train", "evaluation", "engineering"),
   693	             "causal_scenario_file_clock_or_fields")
   694	    scenario = dict(document["scenario"])
   695	    scenario["offers"] = tuple(FutureOffer(**row) for row in scenario["offers"])
   696	    scenario = Scenario(**scenario)
   697	    fingerprint = hashlib.sha256(raw).hexdigest()
   698	
   699	    def factory(snapshot):
   700	        _require(snapshot.clock_domain == document["clock_domain"] == clock_domain(),
   701	                 "causal_scenario_clock_changed")
   702	        return CausalScenario(scenario, StateVersion.from_snapshot(snapshot), fingerprint,
   703	                              document["information_cutoff_at"], document["available_at"],
   704	                              document["origin"], document["purpose"])
   705	
   706	    return factory, {"file_sha256": fingerprint, "origin": document["origin"], "purpose": document["purpose"]}
   707	
   708	
   709	def load_train_scenario(path, *, purpose, clock=time.monotonic):
   710	    """Freeze Train once; bind static content, not the new process's availability."""
   711	    import nominal_scenario as producer
   712	
   713	    module_paths()
   714	    _require(purpose in ("train", "evaluation", "engineering"), "explicit_forecast_purpose_required")
   715	    prior = producer.freeze_train_prior(path, purpose="train", clock_domain=clock_domain(), clock=clock)
   716	    content = {key: value for key, value in asdict(prior).items()
   717	               if key not in ("clock_domain", "available_at")}
   718	    sources = {
   719	        "nominal_scenario.py": hashlib.sha256(Path(producer.__file__).read_bytes()).hexdigest(),
   720	        "nominal_workload.py": hashlib.sha256(Path(producer.workload.__file__).read_bytes()).hexdigest(),
   721	    }
   722	    binding = {
   723	        "provider": "frozen-Train-nominal-scenario-v1", "purpose": purpose,
   724	        "prior_content": content, "prior_content_sha256": prior.content_sha256,
   725	        "clock_domain": prior.clock_domain, "producer_sources": sources,
   726	        "rng": {
   727	            "namespace": producer.RNG_NAMESPACE, "seed": producer.RNG_SEED,
   728	            "runtime": f"Python {sys.version.split()[0]} stdlib random.Random(str, version=2)/expovariate/randrange",
   729	            "horizon_s": producer.HORIZON_S, "max_offers": producer.MAX_OFFERS,
   730	        },
   731	        "assumptions": producer.ASSUMPTIONS,
   732	    }
   733	
   734	    def factory(snapshot):
   735	        return producer.make_scenario(prior, snapshot, purpose=purpose, clock=clock).causal
   736	
   737	    return factory, binding
