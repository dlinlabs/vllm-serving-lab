   203	class _Journal:
   204	    def __init__(self, path):
   205	        self.path = Path(path).absolute()
   206	        self.partial = self.path.with_name(self.path.name + ".partial")
   207	
   208	    @contextmanager
   209	    def locked(self):
   210	        self.path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
   211	        descriptor = os.open(self.path.with_name(self.path.name + ".lock"),
   212	                             os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
   213	        try:
   214	            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
   215	            _require(not self.partial.exists() and not self.partial.is_symlink(),
   216	                     "unclean_journal_commit_preserved")
   217	            yield
   218	        finally:
   219	            os.close(descriptor)
   220	
   221	    def read(self):
   222	        if not self.path.exists():
   223	            return None
   224	        _require(not self.path.is_symlink() and self.path.stat().st_size <= MAX_JOURNAL,
   225	                 "journal_file_invalid")
   226	        value = _strict(self.path.read_bytes())
   227	        keys = {"schema", "scope", "controller_id", "identity", "clock_domain", "protocol_sha256",
   228	                "run_id", "episode_started_at", "episode_deadline", "issued_commands",
   229	                "source_sha256", "pending", "events"}
   230	        _require(type(value) is dict and set(value) == keys and value["schema"] == JOURNAL_SCHEMA
   231	                 and value["scope"] == SCOPE and type(value["controller_id"]) is str
   232	                 and len(value["controller_id"]) == 32
   233	                 and type(value["issued_commands"]) is int and 0 <= value["issued_commands"] <= 8
   234	                 and type(value["events"]) is list and len(value["events"]) <= MAX_EVENTS
   235	                 and all(type(event) is dict and type(event.get("event")) is str
   236	                         for event in value["events"])
   237	                 and _sha(value["protocol_sha256"]), "journal_invalid")
   238	        _require(all(finite(value[key]) for key in ("episode_started_at", "episode_deadline"))
   239	                 and 0 <= value["episode_started_at"] < value["episode_deadline"]
   240	                 <= value["episode_started_at"] + 60, "journal_episode_invalid")
   241	        prepared = [event for event in value["events"] if event.get("event") == "PendingPrepared"]
   242	        _require([event.get("ordinal") for event in prepared]
   243	                 == list(range(1, value["issued_commands"] + 1)), "journal_count_invalid")
   244	        pending = value["pending"]
   245	        resolved = [event["pending"]["ordinal"] for event in value["events"]
   246	                    if event["event"] in ("CapReobserved", "UnknownFenced")]
   247	        _require(resolved == list(range(1, value["issued_commands"] + (pending is None))),
   248	                 "journal_unresolved_command_cannot_disappear")
   249	        if pending is not None:
   250	            _require(type(pending) is dict and set(pending) == {"command", "ordinal", "ack"}
   251	                     and pending["ordinal"] == value["issued_commands"] > 0
   252	                     and prepared[-1]["command"] == pending["command"], "journal_pending_invalid")
   253	            command = pending["command"]
   254	            _require(set(command) == {"schema", "run_id", "clock_domain", "identity",
   255	                                     "expected_version", "operation_id", "budget", "not_after"}
   256	                     and command["schema"] == SCHEMA and command["run_id"] == value["run_id"]
   257	                     and command["identity"] == value["identity"]
   258	                     and command["clock_domain"] == value["clock_domain"]
   259	                     and command["operation_id"] == f"nominal-{value['controller_id']}-{pending['ordinal']}"
   260	                     and type(command["expected_version"]) is int and command["expected_version"] >= 0
   261	                     and finite(command["budget"]) and command["budget"] in BUDGETS
   262	                     and finite(command["not_after"])
   263	                     and value["episode_started_at"] < command["not_after"] <= value["episode_deadline"]
   264	                     and _sha(value["source_sha256"]), "journal_pending_binding")
   265	            ack = pending["ack"]
   266	            if ack is not None:
   267	                _require(type(ack) is dict and ack.get("schema") == SCHEMA
   268	                         and ack.get("status") == "applied"
   269	                         and all(ack.get(key) == command[key] for key in
   270	                                 ("run_id", "clock_domain", "operation_id", "budget"))
   271	                         and type(ack.get("budget_version")) is int
   272	                         and ack["budget_version"] == command["expected_version"] + 1
   273	                         and finite(ack.get("applied_at"))
   274	                         and prepared[-1]["not_before"] <= ack["applied_at"] < command["not_after"]
   275	                         and any(event["event"] == "CapApplied" and event.get("acknowledgment") == ack
   276	                                 for event in value["events"]), "journal_ACK_invalid")
   277	        return value
   278	
   279	    def save(self, value):
   280	        raw = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
   281	        _require(len(raw) <= MAX_JOURNAL and len(value["events"]) <= MAX_EVENTS,
   282	                 "journal_capacity_preserve_and_stop")
   283	        fd = os.open(self.partial, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
   284	        with os.fdopen(fd, "wb") as stream:
   285	            stream.write(raw)
   286	            stream.flush()
   287	            os.fsync(stream.fileno())
   288	        os.replace(self.partial, self.path)
   289	        directory = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
   290	        try:
   291	            os.fsync(directory)
   292	        finally:
   293	            os.close(directory)
