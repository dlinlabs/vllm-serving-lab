   121	@dataclass(frozen=True)
   122	class RuntimeLimits:
   123	    iterations: int = 4
   124	    episode_s: float = 4.0
   125	    decision_s: float = 0.5
   126	    solve_s: float = 0.1
   127	    poll_s: float = 0.0
   128	
   129	    def __post_init__(self):
   130	        _require(type(self.iterations) is int and 1 <= self.iterations <= 32, "iteration_limit")
   131	        _require(all(finite(value) for value in (self.episode_s, self.decision_s, self.solve_s, self.poll_s))
   132	                 and 0 < self.episode_s <= 60 and 0 < self.solve_s <= 0.1
   133	                 and self.solve_s < self.decision_s <= 0.5 and 0 <= self.poll_s <= 1,
   134	                 "invalid_runtime_deadlines")
