    71	def _plain(value):
    72	    if is_dataclass(value):
    73	        return _plain(asdict(value))
    74	    if isinstance(value, Fraction):
    75	        return {"numerator": value.numerator, "denominator": value.denominator}
    76	    if isinstance(value, dict):
    77	        return {key: _plain(item) for key, item in value.items()}
    78	    if isinstance(value, (tuple, list)):
    79	        return [_plain(item) for item in value]
    80	    return value
    81	
