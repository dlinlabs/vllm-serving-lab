   158	def _protocol(parameters, policy, limits, scenario_binding, endpoint, journal_path, start_at=None):
   159	    module_paths()
   160	    endpoint = _root_endpoint(endpoint)
   161	    _require(type(parameters) is ModelParameters and type(limits) is RuntimeLimits
   162	             and policy in ("mpc", "one_move"), "typed_nominal_protocol_required")
   163	    _require(start_at is None or finite(start_at) and start_at >= 0, "invalid_shared_start")
   164	    value = {
   165	        "scope": SCOPE, "runtime": JOURNAL_SCHEMA, "planner_contract": CONTRACT_SHA256,
   166	        "objective": OBJECTIVE_ID, "parameters": asdict(parameters), "policy": policy,
   167	        "limits": asdict(limits), "scenario_binding": scenario_binding,
   168	        "endpoint": endpoint, "journal_path": str(Path(journal_path).absolute()),
   169	        "max_commands": 8, "source_age_s": 0.5, "command_ttl_s": 0.1,
   170	        "precommit_observation_equality": True, "ledger_CAS": False,
   171	        "Fixed_FIFO": "separate_static_preoffer_setup_not_implemented",
   172	    }
   173	    if start_at is not None:
   174	        value["start_at"] = start_at
   175	        value["CLI_start_envelope_s"] = 60.0
   176	    return _strict(json.dumps(value, allow_nan=False))
