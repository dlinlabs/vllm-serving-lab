   159	def http_client():
   160	    import httpx
   161	    return httpx.AsyncClient(trust_env=False, follow_redirects=False)
   162	
   163	
   164	async def read_ready(cutoff, key, event):
   165	    values = {}
   166	    async with asyncio.timeout_at(cutoff), http_client() as client:
   167	        for name, url in (
   168	                ("health", f"http://127.0.0.1:{BACKEND_PORT}/health"),
   169	                ("models", f"http://127.0.0.1:{BACKEND_PORT}/v1/models"),
   170	                ("metrics", f"http://127.0.0.1:{GATEWAY_PORT}/metrics"),
   171	                ("state", f"http://127.0.0.1:{GATEWAY_PORT}/admin/mpc/state")):
   172	            remaining = cutoff - time.monotonic()
   173	            checked(remaining > 0, "readiness original deadline")
   174	            started = stamp()
   175	            response = await client.get(url, timeout=min(2, remaining),
   176	                                        headers={"x-admin-api-key": key} if name == "state" else {})
   177	            event(dict(kind="GET", name=name, start=started, end=stamp(), status=response.status_code,
   178	                       body=response.text[:65536], body_truncated=len(response.text) > 65536))
   179	            if response.status_code in (502, 503):
   180	                raise ConnectionError("service not ready")
   181	            checked(response.status_code == 200, "readiness HTTP status mismatch")
   182	            try:
   183	                values[name] = None if name == "health" else response.json()
   184	            except ValueError as error:
   185	                raise ProbeError("non-JSON readiness response") from error
   186	    return values
   187	
   188	
   189	def validate_ready(values, expected):
   190	    metrics, state = values["metrics"], values["state"]
   191	    checked({row["id"] for row in values["models"]["data"]} == {ALIAS}, "served alias mismatch")
   192	    checked(metrics["tokenizer_available"] is True and metrics["tokenizer_fallback_requests"] == 0
   193	            and metrics["tokenizer_model"] == MODEL, "tokenizer unavailable/fallback/mismatch")
   194	    checked(metrics["admission_mode"] == "cost_aware" and metrics["max_admitted_cost"] == 32
   195	            and metrics["initial_admission_budget"] == 32 and metrics["budget_version"] == 0,
   196	            "fixed startup cap mismatch")
   197	    checked(all(metrics[name] == 0 for name in ("accepted_requests", "rejected_requests",
   198	            "failed_requests", "current_in_flight", "current_waiting", "current_admitted_cost")),
   199	            "unexpected request activity")
   200	    checked(metrics["shared_upstream_client"] is True, "shared transport missing")
   201	    checked(state["identity"] == expected["identity"]
   202	            and state["cost_spec"] == expected["cost_spec"]
   203	            and state["clock_domain"] == expected["clock_domain"], "source/CostSpec/clock identity mismatch")
   204	
