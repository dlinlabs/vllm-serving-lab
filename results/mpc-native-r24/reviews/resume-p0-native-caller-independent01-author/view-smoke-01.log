   142	def gpu_receipt(deadline):
   143	    result = dict(start=stamp(), argv=[], commands=[])
   144	    for query in ("--query-gpu=uuid,name", "--query-compute-apps=gpu_uuid,pid,used_memory"):
   145	        remaining = deadline - time.monotonic()
   146	        checked(remaining > 0, "no original GPU-receipt budget")
   147	        argv = ["nvidia-smi", "-i", GPU, query, "--format=csv,noheader,nounits"]
   148	        process = subprocess.run(argv, capture_output=True, text=True, timeout=min(5, remaining))
   149	        result["argv"].append(argv)
   150	        result["commands"].append(dict(returncode=process.returncode, stdout=process.stdout, stderr=process.stderr))
   151	    result["end"] = stamp()
   152	    result["idle_selected_gpu"] = (
   153	        all(row["returncode"] == 0 for row in result["commands"])
   154	        and result["commands"][0]["stdout"].split(",")[0].strip() == GPU
   155	        and result["commands"][1]["stdout"].strip() == "")
   156	    return result
