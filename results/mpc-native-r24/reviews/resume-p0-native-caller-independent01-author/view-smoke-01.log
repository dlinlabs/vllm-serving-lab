    38	def stamp():
    39	    return dict(monotonic=time.monotonic(), unix_ns=time.time_ns())
    40	
    41	
    42	def write(path, value, secret="", append=False):
    43	    text = json.dumps(value, sort_keys=True, allow_nan=False)
    44	    if secret:
    45	        text = text.replace(secret, "<redacted>")
    46	    with path.open("a" if append else "x") as stream:
    47	        stream.write(text + "\n")
    48	        stream.flush()
    49	        os.fsync(stream.fileno())
