   206	def owner_scope(config, output, deadline, ready, key, args):
   207	    from nominal_services import NominalServices, Service
   208	    services = tuple(Service(name, tuple(config[name]),
   209	                             dict(config["safe_environment"][name],
   210	                                  **({"ADMIN_API_KEY": key} if name == "gateway" else {})),
   211	                             tuple(config[name])) for name in ("engine", "gateway"))
   212	    return NominalServices(services, lock_paths=LOCKS, run_dir=output / "services",
   213	                           deadline=deadline, ready=ready, execute=True,
   214	                           cleanup_reserve=args.cleanup_reserve, term_grace=args.term_grace)
   215	
   216	
   217	def run(args, *, body=None):
   218	    if not args.execute:
   219	        return 2
   220	    checked(args.source_root and args.output_root, "explicit source/output roots required")
   221	    root, output = Path(args.source_root), Path(args.output_root)
   222	    checked(root.is_absolute() and output.is_absolute(), "absolute source/output roots required")
   223	    checked(all(math.isfinite(x) for x in (args.seconds, args.cleanup_reserve, args.term_grace))
   224	            and 0 < args.term_grace < args.cleanup_reserve < args.seconds, "invalid original budget")
   225	    root, output = root.resolve(strict=True), output.absolute()
   226	    os.umask(0o077)
   227	    output.mkdir(mode=0o700)
   228	    began = stamp()
   229	    deadline, key, scope = began["monotonic"] + args.seconds, "", None
   230	    report = dict(start=began, deadline_monotonic=deadline, cleanup_reserve=args.cleanup_reserve,
   231	                  term_grace=args.term_grace, lifecycle_passed=False, offered_requests_from_driver=0,
   232	                  admin_POSTs=0, inference_or_MPC_or_benchmark_result=False, native_qualification=False,
   233	                  actual_execution_authority="external Mayor preregistration, not this flag or protocol",
   234	                  ownership_receipt=None, post_gpu=None, errors=[])
   235	
   236	    def event(value):
   237	        write(output / "events.jsonl", value, key, append=True)
   238	
   239	    try:
   240	        protocol_path = root / RELATIVE / "nominal_protocol.json"
   241	        protocol = json.loads(protocol_path.read_text())
   242	        expected = source_info(root)
   243	        report["source"] = expected
   244	        config = configuration(root, output, protocol, expected["identity"])
   245	        report["configuration"] = config
   246	        for name in ("scratch", "cache"):
   247	            (output / name).mkdir()
   248	        checked(existing_assets(config), "missing existing local assets/entrypoint")
   249	        write(output / "frozen-run-inputs.json", dict(report, frozen_before_service_spawn=True))
   250	        report["pre_gpu"] = gpu_receipt(deadline)
   251	        write(output / "pre-gpu.json", report["pre_gpu"])
   252	        checked(report["pre_gpu"]["idle_selected_gpu"], "selected GPU not proven idle")
   253	        key = secrets.token_hex(32)
   254	        cutoff = deadline - args.cleanup_reserve
   255	
   256	        def ready(owner, remaining):
   257	            try:
   258	                values = asyncio.run(read_ready(cutoff, key, event))
   259	            except ProbeError:
   260	                raise
   261	            except Exception as error:
   262	                event(dict(kind="readiness_retry", at=stamp(), error_type=type(error).__name__))
   263	                time.sleep(min(.5, max(0, cutoff - time.monotonic())))
   264	                return False
   265	            event(dict(kind="readiness_values", at=stamp(), values=values))
   266	            validate_ready(values, expected)
   267	            report["readiness"] = dict(at=stamp(), values=values)
   268	            return True
   269	
   270	        event(dict(kind="ownership_enter_begin", at=stamp()))
   271	        scope = owner_scope(config, output, deadline, ready, key, args)
   272	        with scope as owner:
   273	            owner.check()
   274	            report["ready_body"] = stamp()
   275	            if body is not None:
   276	                report.update(inference_or_MPC_or_benchmark_result=True,
   277	                              offered_requests_from_driver=None, admin_POSTs=None)
   278	                body(owner=owner, root=root, output=output, key=key, report=report)
   279	        report["ownership_exit_returned"] = stamp()
   280	    except BaseException as error:
   281	        report["errors"].append(dict(type=type(error).__name__, message=str(error)))
   282	        event(dict(kind="failure", at=stamp(), type=type(error).__name__, message=str(error)))
   283	        if not isinstance(error, Exception):
   284	            raise
   285	    finally:
   286	        try:
   287	            receipt_path = output / "services/ownership.json"
   288	            if receipt_path.is_file():
   289	                report["ownership_receipt"] = json.loads(receipt_path.read_text())
   290	        except Exception as error:
   291	            report["errors"].append(dict(type=type(error).__name__, message=str(error)))
   292	        receipt = report["ownership_receipt"]
   293	        closed = False
   294	        try:
   295	            closed = bool(receipt and receipt.get("status") == "STOPPED"
   296	                          and receipt.get("known_identities_gone") is True
   297	                          and receipt.get("unknown") == [] and receipt.get("pending_spawn") is None
   298	                          and receipt.get("lock_paths") == sorted(LOCKS)
   299	                          and scope is not None
   300	                          and (scope._thread is None or not scope._thread.is_alive()) and scope._gone())
   301	        except Exception as error:
   302	            report["errors"].append(dict(type=type(error).__name__, message=str(error)))
   303	        report["known_closure_checked"] = dict(at=stamp(), closed=closed)
   304	        if not closed:
   305	            report["errors"].append(dict(
   306	                type="OwnershipNotClosed",
   307	                message="No joined STOPPED/known-gone exact-lock receipt; post-GPU call skipped"))
   308	        if closed:
   309	            try:
   310	                report["post_gpu"] = gpu_receipt(deadline)
   311	                write(output / "post-gpu.json", report["post_gpu"])
   312	                status = json.loads((output / "telemetry-status.json").read_text())
   313	                report["telemetry_status"] = status
   314	                checked(status["status"] == "closed" and status["mpc_ledger_complete"] is True
   315	                        and all(status[name] == 0 for name in (
   316	                            "dropped", "write_errors", "mpc_remaining_requests",
   317	                            "mpc_unflushed_records", "mpc_final_sequence", "mpc_producer_final_sequence")),
   318	                        "telemetry closure or no-request ledger mismatch")
   319	                checked(report["post_gpu"]["idle_selected_gpu"], "post GPU not proven idle")
   320	            except Exception as error:
   321	                report["errors"].append(dict(type=type(error).__name__, message=str(error)))
   322	        report["end"] = stamp()
   323	        report["lifecycle_passed"] = bool(
   324	            not report["errors"] and closed and "readiness" in report
   325	            and "ownership_exit_returned" in report
   326	            and report["post_gpu"] and report["end"]["monotonic"] <= deadline)
   327	        write(output / "report.json", report, key)
   328	    return 0 if report["lifecycle_passed"] else 1
   329	
   330	
   331	def main(argv=None):
   332	    parser = argparse.ArgumentParser(description=__doc__)
   333	    parser.add_argument("--execute", action="store_true")
   334	    parser.add_argument("--source-root")
   335	    parser.add_argument("--output-root")
   336	    parser.add_argument("--seconds", type=float, default=480)
   337	    parser.add_argument("--cleanup-reserve", type=float, default=30)
   338	    parser.add_argument("--term-grace", type=float, default=10)
   339	    return run(parser.parse_args(argv))
   340	
   341	
   342	if __name__ == "__main__":
   343	    raise SystemExit(main())
