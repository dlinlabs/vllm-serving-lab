    57	def configuration(root, output, protocol, identity):
    58	    backend = protocol["backend"]
    59	    checked(tuple(protocol["hardware"]["lock_paths"]) == LOCKS
    60	            and protocol["hardware"]["gpu_uuid"] == GPU, "production lock/GPU mismatch")
    61	    checked(backend["local_assets"] == MODEL and backend["served_alias"] == ALIAS
    62	            and backend["tokenizer_fingerprint"] == TOKENIZER
    63	            and backend["required_common_settings"] == SETTINGS, "backend proposal mismatch")
    64	    checked(protocol["controller"]["model_version"] == "cpu-lifecycle-v1"
    65	            and protocol["controller"]["calibration_version"] == "synthetic-unqualified-v1",
    66	            "nominal labels mismatch")
    67	    checked(identity["model_version"] == protocol["controller"]["model_version"]
    68	            and identity["calibration_version"] == protocol["controller"]["calibration_version"],
    69	            "local ModelParameters labels mismatch")
    70	    env = dict(PATH=str(Path(sys.executable).parent) + os.pathsep + os.environ.get("PATH", os.defpath),
    71	               HOME=os.environ.get("HOME", str(output)),
    72	               CUDA_VISIBLE_DEVICES=GPU, HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1",
    73	               HF_DATASETS_OFFLINE="1", PYTHONDONTWRITEBYTECODE="1",
    74	               OMP_NUM_THREADS="1", OPENBLAS_NUM_THREADS="1", MKL_NUM_THREADS="1",
    75	               NUMEXPR_NUM_THREADS="1", TMPDIR=str(output / "scratch"),
    76	               XDG_CACHE_HOME=str(output / "cache"),
    77	               VLLM_CACHE_ROOT=str(output / "cache/vllm"),
    78	               TORCHINDUCTOR_CACHE_DIR=str(output / "cache/inductor"),
    79	               TRITON_CACHE_DIR=str(output / "cache/triton"))
    80	    gateway_env = dict(env, VLLM_URL=f"http://127.0.0.1:{BACKEND_PORT}", MODEL_NAME=MODEL,
    81	                       ADMISSION_MODE="cost_aware", MAX_ADMITTED_COST="32",
    82	                       MPC_LAB_ENABLED="true", MPC_OWNER_LEDGER_ENABLED="true",
    83	                       MPC_TOKENIZER_IDENTITY=TOKENIZER, MPC_MODEL_VERSION=identity["model_version"],
    84	                       MPC_CALIBRATION_VERSION=identity["calibration_version"],
    85	                       MPC_SUPPORT_HASH=identity["support_hash"],
    86	                       COST_INTERCEPT="0.259", INPUT_TOKEN_COST="0.000758",
    87	                       OUTPUT_TOKEN_COST="0.0052083333", MIN_REQUEST_COST="0.1",
    88	                       DEFAULT_MAX_TOKENS="128", WEB_CONCURRENCY="1", UVICORN_WORKERS="1",
    89	                       SHARED_UPSTREAM_CLIENT="1", BENCHMARK_REQUEST_IDS="1",
    90	                       TELEMETRY_JSONL=str(output / "telemetry.jsonl"),
    91	                       TELEMETRY_STATUS_JSON=str(output / "telemetry-status.json"))
    92	    return dict(lock_paths=list(LOCKS), safe_environment=dict(engine=env, gateway=gateway_env),
    93	                engine=[str(Path(sys.executable).parent / "vllm"), "serve", MODEL,
    94	                        "--served-model-name", ALIAS, "--host", "127.0.0.1", "--port", str(BACKEND_PORT),
    95	                        "--scheduling-policy", "fcfs", "--no-enable-prefix-caching",
    96	                        "--max-model-len", "8192", "--max-num-seqs", "256",
    97	                        "--max-num-batched-tokens", "8192", "--gpu-memory-utilization", "0.9",
    98	                        "--tensor-parallel-size", "1"],
    99	                gateway=[sys.executable, "-m", "uvicorn", "gateway:app", "--app-dir", str(root),
   100	                         "--host", "127.0.0.1", "--port", str(GATEWAY_PORT), "--workers", "1"])
