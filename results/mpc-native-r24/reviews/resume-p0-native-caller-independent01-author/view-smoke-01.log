   103	def source_info(root):
   104	    sys.path[:0] = [str(root), str(root / RELATIVE)]
   105	    for name, module in tuple(sys.modules.items()):
   106	        if name == "mpc_lab" or name.startswith("mpc_lab.") or name == "prefill_lab" or name.startswith("prefill_lab."):
   107	            checked(getattr(module, "__file__", None)
   108	                    and Path(module.__file__).resolve().is_relative_to(root),
   109	                    "stale cached SDK module; use isolated source-root process")
   110	    import mpc_lab.contracts as contracts
   111	    import prefill_lab.live_http as live
   112	    import nominal_services
   113	
   114	    checked(Path(contracts.__file__).resolve() == root / "mpc_lab/contracts.py"
   115	            and Path(live.__file__).resolve() == root / "prefill_lab/live_http.py"
   116	            and Path(nominal_services.__file__).resolve() == root / RELATIVE / "nominal_services.py",
   117	            "source bootstrap mismatch")
   118	    paths = [root / "gateway.py", root / RELATIVE / "nominal_protocol.json",
   119	             root / RELATIVE / "nominal_services.py", Path(__file__).resolve(),
   120	             Path(contracts.__file__).resolve(), Path(live.__file__).resolve()]
   121	    pins = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}
   122	    checked(pins[str(root / RELATIVE / "nominal_services.py")] == HELPER_SHA,
   123	            "accepted ownership helper changed")
   124	    versions = {name: importlib.metadata.version(name) for name in ("vllm", "httpx", "uvicorn", "transformers")}
   125	    versions["python"] = platform.python_version()
   126	    checked(versions["python"] == "3.12.3" and versions["vllm"] == "0.30.0",
   127	            "preregistered host version mismatch")
   128	    spec = contracts.CostSpec(
   129	        intercept=.259, input_per_token=.000758, output_per_token=.0052083333, minimum=.1,
   130	        default_max_tokens=128,
   131	        tokenizer_identity=TOKENIZER + f";model={MODEL};available=True;fallback=chars4-chat-v1")
   132	    identity = contracts.ModelParameters(cost_spec=spec).identity
   133	    return dict(identity=asdict(identity), cost_spec=asdict(spec),
   134	                cost_spec_fingerprint=spec.fingerprint, clock_domain=live.clock_domain(),
   135	                versions=versions, source_pins=pins, evidence_kind="ACTUAL_HOST_COMPONENT_ONLY")
