   803	class PreparedCapture:
   804	    """``prepare_capture`` result: the raw-v2 envelope (``capture``) and its validated trace; single use."""
   805	
   806	    __slots__ = ('capture', 'trace', 'ready', 'started')
   807	
   808	    def __init__(self, capture):
   809	        self.capture, self.trace, self.ready, self.started = capture, None, False, False
