   812	def prepare_capture(*, trace_path, binding_path, arm, purpose, gateway_url, backend_url, request_timeout=120.0,
   813	                    tokenizer_loader=load_tokenizer):
   814	    """Synchronous library preflight (no HTTP, event loop, signal handler or offer): the CLI envelope, strict
   815	    trace/binding/URL/purpose loading and the local binding + tokenizer checks, before any offered start exists.
   816	
   817	    Refusals and failures are returned (``ready`` False, status 'refused'/'failed' with its error), never raised.  A
   818	    ready envelope keeps status 'failed' with NOT_RUN_ERROR until ``capture_replay`` records its outcome.
   819	    """
   820	    capture = _new_capture(arm if isinstance(arm, str) else None, purpose if isinstance(purpose, str) else None,
   821	                           'nominal_client.prepare_capture', None, {
   822	                               'entry': 'library', 'gateway_url': None, 'backend_url': None, 'drain_timeout_s': None,
   823	                               'request_timeout_s': request_timeout if _finite(request_timeout) else None,
   824	                               'start_delay_s': None, 'driver_offered_start': None, 'caller_deadline': None,
   825	                               'cleanup_reserve_s': None, 'caller_clock_domain': None,
   826	                               'trace_path': str(trace_path), 'binding_path': str(binding_path)})
   827	    prepared = PreparedCapture(capture)
   828	    try:
   829	        if arm not in nm.RUN_ARMS:
   830	            raise ClientRefusal(f'arm must be one of {list(nm.RUN_ARMS)}')
   831	        if not isinstance(purpose, str):
   832	            raise ClientRefusal('purpose must be a string')
   833	        try:
   834	            _purpose(purpose)
   835	        except argparse.ArgumentTypeError as exc:
   836	            raise ClientRefusal(f'purpose refused: {exc}') from exc
   837	        if not _finite(request_timeout) or request_timeout <= 0:
   838	            raise ClientRefusal('request_timeout must be a finite number > 0')
   839	        trace = _load_inputs(capture, trace_path, binding_path, gateway_url, backend_url, purpose,
   840	                             ('gateway_url', 'backend_url'))
   841	        _preflight_local(capture, trace, capture['binding'], tokenizer_loader)
   842	    except Exception as exc:
   843	        _settle(capture, exc)
   844	        return prepared
   845	    capture['error'] = NOT_RUN_ERROR
   846	    prepared.trace, prepared.ready = trace, True
   847	    return prepared
