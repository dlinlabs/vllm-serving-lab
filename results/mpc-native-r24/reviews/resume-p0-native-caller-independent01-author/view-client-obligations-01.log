    71	def _settle(capture, ending=None):
    72	    """Status/error from the exception that ended a capture (None: collected), then rows and summary of every
    73	    allocated record; returns the CLI exit code of that status."""
    74	    if ending is None:
    75	        capture['status'], capture['error'] = 'collected', None
    76	    elif isinstance(ending, ClientRefusal):
    77	        capture['status'], capture['error'] = 'refused', f'ClientRefusal: {ending}'
    78	    elif isinstance(ending, (asyncio.CancelledError, KeyboardInterrupt)):
    79	        capture['status'], capture['error'] = 'interrupted', f'{type(ending).__name__}: replay interrupted'
    80	    else:
    81	        capture['status'], capture['error'] = 'failed', f'{type(ending).__name__}: {str(ending)[:300]}'
    82	    if capture['records'] is not None:
    83	        capture['rows'] = [normalized_row(record) for record in capture['records']]
    84	        capture['summary'] = summarize_records(capture['records'])
    85	    return EXIT_CODES[capture['status']]
