  740  async def wait_for_start(runtime, *, cli_entered):
  741      """Wait before run() entry; an existing validated journal resumes its old episode."""
  742      now = runtime._now()
  743      receipt = {"requested_start_at": runtime.start_at, "cli_entered_at": cli_entered,
  744                 "wait_entered_at": now, "resumed_existing_episode": False}
  745      if runtime.start_at is None:
  746          return {**receipt, "wait_finished_at": now}
  747      runtime._binding()
  748      if runtime.store.path.exists():
  749          with runtime.store.locked():
  750              saved = runtime.store.read()
  751          _require(saved is not None and saved["identity"] == asdict(runtime.identity)
  752                   and saved["protocol_sha256"] == runtime.protocol_sha256
  753                   and saved["clock_domain"] == clock_domain()
  754                   and runtime.start_at <= saved["episode_started_at"] <= now < saved["episode_deadline"],
  755                   "shared_start_restart_binding_or_episode_invalid")
  756          return {**receipt, "wait_finished_at": runtime._now(), "resumed_existing_episode": True}
  757      end = cli_entered + 60.0
  758      if runtime.enabled:
  759          _require(type(runtime.permit) is NominalDemoPermit and runtime.permit.approved is True
  760                   and finite(runtime.permit.not_before) and finite(runtime.permit.expires_at)
  761                   and 0 <= runtime.permit.not_before <= runtime.start_at < runtime.permit.expires_at
  762                   and 0 < runtime.permit.expires_at - runtime.permit.not_before <= 60.0,
  763                   "shared_start_outside_nominal_permit")
  764          end = min(end, runtime.permit.expires_at)
  765      _require(finite(cli_entered) and cli_entered <= now <= runtime.start_at
  766               and runtime.start_at + runtime.limits.episode_s <= end,
  767               "shared_start_past_or_outside_envelope")
  768      async with asyncio.timeout(end - now):
  769          remaining = runtime.start_at - runtime._now()
  770          if remaining > 0:
  771              await runtime.sleeper(remaining)
  772      finished = runtime._now()
  773      _require(runtime.start_at <= finished and finished + runtime.limits.episode_s <= end,
  774               "shared_start_wait_exhausted_envelope")
  775      return {**receipt, "wait_finished_at": finished, "CLI_envelope_deadline": end}
