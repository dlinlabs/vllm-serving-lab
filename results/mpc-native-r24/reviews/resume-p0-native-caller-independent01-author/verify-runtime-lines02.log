  180                        policy="mpc", limits=RuntimeLimits(), start_at=None):
  181      """Describe actual frozen bindings without a client, journal write or authority."""
  182      _require(type(planner) is NominalPlanner, "typed_nominal_planner_required")
  183      protocol = _protocol(planner.parameters, policy, limits, scenario_binding, endpoint, journal_path, start_at)
  184      directory = Path(__file__).resolve().parent
  185      names = ("nominal_permit.py", "nominal_planner.py", "nominal_runtime.py",
  186               "nominal_scenario.py", "nominal_workload.py")
  187      bundle = {
  188          "public_implementation": implementation_hash(),
  189          "nominal": {name: hashlib.sha256((directory / name).read_bytes()).hexdigest() for name in names},
  190      }
  191      source = source_digest()
  192      _require(digest(bundle) == source, "source_bundle_description_mismatch")
  193      return {
  194          "scope": SCOPE, "mode": "protocol_description_only",
  195          "protocol": protocol, "protocol_sha256": digest(protocol),
  196          "source_sha256": source, "source_bundle": bundle,
  197          "expected_identity": asdict(planner.identity), "clock_domain": clock_domain(),
  198          "module_paths": module_paths(),
  199          "not_an_approval": True, "HTTP_performed": False, "Native_qualified": False,
  200      }
