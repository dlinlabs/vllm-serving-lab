def write(path, value, secret="", append=False):
    text = json.dumps(value, sort_keys=True, allow_nan=False)
    if secret:
        text = text.replace(secret, "<redacted>")
    with path.open("a" if append else "x") as stream:
        stream.write(text + "\n")
        stream.flush()
        os.fsync(stream.fileno())

