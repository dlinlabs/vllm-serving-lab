  134  def source_binding(root, episode, expected):
  135      protocol_path = root / services.RELATIVE / "nominal_protocol.json"
  136      raw = protocol_path.read_bytes()
  137      protocol_sha = hashlib.sha256(raw).hexdigest()
  138      services.checked(expected["source_pins"].get(str(protocol_path)) == protocol_sha,
  139                       "protocol changed since startup source pins")
  140      caller_path = root / services.RELATIVE / "native_nominal_qualification.py"
  141      adapter_path = root / services.RELATIVE / "nominal_episode.py"
  142      services.checked(Path(__file__).resolve() == caller_path and Path(episode.__file__).resolve() == adapter_path,
  143                       "caller/adapter source-root mismatch")
  144      pins = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in (caller_path, adapter_path)}
  145      services.checked(pins[str(adapter_path)] == ADAPTER_SHA256, "accepted episode adapter changed")
  146      pins[str(protocol_path)] = protocol_sha
  147      return strict_load(raw), {"source_pins": pins, "caller_sha256": pins[str(caller_path)],
  148                               "adapter_sha256": pins[str(adapter_path)], "protocol_sha256": protocol_sha}
  149  
  150  
  151  def recheck(binding):
  152      services.checked(all(hashlib.sha256(Path(path).read_bytes()).hexdigest() == sha
  153                           for path, sha in binding["source_pins"].items()),
  154                       "caller/adapter/protocol changed during collection")
