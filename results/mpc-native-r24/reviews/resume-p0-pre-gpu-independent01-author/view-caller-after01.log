   14  
   15  PROBES = Path("results/mpc-native-r24/reviews/resume-p0-probes02/inputs")
   16  ADAPTER_SHA256 = "935c2679c4b9fffdffb23ce88ca5351f91fa84e25c8c1edccedddaea4e4262a8"
   17  DRAIN_FIELDS = ("current_in_flight", "current_waiting", "current_admitted_cost")
