   19  
   20  def error_record(error):
   21      return {"type": type(error).__name__, "message": str(error),
   22              "traceback": "".join(traceback.format_exception(error))}
   23  
   24  
   25  def strict_copy(value):
   26      return json.loads(json.dumps(value, sort_keys=True, allow_nan=False))
   27  
   28  
   29  def strict_load(raw):
   30      def constant(value):
   31          raise ValueError("nonfinite JSON constant: " + value)
   32  
   33      def pairs(items):
   34          result = {}
   35          for key, value in items:
   36              services.checked(key not in result, "duplicate JSON key: " + key)
   37              result[key] = value
   38          return result
   39  
   40      return strict_copy(json.loads(raw, parse_constant=constant, object_pairs_hook=pairs))
   41  
   42  
   43  def preserving(action, primary, report, stage):
   44      try:
   45          return action()
   46      except BaseException as error:
   47          report["caller_errors"].append({"stage": stage, "error": error_record(error)})
   48          if primary is None:
   49              raise
   50          primary.add_note(stage + ": " + type(error).__name__ + ": " + str(error))
   51  
   52  
   53  def persist_capture(client, path, capture, key):
   54      try:
   55          return client.write_capture(path, capture)
   56      except BaseException as error:
   57          try:
   58              services.write(path.with_suffix(".write-error.json"), {
   59                  "capture_unscorable": True, "type": type(error).__name__, "message": str(error),
   60              }, key)
   61          except BaseException as write_error:
   62              error.add_note("write-error receipt also failed: " + type(write_error).__name__
   63                             + ": " + str(write_error))
   64          raise
   65  
   66  
   67  def remaining(owner, deadline, reserve):
   68      services.checked(owner.deadline == deadline and owner.reserve == reserve,
   69                       "original owner deadline/reserve changed")
   70      owner.check()
   71      value = deadline - reserve - time.monotonic()
   72      services.checked(math.isfinite(value) and value > 0, "original work deadline exhausted")
   73      return value
   74  
   75  
   76  async def observe(client, path, *, owner, deadline, reserve, output, key, report, name):
   77      evidence = {"path": path, "entered_at": time.monotonic(), "status_code": None, "raw": None}
   78      primary = None
   79      try:
   80          timeout = min(2.0, remaining(owner, deadline, reserve))
   81          evidence["timeout_s"] = timeout
   82          async with asyncio.timeout(timeout):
   83              response = await client.get(path, headers={"x-admin-api-key": key}, timeout=timeout)
   84          evidence.update(status_code=response.status_code, raw=response.text)
   85          response.raise_for_status()
   86          value = strict_load(response.content)
   87          evidence["value"] = value
   88          return value
   89      except BaseException as error:
   90          primary = error
   91          evidence["error"] = error_record(error)
   92          raise
   93      finally:
   94          evidence["returned_at"] = time.monotonic()
   95          report.setdefault("caller_observations", []).append(evidence)
   96          preserving(lambda: services.write(output / (name + ".json"), evidence, key),
   97                     primary, report, name + "_persistence")
   98  
   99  
  100  async def drain(client, *, owner, deadline, reserve, output, key, report, phase):
  101      attempt = 0
  102      while True:
  103          attempt += 1
  104          metrics = await observe(
  105              client, "/metrics", owner=owner, deadline=deadline, reserve=reserve,
  106              output=output, key=key, report=report, name=f"{phase}-metrics-{attempt:04d}")
  107          values = [metrics[name] for name in (*DRAIN_FIELDS, "tokenizer_fallback_requests")]
  108          services.checked(all(type(value) in (int, float) and math.isfinite(value) and value >= 0
  109                               for value in values), "invalid drain/fallback metric")
  110          services.checked(metrics["tokenizer_fallback_requests"] == 0, "tokenizer fallback after traffic")
  111          if all(metrics[name] == 0 for name in DRAIN_FIELDS):
  112              report.setdefault("caller_drains", {})[phase] = {
  113                  "drained": True, "observed_at": time.monotonic(), "readings": attempt}
  114              return
  115          await asyncio.sleep(min(0.05, remaining(owner, deadline, reserve)))
  116  
  117  
  118  def capture_of(prepared):
  119      return getattr(getattr(prepared, "recorder", None), "capture", None)
  120  
  121  
  122  def counts(capture, entered):
  123      if not isinstance(capture, dict):
  124          return {"records_allocated": None if entered else 0, "sent": None if entered else 0}
  125      records = capture.get("records")
  126      if records is None:
  127          return {"records_allocated": 0, "sent": 0}
  128      services.checked(isinstance(records, list), "capture records must be a list or null")
  129      known = all(isinstance(row, dict) and "sent_at" in row for row in records)
  130      return {"records_allocated": len(records),
  131              "sent": sum(row["sent_at"] is not None for row in records) if known else None}
