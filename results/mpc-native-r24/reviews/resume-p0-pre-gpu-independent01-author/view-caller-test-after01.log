   31  class CallerFixture:
   32      """Literal capture/episode boundaries; real caller, binding, codec and MockTransport GETs."""
   33  
   34      def __init__(self, case, name):
   35          self.case = case
   36          self.output = ROOT / name
   37          (self.output / "services").mkdir(parents=True)
   38          self.protocol_path = Path(os.environ["NATIVE_SMOKE_PROTOCOL"]).resolve()
   39          self.root = self.protocol_path.parents[3]
   40          self.argv = ["CPU-vllm", "serve", driver.services.MODEL]
   41          (self.output / "services/ownership.json").write_text(json.dumps({
   42              "services": [{"name": "engine", "argv": self.argv}]}))
   43          parameters = ModelParameters()
   44          self.report = {"source": {
   45              "cost_spec": asdict(parameters.cost_spec), "identity": asdict(NominalPlanner(parameters).identity),
   46              "clock_domain": nominal_runtime.clock_domain(),
   47              "source_pins": {str(self.protocol_path): hashlib.sha256(self.protocol_path.read_bytes()).hexdigest()}},
   48              "configuration": {"engine": self.argv}}
   49          self.owner = types.SimpleNamespace(deadline=time.monotonic() + 480, reserve=30, check=self.check)
   50          self.original_deadline = self.owner.deadline
   51          self.clients, self.calls, self.metrics, self.observed_starts = [], [], [], []
   52          self.prepare_error = self.state_error = self.warmup_error = self.episode_error = None
   53          self.fail_writes, self.fail_capture_writes = set(), set()
   54          self.warmup_calls = self.episode_calls = self.checks = 0
   55          self.expire_after_metrics = None
   56          self.bad_result = None
   57          self.record_count = 5
   58          domain = nominal_client.clock_domain()
   59          self.warmup = types.SimpleNamespace(ready=True, capture={
   60              "scope": "CPU-only fixture", "clock_domain": domain, "status": "failed",
   61              "error": nominal_client.NOT_RUN_ERROR, "records": None})
   62          self.prepared = types.SimpleNamespace(
   63              error=None, recorder=types.SimpleNamespace(
   64                  capture={"scope": "CPU-only fixture", "clock_domain": domain, "status": "failed",
   65                           "error": nominal_client.NOT_RUN_ERROR, "records": None},
   66                  trace={"duration_seconds": 5, "requests": [{"trace_id": f"CPU-{i}"} for i in range(5)]}),
   67              scenario_binding={"scope": "CPU-only caller boundary"}, scenario_factory=lambda _: None)
   68  
   69      def check(self):
   70          self.checks += 1
   71          if self.expire_after_metrics is not None and sum(call["path"] == "/metrics" for call in self.calls) >= self.expire_after_metrics:
   72              raise driver.services.ProbeError("CPU original owner work budget exhausted")
   73  
   74      @staticmethod
   75      def zero_metrics():
   76          return dict(current_in_flight=0, current_waiting=0, current_admitted_cost=0,
   77                      tokenizer_fallback_requests=0)
   78  
   79      def handle(self, request):
   80          self.case.assertTrue((self.output / "qualification-source-binding.json").is_file())
   81          self.case.assertTrue(all(value > 0 for value in request.extensions["timeout"].values()))
   82          self.calls.append({"path": request.url.path, "timeout": request.extensions["timeout"]})
   83          if request.url.path == "/metrics":
   84              value = self.metrics.pop(0) if self.metrics else self.zero_metrics()
   85              return httpx.Response(200, json=value)
   86          self.case.assertEqual(request.url.path, "/admin/mpc/state")
   87          if self.state_error is not None:
   88              raise self.state_error
   89          return httpx.Response(200, json={
   90              **{name: self.report["source"][name] for name in ("identity", "clock_domain", "cost_spec")},
   91              "run_id": "CPU-only-qualified-caller-fixture"})
   92  
   93      def client(self, **kwargs):
   94          value = REAL_CLIENT(transport=httpx.MockTransport(self.handle), **kwargs)
   95          self.clients.append(value)
   96          return value
   97  
   98      async def warmup_replay(self, prepared, **kwargs):
   99          self.warmup_calls += 1
  100          self.case.assertTrue((self.output / "qualification-source-binding.json").is_file())
  101          self.case.assertEqual(kwargs["deadline"], self.original_deadline)
  102          self.case.assertEqual(kwargs["cleanup_reserve_s"], 30)
  103          self.case.assertEqual(kwargs["clock_domain"], prepared.capture["clock_domain"])
  104          self.case.assertNotEqual(kwargs["clock_domain"], self.report["source"]["clock_domain"])
  105          prepared.capture.update(
  106              status="collected", error=None,
  107              records=[{"fate": "complete", "stream_done": True, "finish_reason": "stop",
  108                        "sent_at": time.monotonic()} for _ in range(3)],
  109              summary={"prompt_tokens_mismatch": 0})
  110          if self.warmup_error is not None:
  111              prepared.capture["status"] = "interrupted"
  112              raise self.warmup_error
  113          return prepared.capture
  114  
  115      def episode_prepare(self, **kwargs):
  116          self.case.assertEqual(kwargs["trace_path"], self.root / driver.PROBES / "admission-boundary.json")
  117          if self.prepare_error is not None:
  118              raise self.prepare_error
  119          return self.prepared
  120  
  121      async def episode_run(self, prepared, runtime, *, owner, offered_start, enabled):
  122          self.episode_calls += 1
  123          self.case.assertTrue(enabled)
  124          self.case.assertIs(owner, self.owner)
  125          self.case.assertEqual(runtime.start_at, offered_start)
  126          self.case.assertEqual(runtime.permit.expires_at - runtime.permit.not_before, 20)
  127          self.case.assertEqual(runtime.permit.max_commands, 8)
  128          self.case.assertEqual(offered_start, runtime.permit.not_before + 1)
  129          self.case.assertLessEqual(offered_start + 5, min(owner.deadline - owner.reserve, runtime.permit.expires_at))
  130          binding = json.loads((self.output / "runtime-binding.json").read_text())
  131          self.case.assertEqual(binding["description"]["protocol_sha256"], runtime.protocol_sha256)
  132          self.case.assertEqual(binding["caller_sha256"], hashlib.sha256(Path(driver.__file__).read_bytes()).hexdigest())
  133          self.case.assertEqual(binding["adapter_sha256"], driver.ADAPTER_SHA256)
  134          self.observed_starts.append(offered_start)
  135          fates = ("complete", "rejected", "unknown", "complete", "not_launched")
  136          prepared.recorder.capture.update(status="collected", error=None, records=[
  137              {"trace_id": f"CPU-{i}", "fate": fates[i],
  138               "scheduled_at": offered_start + 1.25, "sent_at": offered_start + 1.25 if i < 4 else None}
  139              for i in range(self.record_count)])
  140          if self.episode_error is not None:
  141              prepared.recorder.capture["status"] = "interrupted"
  142              raise self.episode_error
  143          return self.bad_result if self.bad_result is not None else {
  144              "status": "collected", "failures": [], "all_workers_joined": True,
  145              "persistence_errors": [], "missing_record_ids": [], "qualification": None}
  146  
  147      def write(self, path, *args, **kwargs):
  148          if path.name in self.fail_writes:
  149              raise OSError("CPU receipt write failure: " + path.name)
  150          return REAL_WRITE(path, *args, **kwargs)
  151  
  152      def capture_write(self, path, capture):
  153          if path.name in self.fail_capture_writes:
  154              raise OSError("CPU raw capture write failure: " + path.name)
  155          return REAL_CAPTURE_WRITE(path, capture)
  156  
  157      def run(self):
  158          async def invoke():
  159              try:
  160                  await driver.collect(owner=self.owner, root=self.root, output=self.output,
  161                                       key="CPU-key", report=self.report)
  162              except BaseException as error:
  163                  return error
  164              finally:
  165                  self.case.assertTrue(all(client.is_closed for client in self.clients))
  166                  self.case.assertEqual([task for task in asyncio.all_tasks()
  167                                         if task is not asyncio.current_task() and not task.done()], [])
  168              return None
  169  
  170          with ExitStack() as stack:
  171              for target, name, value in (
  172                  (httpx, "AsyncClient", self.client),
  173                  (httpx.AsyncHTTPTransport, "handle_async_request", AsyncMock(side_effect=AssertionError("real HTTP forbidden"))),
  174                  (nominal_client, "prepare_capture", lambda **_: self.warmup),
  175                  (nominal_client, "capture_replay", self.warmup_replay),
  176                  (nominal_client, "write_capture", self.capture_write),
  177                  (nominal_episode, "prepare_episode", self.episode_prepare),
  178                  (nominal_episode, "run_episode", self.episode_run),
  179                  (driver.services, "write", self.write),
  180              ):
  181                  stack.enter_context(patch.object(target, name, new=value))
  182              error = asyncio.run(invoke())
  183          (self.output / "CPU-CALLER-CHECK.json").write_text(json.dumps({
  184              "error": None if error is None else driver.error_record(error),
  185              "calls": self.calls, "checks": self.checks, "warmup_calls": self.warmup_calls,
  186              "episode_calls": self.episode_calls, "clients_closed": [c.is_closed for c in self.clients],
  187              "remaining_tasks": [], "real_HTTP_or_services": False,
  188              "report": self.report,
  189          }, sort_keys=True, allow_nan=False))
  190          return error
