  315          self.assertEqual(fixture.report["warmup_offered_requests"], 3)
  316          self.assertEqual(fixture.report["episode_trace_requests"], 5)
  317          self.assertEqual(fixture.report["offered_requests_from_driver"], 5)
  318          self.assertEqual(fixture.report["episode_sent_requests"], 4)
  319          self.assertEqual(fixture.report["qualification_caller"]["status"], "COLLECTED")
  320          raw = json.loads((fixture.output / "caller-episode-capture.json").read_text())
  321          self.assertEqual(raw, fixture.prepared.recorder.capture)
