  259      def test_prepare_exception_and_none_recorder_keep_not_run_reason(self):
  260          for kind in ("raised", "no-recorder"):
  261              with self.subTest(kind=kind):
  262                  fixture = CallerFixture(self, kind)
  263                  primary = RuntimeError("CPU prepare raised original reason")
  264                  if kind == "raised":
  265                      fixture.prepare_error = primary
  266                  else:
  267                      fixture.prepared.error = {"message": "CPU local preparation refused"}
  268                      fixture.prepared.recorder = None
  269                  error = fixture.run()
  270                  if kind == "raised":
  271                      self.assertIs(error, primary)
  272                  else:
  273                      self.assertIsInstance(error, driver.services.ProbeError)
  274                      self.assertIn("CPU local preparation refused", str(error))
  275                  receipt = json.loads((fixture.output / "episode-not-run.json").read_text())
  276                  self.assertEqual((receipt["records_allocated"], receipt["sent"]), (0, 0))
  277                  self.assertEqual(fixture.report["offered_requests_from_driver"], 0)
  278                  self.assertEqual(fixture.episode_calls, 0)
  279                  absent = json.loads((fixture.output / "episode-not-run-capture.json").read_text())
  280                  self.assertFalse(absent["raw_v2_capture_available"])
