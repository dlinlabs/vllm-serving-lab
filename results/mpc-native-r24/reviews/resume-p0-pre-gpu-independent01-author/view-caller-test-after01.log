  193  class Controls(unittest.TestCase):
  194      def early_exit(self, name, prepared_error=None):
  195          protocol_path = Path(os.environ["NATIVE_SMOKE_PROTOCOL"]).resolve()
  196          root, output = protocol_path.parents[3], ROOT / name
  197          (output / "services").mkdir(parents=True)
  198          argv = ["CPU-vllm", "serve", driver.services.MODEL]
  199          (output / "services/ownership.json").write_text(json.dumps({
  200              "services": [{"name": "engine", "argv": argv}]}))
  201          report = {"source": {
  202              "cost_spec": {}, "identity": {}, "clock_domain": "CPU-source-clock",
  203              "source_pins": {str(protocol_path): hashlib.sha256(protocol_path.read_bytes()).hexdigest()}},
  204              "configuration": {"engine": argv}, "offered_requests_from_driver": None}
  205          warmup = types.SimpleNamespace(ready=True, capture={
  206              "clock_domain": "CPU-recorder-clock", "status": "collected", "error": None,
  207              "records": [{"fate": "complete", "stream_done": True, "finish_reason": "stop",
  208                           "sent_at": time.monotonic()} for _ in range(3)],
  209              "summary": {"prompt_tokens_mismatch": 0}})
  210          prepared = types.SimpleNamespace(
  211              error=prepared_error, recorder=types.SimpleNamespace(
  212                  trace={"duration_seconds": 5, "requests": [{"trace_id": f"CPU-{i}"} for i in range(5)]},
  213                  capture={"clock_domain": "CPU-recorder-clock", "status": "failed",
  214                           "error": "not_run", "records": None}))
  215  
  216          class Client:
  217              async def __aenter__(self):
  218                  return self
  219  
  220              async def __aexit__(self, *_):
  221                  return False
  222  
  223              async def aclose(self):
  224                  pass
  225  
  226              async def get(self, path, **_kwargs):
  227                  if path == "/metrics":
  228                      return httpx.Response(200, request=httpx.Request("GET", "http://CPU/metrics"), json={
  229                          "current_in_flight": 0, "current_waiting": 0,
  230                          "current_admitted_cost": 0, "tokenizer_fallback_requests": 0})
  231                  raise RuntimeError("CPU pre-control GET failure")
  232  
  233          with patch.object(nominal_client, "prepare_capture", return_value=warmup), \
  234                  patch.object(nominal_client, "capture_replay", new=AsyncMock(return_value=warmup.capture)), \
  235                  patch.object(nominal_episode, "prepare_episode", return_value=prepared), \
  236                  patch.object(nominal_episode, "run_episode", new=AsyncMock()) as run_episode, \
  237                  patch.object(httpx, "AsyncClient", new=lambda **_: Client()):
  238              expected = driver.services.ProbeError if prepared_error else RuntimeError
  239              with self.assertRaises(expected):
  240                  asyncio.run(driver.collect(
  241                      owner=types.SimpleNamespace(check=lambda: None, deadline=time.monotonic() + 480, reserve=30),
  242                      root=root, output=output, key="", report=report))
  243              run_episode.assert_not_awaited()
  244          self.assertEqual(report["offered_requests_from_driver"], 0)
  245          receipt = json.loads((output / "episode-not-run.json").read_text())
  246          self.assertEqual(receipt["records_allocated"], 0)
  247          self.assertEqual(receipt["sent"], 0)
  248          self.assertEqual(receipt["prepared_error"], prepared_error)
  249          self.assertTrue((output / "episode-not-run-capture.json").is_file())
  250          return report
