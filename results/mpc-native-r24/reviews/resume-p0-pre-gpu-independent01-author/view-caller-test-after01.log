  325          self.assertEqual(fixture.report["caller_drains"]["final"]["readings"], 2)
  326          self.assertEqual(fixture.report["qualification_caller"]["deadline"], fixture.original_deadline)
  327          self.assertIsNone(fixture.report["qualification_caller"]["full_wall"])
