  414          path = ROOT / "nonfinite-capture.json"
  415          with self.assertRaises(ValueError):
  416              driver.persist_capture(nominal_client, path, {"nonconforming": float("inf")}, "")
  417          receipt = json.loads(path.with_suffix(".write-error.json").read_text())
  418          self.assertTrue(receipt["capture_unscorable"])
