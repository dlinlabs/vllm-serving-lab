  288          self.assertIs(fixture.run(), primary)
  289          self.assertTrue(any("write" in str(row) for row in fixture.report["caller_errors"]))
  290          self.assertIn("write-error receipt also failed", str(fixture.report["caller_errors"]))
  291          self.assertEqual(fixture.report["offered_requests_from_driver"], 0)
  292          self.assertEqual(fixture.report["episode_trace_requests"], 5)
  293          receipt = json.loads((fixture.output / "episode-not-run.json").read_text())
  294          self.assertEqual(receipt["primary_error"]["message"], str(primary))
